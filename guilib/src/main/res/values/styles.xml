<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

  <style name="SimpleTextField">
    <item name="android:textSize">20sp</item>
  </style>

  <style name="SmallTextField">
    <item name="android:textSize">16sp</item>
    <item name="android:ellipsize">end</item>
  </style>

  <!-- A dialog's own title line, for the dialogs that draw one instead of using the frame's. -->
  <style name="DialogTitle">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">20sp</item>
  </style>

  <!-- All-caps, letter-spaced section label used across the redesigned dialogs. -->
  <style name="DialogSectionLabel">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:textSize">12sp</item>
    <item name="android:letterSpacing">0.08</item>
  </style>

  <!-- Quiet accent section label for the main-screen selector card. -->
  <style name="SelectorLabel" parent="DialogSectionLabel">
    <item name="android:textColor">@color/lightblue</item>
  </style>

  <!-- One column of a dialog's statistics row. Equal widths, so the hairlines between them fall
       on an even rhythm however many there are. -->
  <style name="DialogStatTile">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:orientation">vertical</item>
  </style>

  <!-- A statistic stated inside a dialog: the key over the value, both centred in their column. -->
  <style name="DialogStatKey" parent="DialogSectionLabel">
    <item name="android:layout_width">match_parent</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="DialogStatValue">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">19sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <!-- The same value where the row is secondary to the one above it, as the best averages are to
       the session's own figures. -->
  <style name="DialogStatValueMinor" parent="DialogStatValue">
    <item name="android:textSize">17sp</item>
  </style>

  <!-- Small rounded pill carrying one secondary fact about the row it sits under. -->
  <style name="RowChip">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/row_chip</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingRight">8dp</item>
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">2dp</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:letterSpacing">0.02</item>
    <item name="android:singleLine">true</item>
    <item name="android:ellipsize">end</item>
  </style>

  <style name="RowChipAccent" parent="RowChip">
    <item name="android:background">@drawable/row_chip_accent</item>
    <item name="android:textColor">@color/lightblue</item>
  </style>

  <!-- One option of a segmented control (2D/3D, playback speed). Sits inside a container that says
       the options belong together, so it carries no background of its own until chosen. -->
  <style name="ViewSegment">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingLeft">14dp</item>
    <item name="android:paddingRight">14dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:paddingBottom">5dp</item>
    <item name="android:textSize">13sp</item>
    <item name="android:gravity">center</item>
    <item name="android:letterSpacing">0.02</item>
    <item name="android:singleLine">true</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <!-- The same control with four options rather than two: tighter, so the whole of it still fits
       beside the other things on its row. -->
  <style name="ViewSegmentCompact" parent="ViewSegment">
    <item name="android:paddingLeft">9dp</item>
    <item name="android:paddingRight">9dp</item>
    <item name="android:textSize">12sp</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>

  <!-- All / None on the case picker's title line: a segmented control's cell, sized to share a
       title row rather than to own one. The picked fill is set in code, since neither is picked
       while the user is part way through. -->
  <style name="CasesSegment">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingLeft">11dp</item>
    <item name="android:paddingRight">11dp</item>
    <item name="android:paddingTop">4dp</item>
    <item name="android:paddingBottom">4dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">12sp</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <style name="SmallTextFieldPx">
    <item name="android:textSize">21px</item>
    <item name="android:ellipsize">end</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item> <!-- muted stat labels; values override to white -->
  </style>

  <!-- Timer statistics cells. Every cell reads the same way: what it is, the value, and one
       secondary value under it whose meaning is set by the solve type (best, or accuracy). -->
  <style name="StatTileKeyPx">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">16px</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.09</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>
  <!-- The horizontal padding is the gutter FontFitTextView shrinks a long time into: fitted to the
       bare cell width, a 7x7 average (10:10.012) came out wall to wall with its digits on the
       dividers. -->
  <style name="StatTileValuePx">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingLeft">5px</item>
    <item name="android:paddingRight">5px</item>
    <item name="android:textSize">30px</item>
    <item name="android:textStyle">bold</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/white</item>
  </style>
  <style name="StatTileSubPx">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:paddingLeft">5px</item>
    <item name="android:paddingRight">5px</item>
    <item name="android:textSize">15px</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/gray600</item>
  </style>

  <!-- The two values under the tiles: they barely move, so they are stated rather than tracked. -->
  <style name="StatFooterKeyPx">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">14px</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.09</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>
  <style name="StatFooterValuePx">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">24px</item>
    <item name="android:textStyle">bold</item>
    <!-- Centred vertically, not just pushed right: a long time (10:10.10 on a 7x7) shrinks its
         text but keeps the box the full size would need, so without this it sat at the top of a
         cell whose label was centred. -->
    <item name="android:gravity">right|center_vertical</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <!-- History screen hero card. Same rule as the timer's cells, in dp: what it is, then the
       value, with each cell set to whichever statistic the user picked for it. -->
  <style name="HeroStatKey">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">10sp</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.09</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>
  <style name="HeroStatValue">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">19sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:layout_marginTop">1dp</item>
  </style>
  <!-- A third line, for a cell whose value needs saying what it is of. -->
  <style name="HeroStatSub">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">11sp</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:layout_marginTop">1dp</item>
  </style>

  <!-- Day headings in the history list, and the one that names the sort when there are no days. -->
  <style name="HistoryGroupLabel">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.1</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <!-- The window the session strip covers. Read once and known after that, so it is the quietest
       thing on the card rather than a second header. -->
  <style name="SessionWindowPx">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">12px</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/gray600</item>
  </style>

  <style name="SessionHeaderPx">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">16px</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.09</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <!-- Step splits, one row per average window, for solve types timed in steps. -->
  <style name="SplitRow">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingTop">3px</item>
    <item name="android:paddingBottom">3px</item>
  </style>
  <style name="SplitRowKeyPx">
    <item name="android:layout_width">70px</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">18px</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.06</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>
  <!-- A column rather than the rest of the row: the bar beside it must be the same width on every
       row, or the lengths could not be read against each other. -->
  <style name="SplitRowValuePx">
    <item name="android:layout_width">88px</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginLeft">8px</item>
    <item name="android:textSize">20px</item>
    <item name="android:textStyle">bold</item>
    <item name="android:gravity">right</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textColor">@color/white</item>
  </style>
  <style name="SplitLegendCellPx">
    <item name="android:textSize">15px</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:ellipsize">end</item>
    <item name="android:paddingLeft">2px</item>
    <item name="android:paddingRight">2px</item>
  </style>
  <!-- One step's average, in the column the legend cell above it names and in the same colour. -->
  <style name="SplitStepValuePx">
    <item name="android:layout_width">0px</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:textSize">17px</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:paddingLeft">2px</item>
    <item name="android:paddingRight">2px</item>
  </style>

  <!-- New-record overlay (timer screen) -->
  <style name="RecordOverlayHeaderPx">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">22px</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/new_record</item>
    <item name="android:paddingBottom">5px</item>
  </style>
  <style name="RecordOverlayCellPx">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">21px</item>
    <item name="android:paddingTop">1px</item>
    <item name="android:paddingBottom">1px</item>
  </style>
  <style name="RecordOverlayLabelPx" parent="RecordOverlayCellPx">
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:paddingRight">12px</item>
  </style>
  <style name="RecordOverlayMarginPx" parent="RecordOverlayCellPx">
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/new_record</item>
    <item name="android:gravity">right</item>
    <item name="android:paddingRight">12px</item>
  </style>
  <style name="RecordOverlayPrevPx" parent="RecordOverlayCellPx">
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <style name="SolveStepTextFieldPx">
    <item name="android:textSize">24px</item>
    <item name="android:gravity">center</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_width">0px</item>
    <item name="android:layout_marginLeft">2px</item>
    <item name="android:layout_marginRight">2px</item>
    <item name="android:singleLine">true</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <!-- Multi-step timing rows: muted step labels, bold tabular step times. -->
  <style name="SolveStepLabelPx" parent="SolveStepTextFieldPx">
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <style name="SolveStepValuePx" parent="SolveStepTextFieldPx">
    <item name="android:textStyle">bold</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>

  <!-- Smart-cube step bar legend: a coloured step name and its time, one cell per step. -->
  <style name="StepLegendCellPx">
    <item name="android:layout_width">0px</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="StepLegendNamePx">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">19px</item>
    <item name="android:singleLine">true</item>
  </style>

  <style name="StepLegendTimePx" parent="StepLegendNamePx">
    <item name="android:layout_marginLeft">4px</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>

  <style name="TableCell">
    <item name="android:textSize">15sp</item>
    <item name="android:gravity">center</item>
    <item name="android:layout_height">22dp</item>
    <item name="android:layout_width">0dp</item>
    <item name="android:padding">1dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:textColor">@color/white</item>
  </style>

  <style name="TableCellPx" parent="TableCell">
    <item name="android:textSize">21px</item>
    <item name="android:layout_height">33px</item>
    <item name="android:padding">2px</item>
    <item name="android:fontFeatureSettings">tnum</item> <!-- tabular figures so time columns align -->
  </style>

  <style name="GridCell" parent="TableCell">
    <item name="android:layout_width">0dp</item>
    <item name="layout_columnWeight">1</item>
    <item name="android:fontFeatureSettings">tnum</item> <!-- tabular figures for time cells -->
    <!--<item name="gravity">center</item>-->
  </style>

  <style name="GridCellPx" parent="TableCellPx">
    <item name="android:layout_width">0px</item>
    <item name="layout_columnWeight">1</item>
    <item name="android:layout_margin">3px</item> <!-- gap between recent-solve chips -->
    <!--<item name="gravity">center</item>-->
  </style>

  <style name="AverageTableHeaderFieldPx" parent="TableCellPx">
    <item name="android:textColor">@color/lightblue</item>
    <item name="android:background">@color/transparent</item> <!-- softened: cyan text, no bar -->
    <item name="android:textStyle">bold</item>
  </style>

  <style name="AverageTableFirstFieldPx" parent="AverageTableHeaderFieldPx">
    <item name="android:layout_width">40px</item>
  </style>

  <style name="ListView">
    <item name="android:divider">@color/listview_divider</item>
    <item name="android:dividerHeight">2px</item>
  </style>

  <style name="ListViewItem">
    <item name="android:textSize">18sp</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">4dp</item>
    <item name="android:layout_marginBottom">4dp</item>
    <item name="android:singleLine">true</item>
    <item name="android:padding">2dp</item>
  </style>

  <style name="SmallListViewItem">
    <item name="android:textSize">16sp</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:padding">7dp</item>
  </style>

  <style name="SpinnerTextView">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:maxLines">1</item>
    <item name="android:textSize">18sp</item>
    <item name="android:gravity">start</item>
    <item name="android:padding">8dp</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:ellipsize">marquee</item>
  </style>

  <!-- A button is set one step heavier than the body text, as it was when the platform's
       "sans-serif-medium" stood in for it. -->
  <style name="CustomButton">
    <item name="fontFamily">@font/roboto_medium</item>
    <item name="android:fontFamily">@font/roboto_medium</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">14sp</item>
    <item name="android:padding">2dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:singleLine">true</item>
    <item name="android:textAllCaps">false</item>
  </style>

  <style name="BigButton" parent="CustomButton">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">55dp</item>
    <item name="android:textSize">18sp</item>
    <item name="android:background">@drawable/button_ripple</item>
  </style>

  <!-- Primary call-to-action (Start, Export, dialog Close): taller, more rounded,
       bolder than the generic BigButton. -->
  <style name="PrimaryButton" parent="BigButton">
    <!-- Back to the family, so bold below picks the bold face rather than thickening the medium. -->
    <item name="fontFamily">@font/roboto</item>
    <item name="android:fontFamily">@font/roboto</item>
    <item name="android:layout_height">60dp</item>
    <item name="android:textSize">19sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:letterSpacing">0.04</item>
    <item name="android:background">@drawable/primary_button_ripple</item>
  </style>

  <!-- Start. The accent, not the app's tonal button: it is the one thing on the screen you came to
       press, and beside a card of raised panels a tonal one reads as another panel. -->
  <style name="HeroStartButton" parent="PrimaryButton">
    <item name="android:layout_height">54dp</item>
    <item name="android:textColor">@color/on_accent</item>
    <item name="android:background">@drawable/hero_start_button</item>
  </style>

  <!-- Rounded tonal action button used in dialogs (+2 / DNF / Delete). -->
  <style name="DialogActionButton" parent="CustomButton">
    <item name="android:layout_height">44dp</item>
    <item name="android:textSize">15sp</item>
    <item name="android:background">@drawable/dialog_action_button</item>
  </style>

  <style name="CustomSpinner">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <!--<item name="android:background">@color/spinner_background</item>-->
    <item name="android:paddingLeft">2dp</item>
    <item name="android:paddingRight">2dp</item>
    <item name="android:gravity">center</item>
    <item name="android:singleLine">true</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:popupBackground">@drawable/spinner_popup_bg</item>
    <!-- Drop the popup below the field so it doesn't cover the label above it. -->
    <item name="android:dropDownVerticalOffset">10dp</item>
  </style>

  <!-- Solve breakdown table (smart-cube step times): a name column, then three of figures. -->
  <style name="BreakdownCell">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:gravity">right</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingTop">3dp</item>
    <item name="android:paddingBottom">3dp</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>

  <style name="BreakdownHeaderCell" parent="BreakdownCell">
    <item name="android:textSize">11sp</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.07</item>
    <item name="android:paddingBottom">6dp</item>
  </style>

  <style name="BreakdownHeaderName" parent="BreakdownHeaderCell">
    <item name="android:gravity">left</item>
    <item name="android:paddingLeft">0dp</item>
  </style>

  <style name="BreakdownStepName" parent="BreakdownCell">
    <item name="android:gravity">left|center_vertical</item>
    <item name="android:paddingLeft">0dp</item>
    <item name="android:paddingTop">5dp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:drawablePadding">4dp</item>
  </style>

  <!-- Thinking recedes next to turning, as it does in the bar. -->
  <style name="BreakdownRecognitionCell" parent="BreakdownCell">
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <!-- The columns added up, under a rule at the foot of the table: the label echoes the header
       above it so the row reads as the table's own summary rather than as another step. -->
  <style name="BreakdownTotalName" parent="BreakdownHeaderName">
    <item name="android:paddingTop">7dp</item>
  </style>

  <style name="BreakdownTotalCell" parent="BreakdownCell">
    <item name="android:textStyle">bold</item>
    <item name="android:paddingTop">6dp</item>
  </style>

  <style name="BreakdownTotalRecognitionCell" parent="BreakdownTotalCell">
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <style name="BreakdownSubCell" parent="BreakdownCell">
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">@color/secondary_text</item>
  </style>

  <style name="BreakdownSubName" parent="BreakdownSubCell">
    <item name="android:gravity">left</item>
    <item name="android:paddingLeft">12dp</item>
  </style>

  <!-- The solve's totals, beside the switch they describe. A figure rather than a heading, so it
       keeps its case where the section label above it does not. -->
  <style name="BreakdownMeta" parent="DialogSectionLabel">
    <item name="android:textAllCaps">false</item>
    <item name="android:letterSpacing">0</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>

  <!-- The moves a step was spent on, under its row in the breakdown: a transcript to read, so it
       runs the width of the table rather than sharing its columns. -->
  <style name="BreakdownMoves">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">13sp</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:fontFamily">monospace</item>
    <item name="android:lineSpacingExtra">2dp</item>
    <item name="android:paddingTop">1dp</item>
    <item name="android:paddingBottom">7dp</item>
  </style>

  <!-- A part's moves sit under its own row, so they indent with it. -->
  <!-- Inherits the parent's white: grey is reserved for rotations, which are not moves. -->
  <style name="BreakdownSubMoves" parent="BreakdownMoves">
    <item name="android:paddingLeft">12dp</item>
  </style>

  <style name="TableCardView">
    <!--<item name="android:layout_marginTop">2dp</item>-->
    <!--<item name="android:layout_marginBottom">2dp</item>-->
    <item name="android:layout_marginLeft">4dp</item>
    <item name="android:layout_marginRight">4dp</item>
    <item name="cardBackgroundColor">@color/timercardbg</item>
    <item name="cardCornerRadius">8dp</item>
    <item name="cardElevation">2dp</item>
  </style>

  <style name="TableCardViewPx" parent="TableCardView">
    <!--<item name="android:layout_marginTop">2px</item>-->
    <!--<item name="android:layout_marginBottom">2px</item>-->
    <item name="android:layout_marginLeft">@dimen/grid_margin_px</item>
    <item name="android:layout_marginRight">@dimen/grid_margin_px</item>
    <item name="cardCornerRadius">8dp</item>
    <item name="cardElevation">2dp</item>
  </style>

  <style name="ScrambleTextField">
    <item name="android:textSize">12sp</item>
    <item name="android:gravity">center</item>
  </style>

  <style name="ScrambleTextFieldPx" parent="ScrambleTextField">
    <item name="android:textSize">18px</item>
  </style>

  <style name="DividerRow">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">3px</item>
    <item name="android:background">@color/iceblue</item>
  </style>

  <!-- One time in a drill summary's case table, and the heading over it, which is also the control
       that ranks the table by that column. -->
  <style name="DrillCaseValue">
    <item name="android:layout_width">@dimen/drill_case_column</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:gravity">right</item>
    <item name="android:singleLine">true</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">@color/secondary_text</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <!-- So two long figures in neighbouring columns keep a gap between them. -->
    <item name="android:paddingLeft">4dp</item>
  </style>

  <style name="DrillCaseColumn" parent="DrillCaseValue">
    <item name="android:textSize">10sp</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:letterSpacing">0.06</item>
    <item name="android:paddingTop">9dp</item>
    <item name="android:paddingBottom">9dp</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <style name="NumericEditText">
    <item name="android:inputType">number</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">20sp</item>
  </style>

</resources>