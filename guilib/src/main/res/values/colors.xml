<?xml version="1.0" encoding="utf-8"?>
<!--
  Two layers. The palette below is the only place a colour is written as a value; everything under
  it is a role, and a role is an alias. A screen names the role, never the value, so a hue can be
  retuned in one line and nothing goes hunting.
-->
<resources>

  <!-- ============================ Palette ============================ -->

  <color name="lightblue">#FF6CCCEC</color>
  <color name="iceblue">#FF0883AC</color>
  <color name="darkblue">#36454F</color>

  <color name="white">#FFFFFFFF</color>
  <color name="black">#FF000000</color>
  <color name="transparent">#00000000</color>

  <color name="gray200">#FFEEEEEE</color>
  <color name="gray400">#FFBDBDBD</color>
  <color name="gray600">#FF757575</color>
  <color name="gray700">#FF606060</color>
  <color name="gray800">#FF424242</color>
  <color name="gray850">#FF323232</color>
  <color name="gray900">#FF212121</color>

  <color name="red">#FFFF0000</color>
  <color name="darkred">#FF881111</color>
  <color name="green">#FF00CC00</color>
  <!-- Lifted well clear of the cube green, which is too dark to carry small text on the dialog. -->
  <color name="green_soft">#7BD983</color>

  <!-- The two ends of the time ramp, and the ground between them. Held at one brightness, which is
       where red lives: a green or a grey bright enough to match a vivid red does not exist. -->
  <color name="green_mid">#4CAF50</color>
  <color name="red_mid">#EA6E68</color>

  <!-- The lit well a drawing stands on, centre to edge, and the flat near black it runs out to. -->
  <color name="stage_centre">#22272C</color>
  <color name="stage_edge">#0F1215</color>
  <color name="stage_flat">#1A1D21</color>

  <!-- A blue-grey in three steps: the time ramp's ordinary solve, ink deliberately turned down,
       and the same again quieter. -->
  <color name="bluegray400">#909699</color>
  <color name="bluegray500">#79848B</color>
  <color name="bluegray600">#5E686E</color>

  <!-- Washes: the accent and white laid over a dark ground, named by how much of them lands.
       A fill that is "the accent, quietly" belongs here rather than written out again per screen. -->
  <color name="accent_wash_08">#146CCCEC</color>
  <color name="accent_wash_15">#266CCCEC</color>
  <color name="accent_wash_20">#336CCCEC</color>
  <color name="accent_wash_30">#4D6CCCEC</color>
  <color name="accent_wash_35">#596CCCEC</color>
  <color name="white_wash_10">#1AFFFFFF</color>
  <color name="white_wash_12">#1FFFFFFF</color>
  <color name="white_wash_20">#33FFFFFF</color>
  <color name="white_wash_50">#80FFFFFF</color>

  <!-- ============================= Theme ============================= -->

  <color name="color_accent">@color/lightblue</color>
  <color name="color_primary">@color/darkblue</color>
  <!-- The bar and the status bar take the screen's own ground: a top bar in a colour of its own
       reads as a stripe pasted over the app rather than as part of it. -->
  <color name="app_bar">@color/graybg</color>
  <!-- Ink for text sitting on the accent itself, where white would not hold. -->
  <color name="on_accent">#12181C</color>
  <color name="secondary_text">#AAAAAA</color>

  <!-- ======================== Status and marks ======================= -->

  <color name="new_record">#FFEEDD00</color>
  <color name="warning">#FFFFAA00</color>
  <!-- Fast, ordinary and slow. The ramp used to run through white, which put the loudest value in
       the app on the times closest to average and left the best and the worst as the quietest
       marks on the strip. Flat brightness instead, with the distance from average carried by
       colour: an ordinary solve has none and recedes. -->
  <color name="time_good">@color/green_mid</color>
  <color name="time_neutral">@color/bluegray400</color>
  <color name="time_bad">@color/red_mid</color>
  <color name="dnf_time">@color/gray600</color>
  <!-- Destructive action as text: pure red glares against the dark dialogs. -->
  <color name="danger_text">#EF5350</color>
  <!-- A piece a blind algorithm put home, marked in its name. -->
  <color name="piece_home">@color/green_soft</color>
  <!-- And one the last algorithm to touch it left out, which is where the mistake was made. -->
  <color name="piece_wrong">@color/danger_text</color>
  <!-- The fastest and the slowest of the session, said as small text over the bars. The flat green
       and red the times themselves take are too hard at this size, over a lit card. -->
  <color name="session_best">@color/green_soft</color>
  <color name="session_worst">@color/danger_text</color>

  <!-- ============================ Surfaces =========================== -->

  <color name="graybg">@color/gray850</color>
  <color name="pushedbg">#454545</color>
  <!-- The timer's ground while a solve runs. Properly deep, and a touch cool: at one shade under
       the resting #323232 the screen barely read as standing down at all, which is the whole point
       of the state. The room goes dark and the number is the only thing lit in it. -->
  <color name="timer_focus_bg">#0E1013</color>
  <!-- Pressed, over that ground. A smaller step up than the resting one takes, so a press still
       reads while the ring keeps the dark stage it is drawn on. -->
  <color name="timer_focus_pushedbg">#1B1E22</color>
  <color name="spinner_background">#505050</color>
  <color name="timercardbg">#33383B</color>
  <color name="mainscreen_top_card">@color/gray800</color>
  <color name="listview_divider">@color/gray800</color>

  <color name="dialog_surface">#23272B</color>
  <color name="dialog_divider">@color/white_wash_12</color>
  <!-- Recessed well for a 3D cube to sit in: lit in the middle and falling away at the rim, so the
       cube reads as being on something rather than floating on the card. -->
  <color name="cube_stage_lit">#2B3138</color>
  <color name="cube_stage">#111417</color>

  <!-- History screen hero: a card a shade cooler than the ground, with its controls and
       statistics inset a shade darker so they read as recessed into it. -->
  <color name="hero_card">#3E444A</color>
  <color name="hero_inset">#343A3F</color>
  <color name="hero_divider">@color/white_wash_10</color>

  <color name="button_color">#3E5259</color>
  <!-- A button that cannot be pressed: neutral, and a step off the screen's own ground rather than
       equal to it, so the control is visibly there and visibly unavailable. -->
  <color name="button_disabled">@color/gray800</color>
  <color name="button_disabled_ink">@color/gray600</color>

  <!-- ======================== Puzzle identity ======================== -->

  <!-- One hue per puzzle, walked round the wheel at a fixed chroma so twelve of them read as a
       set rather than as a scatter: the cubes climb from cyan into violet as they grow, and the
       rest take the warm half. 3x3 keeps the app's own accent. -->
  <color name="puzzle_2x2">#6ED9C4</color>
  <color name="puzzle_3x3">@color/lightblue</color>
  <color name="puzzle_4x4">#7FB6F2</color>
  <color name="puzzle_5x5">#9C9AF0</color>
  <color name="puzzle_6x6">#C193EC</color>
  <color name="puzzle_7x7">#EC8FDC</color>
  <color name="puzzle_megaminx">#F08FB4</color>
  <color name="puzzle_fto">#F5A18C</color>
  <color name="puzzle_pyraminx">#F0B570</color>
  <color name="puzzle_skewb">#E8CB6A</color>
  <color name="puzzle_square1">#C7DB74</color>
  <color name="puzzle_clock">#8FD98F</color>

  <!-- A solve type has no colour of its own, so it takes one from what kind it is. -->
  <color name="solvetype_plain">@color/lightblue</color>
  <color name="solvetype_blind">#B49BE8</color>
  <color name="solvetype_steps">#7FD98A</color>

  <!-- ========================= Cube and solve ======================== -->

  <!-- The six faces, wherever the app draws a cube flat: the case charts, the face swatches, the
       sticker icons. These are the six the calm filter over the 3D player lands on, so a chart and
       the player next to it are the same cube rather than two. -->
  <color name="cube_white">#E8E6E1</color>
  <color name="cube_yellow">#E3C33C</color>
  <color name="cube_red">#D9483F</color>
  <color name="cube_orange">#DE8A3A</color>
  <color name="cube_green">#4FB35C</color>
  <color name="cube_blue">#3C74D4</color>

  <!-- A last-layer case drawn as a chart: the layer, a sticker not yet facing up, and the arrows
       showing where a piece has to travel. Yellow-on-top, as every case chart is. -->
  <color name="case_layer">@color/cube_yellow</color>
  <color name="case_blank">#4A4F55</color>
  <color name="case_arrow">@color/stage_flat</color>

  <!-- The well the chart stands in, and the edge that is left of it on a case the drill skips. -->
  <color name="case_stage_centre">@color/stage_centre</color>
  <color name="case_stage_edge">@color/stage_edge</color>
  <color name="case_stage_stroke">@color/white_wash_10</color>
  <color name="case_off_edge">@color/white_wash_12</color>

  <!-- A rep's two halves, on the bar under its name and on the mean cell that names them. One hue
       each, so the bar says where the time went without a legend of its own. Cool for the looking
       and warm for the turning, in that order, which is how the history row's step bar already
       reads a solve. -->
  <color name="drill_bar_recognition">@color/lightblue</color>
  <color name="drill_bar_execution">@color/cube_orange</color>

  <!-- The progression graph's three lines: the solves themselves in the app's own accent, then the
       two running averages over them, warming as the window widens. The bar and frequency graphs
       draw a single series, which is the accent again. -->
  <color name="graph_series">@color/lightblue</color>
  <color name="graph_ao5">@color/green_soft</color>
  <color name="graph_ao12">@color/cube_orange</color>
  <!-- The plot itself, recessed into the card it stands on, and the grid ruled over it. -->
  <color name="graph_plot">@color/hero_inset</color>
  <color name="graph_grid">@color/white_wash_12</color>

  <color name="case_name">@color/white</color>
  <color name="case_name_off">@color/bluegray500</color>
  <color name="case_shape">@color/secondary_text</color>
  <color name="case_shape_off">@color/bluegray600</color>

  <!-- An algorithm row, on the same near black the stage runs out to. -->
  <color name="case_alg_row">@color/stage_flat</color>

  <!-- Solve steps, in solve order: cross, F2L, then the warm last-layer pair. Past the fourth there
       is no method step left to name, only a position, and a solve type may define eight: with four
       to go round, step five came back cyan and stopped saying which segment it was. -->
  <color name="step_cross">@color/lightblue</color>
  <color name="step_f2l">@color/cube_green</color>
  <color name="step_oll">@color/cube_yellow</color>
  <color name="step_pll">@color/cube_orange</color>
  <color name="step_5">@color/cube_red</color>
  <color name="step_6">#E88FD0</color>
  <color name="step_7">#9E92F0</color>
  <color name="step_8">@color/cube_blue</color>

  <!-- =========================== Components ========================= -->

  <!-- Small pills carrying a row's secondary facts: a wash of the surface, or of the accent. -->
  <color name="chip_bg">@color/white_wash_12</color>
  <color name="chip_bg_accent">@color/accent_wash_15</color>
  <!-- The chosen option of a segmented control: a chip has to say "this one" across a whole row,
       which the accent wash alone is too quiet to do. -->
  <color name="chip_bg_selected">@color/accent_wash_35</color>

  <!-- Signal-strength bars on a discovered cube -->
  <color name="signal_on">@color/cube_green</color>
  <color name="signal_off">@color/gray700</color>

  <!-- Smart-cube connect sheet status pill: a washed fill with the matching text on top -->
  <color name="pill_scan_bg">@color/accent_wash_15</color>
  <color name="pill_live_bg">#2643A047</color>
  <color name="pill_live_text">@color/green_soft</color>

  <!-- A statistics cell tinted by the record colour it is announcing -->
  <color name="record_tile_bg">#26FFDD00</color>
  <!-- The same tint, flattened: the record bar paints it over its own edge, so it cannot be translucent -->
  <color name="record_bar_bg">#3C3A29</color>

  <!-- A hair off accent_wash_20, and almost certainly meant to be it. Left alone rather than
       nudged, since nothing here is worth a colour moving on its own. -->
  <color name="table_header">#346CCCEC</color>
  <color name="grid_background_1">@color/accent_wash_08</color>
  <color name="grid_background_2">@color/accent_wash_20</color>

</resources>
