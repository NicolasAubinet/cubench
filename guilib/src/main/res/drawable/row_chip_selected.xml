<?xml version="1.0" encoding="utf-8"?>
<!-- The chosen option of a segmented control. Stronger than row_chip_accent, which labels rather
     than selects: this one has to be picked out of a row of its siblings at a glance. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <solid android:color="@color/chip_bg_selected"/>
  <stroke android:width="1dp" android:color="@color/lightblue"/>
  <corners android:radius="20dp"/>
</shape>
