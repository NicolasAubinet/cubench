<?xml version="1.0" encoding="utf-8"?>
<!-- The well a 3D cube or a scramble diagram is drawn in. A radial gradient rather than a flat fill:
     it lights the middle of the stage, so what stands in it reads as standing rather than pasted on.
     Not tappable and not a card — it is a shade under the dialog, not raised above it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <gradient
     android:type="radial"
     android:gradientRadius="65%p"
     android:centerX="0.5"
     android:centerY="0.44"
     android:startColor="@color/cube_stage_lit"
     android:endColor="@color/cube_stage"/>
  <stroke android:width="1dp" android:color="@color/white_wash_10"/>
  <corners android:radius="18dp"/>
</shape>
