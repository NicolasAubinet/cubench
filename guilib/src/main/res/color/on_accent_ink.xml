<?xml version="1.0" encoding="utf-8"?>
<!-- Ink on the accent button. Disabled it is no longer on the accent, so it takes the same
     turned-down grey as every other unavailable button rather than the dark ink. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false" android:color="@color/button_disabled_ink"/>
  <item android:color="@color/on_accent"/>
</selector>
