<?xml version="1.0" encoding="utf-8"?>
<!-- Stepper button in a number dialog. Outlined like the preset chips rather than filled, so the
     value stays the loudest thing in the dialog. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
   android:color="@color/lightblue">
  <item>
    <shape android:shape="oval">
      <solid android:color="@color/chip_bg"/>
      <stroke android:width="1dp" android:color="@color/gray700"/>
    </shape>
  </item>
</ripple>
