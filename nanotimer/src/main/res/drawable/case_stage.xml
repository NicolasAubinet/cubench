<?xml version="1.0" encoding="utf-8"?>
<!-- The well a case chart stands in: the scramble dialog's stage a step darker, because a chart
     stands grey stickers on it where that one stands a lit 3D cube. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <gradient
     android:type="radial"
     android:gradientRadius="65%p"
     android:centerX="0.5"
     android:centerY="0.44"
     android:startColor="@color/case_stage_centre"
     android:endColor="@color/case_stage_edge"/>
  <stroke android:width="1dp" android:color="@color/case_stage_stroke"/>
  <corners android:radius="8dp"/>
</shape>
