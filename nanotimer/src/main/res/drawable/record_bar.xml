<?xml version="1.0" encoding="utf-8"?>
<!-- The new-record bar: a record-coloured edge on a washed strip, rounded away from that edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/new_record"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:left="4dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/record_bar_bg"/>
      <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp"/>
    </shape>
  </item>
</layer-list>
