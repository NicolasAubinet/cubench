<?xml version="1.0" encoding="utf-8"?>
<!-- The well the diagram sits in. A radial gradient rather than a flat fill: it lights the middle
     of the stage, so the cube reads as standing in it rather than pasted on it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <gradient
     android:type="radial"
     android:gradientRadius="65%p"
     android:centerX="0.5"
     android:centerY="0.44"
     android:startColor="#2B3138"
     android:endColor="#111417"/>
  <stroke android:width="1dp" android:color="@color/white_wash_10"/>
  <corners android:radius="18dp"/>
</shape>
