<?xml version="1.0" encoding="utf-8"?>
<!-- A pill carrying a colour that only the call site knows: the solve type on the identity strip,
     the verdict on the solve just finished. The alphas are shares of the tint, which multiplies
     them, so the tint is passed at full alpha or the pill is faded twice over. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/white_wash_20"/>
  <stroke
     android:width="1dp"
     android:color="@color/white_wash_50"/>
  <corners android:radius="999dp"/>
</shape>
