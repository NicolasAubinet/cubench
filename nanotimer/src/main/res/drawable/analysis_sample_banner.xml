<?xml version="1.0" encoding="utf-8"?>
<!-- The badge that does not scroll away. The warning tint rather than the accent: it is a caveat on
     everything under it, not a thing to press. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
   android:shape="rectangle">
  <solid android:color="@color/sample_wash"/>
  <stroke
     android:width="1dp"
     android:color="@color/sample_edge"/>
  <corners android:radius="10dp"/>
</shape>
