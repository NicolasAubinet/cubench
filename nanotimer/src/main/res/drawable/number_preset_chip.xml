<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable preset in a number dialog. Matches the row chips: 20dp corners, accent wash when it
     is the value currently entered. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
   android:color="@color/lightblue">
  <item>
    <selector>
      <item android:state_selected="true">
        <shape android:shape="rectangle">
          <solid android:color="@color/chip_bg_selected"/>
          <stroke android:width="1dp" android:color="@color/lightblue"/>
          <corners android:radius="20dp"/>
        </shape>
      </item>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="@color/chip_bg"/>
          <stroke android:width="1dp" android:color="@color/gray700"/>
          <corners android:radius="20dp"/>
        </shape>
      </item>
    </selector>
  </item>
</ripple>
