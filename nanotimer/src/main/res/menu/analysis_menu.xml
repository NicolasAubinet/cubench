<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   xmlns:tools="http://schemas.android.com/tools">

  <item android:id="@+id/itAnalysisWindow"
     android:title="@string/analysis_window_title"
     app:actionLayout="@layout/analysis_window_chip"
     app:showAsAction="always"/>

  <!-- Nothing on this screen names its own unit, so the vocabulary lives behind the ? rather than
       in captions the reader would carry on every visit. -->
  <item android:id="@+id/itAnalysisHelp"
     android:icon="@drawable/ic_help_outline"
     android:title="@string/analysis_help_title"
     app:showAsAction="always"/>

  <!-- Plan tab only: shown by AnalysisActivity.showPlanMenu. -->
  <item android:id="@+id/itAnalysisPlanFeedback"
     android:title="@string/coach_menu_feedback_show"
     android:visible="false"
     app:showAsAction="never"/>

  <item android:id="@+id/itAnalysisPlanLanguage"
     android:title="@string/coach_menu_plan_language"
     android:visible="false"
     app:showAsAction="never"/>

  <item android:id="@+id/itAnalysisPlanReport"
     android:title="@string/coach_report_title"
     android:visible="false"
     app:showAsAction="never"/>

  <!-- Debug builds and the owner's token builds only, so never translated. -->
  <item android:id="@+id/itAnalysisPlanAskNow"
     android:title="Request new plan"
     android:visible="false"
     app:showAsAction="never"
     tools:ignore="HardcodedText"/>
</menu>
