<?xml version="1.0" encoding="utf-8"?>
<resources>
  <declare-styleable name="FontFitTextView">
    <attr name="myfont">
      <enum name="SCRAMBLE" value="0"/>
    </attr>
  </declare-styleable>
  <declare-styleable name="NumberLimit">
    <attr name="min" format="integer"/>
    <attr name="max" format="integer"/>
    <attr name="defaultVal" format="integer"/>
    <attr name="cyclic" format="boolean"/>
    <attr name="step" format="integer"/>
    <!-- Values worth one tap, shown as chips above the stepper. -->
    <attr name="presets" format="reference"/>
    <attr name="unit" format="reference|string"/>
  </declare-styleable>
</resources>