<?xml version="1.0" encoding="utf-8"?>

<!-- One average window: what it is called, each step's average in its own colour under the legend
     cell that names it, and what they add up to. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   style="@style/SplitRow">

  <TextView
     android:id="@+id/tvSplitKey"
     style="@style/SplitRowKeyPx"/>

  <!-- One cell per step, filled by StepSplitsView: how many there are is the solve type's
       business, the same as the legend above. -->
  <LinearLayout
     android:id="@+id/splitValues"
     android:layout_width="0px"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:orientation="horizontal"/>

  <com.cube.nanotimer.util.view.FontFitTextView
     android:id="@+id/tvSplitTotal"
     style="@style/SplitRowValuePx"/>

</LinearLayout>
