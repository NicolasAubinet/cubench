<?xml version="1.0" encoding="utf-8"?>
<!-- The Plan tab's Today card, between the plan's own card and its focuses: today's solves, and how
     each focus has moved since the plan. Worked out on the phone, refreshed whenever the tab shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/llCoachToday"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="@dimen/space_m"
   android:background="@drawable/coach_plan_hero"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="14dp"
   android:paddingBottom="14dp"
   android:visibility="gone">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:gravity="center_vertical"
     android:orientation="horizontal">

    <ImageView
       android:layout_width="34dp"
       android:layout_height="34dp"
       android:background="@drawable/coach_hero_icon_tile"
       android:importantForAccessibility="no"
       android:padding="8dp"
       android:src="@drawable/ic_trend_up"/>

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginLeft="10dp"
       android:layout_marginStart="10dp"
       android:fontFamily="@font/roboto"
       android:text="@string/coach_day_title"
       android:textColor="@color/white"
       android:textSize="17sp"
       android:textStyle="bold"/>

    <TextView
       android:id="@+id/tvCoachTodayDate"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginLeft="8dp"
       android:layout_marginStart="8dp"
       android:layout_weight="1"
       android:textColor="@color/secondary_text"
       android:textSize="12.5sp"/>
  </LinearLayout>

  <!-- Today's figures, each a number over what it is. Best Ao5 only once there is one. -->
  <LinearLayout
     android:id="@+id/llCoachTodayFigures"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="12dp"
     android:background="@drawable/coach_figure_tile"
     android:orientation="horizontal"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingTop="10dp"
     android:paddingBottom="10dp"/>

  <TextView
     android:id="@+id/tvCoachTodayNone"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="12dp"
     android:lineSpacingMultiplier="1.15"
     android:textColor="@color/secondary_text"
     android:textSize="13sp"
     android:visibility="gone"/>

  <!-- Today's drills and their reps, any drill; a blank bar while the day is read. -->
  <FrameLayout
     android:id="@+id/flCoachTodayDrills"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="10dp"
     android:minHeight="20dp">

    <TextView
       android:id="@+id/tvCoachTodayDrills"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:textColor="@color/white"
       android:textSize="14sp"/>

    <View
       android:id="@+id/vCoachTodayDrillsSkeleton"
       android:layout_width="150dp"
       android:layout_height="12dp"
       android:layout_gravity="center_vertical"
       android:background="@drawable/coach_skeleton"
       android:visibility="gone"/>
  </FrameLayout>

  <!-- Since the plan: one row per focus, the figure it leads with then and now. -->
  <LinearLayout
     android:id="@+id/llCoachTodaySince"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical">

    <View
       android:layout_width="match_parent"
       android:layout_height="1dp"
       android:layout_marginTop="14dp"
       android:background="@color/hero_divider"/>

    <!-- Headed like Today, so its figures are not read as today's. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <ImageView
         android:layout_width="34dp"
         android:layout_height="34dp"
         android:background="@drawable/coach_hero_icon_tile"
         android:importantForAccessibility="no"
         android:padding="8dp"
         android:src="@drawable/ic_coach_point_plan"/>

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginLeft="10dp"
         android:layout_marginStart="10dp"
         android:fontFamily="@font/roboto"
         android:text="@string/coach_day_since"
         android:textColor="@color/white"
         android:textSize="17sp"
         android:textStyle="bold"/>

      <TextView
         android:id="@+id/tvCoachTodaySinceSolves"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_marginLeft="8dp"
         android:layout_marginStart="8dp"
         android:layout_weight="1"
         android:textColor="@color/secondary_text"
         android:textSize="12.5sp"/>
    </LinearLayout>

    <LinearLayout
       android:id="@+id/llCoachTodayRows"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"/>
  </LinearLayout>
</LinearLayout>
