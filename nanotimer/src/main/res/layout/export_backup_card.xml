<?xml version="1.0" encoding="utf-8"?>
<!-- The other thing this screen can produce, and the one that carries drills and settings. It has
     no actions of its own: the bar at the bottom belongs to whichever half the segmented control
     is showing, so there is only ever one Save and one Share on screen. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   app:cardBackgroundColor="@color/hero_card"
   app:cardElevation="@dimen/mainscreen_card_elevation"
   app:cardCornerRadius="@dimen/card_corner">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:padding="@dimen/space_s">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       android:gravity="center_vertical"
       android:paddingLeft="@dimen/space_s"
       android:paddingRight="@dimen/space_s"
       android:paddingTop="@dimen/space_xs">

      <FrameLayout
         android:layout_width="32dp"
         android:layout_height="32dp"
         android:background="@drawable/hero_glyph">
        <ImageView
           android:layout_width="19dp"
           android:layout_height="19dp"
           android:layout_gravity="center"
           android:src="@drawable/ic_backup_archive"
           android:contentDescription="@null"/>
      </FrameLayout>

      <LinearLayout
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:layout_marginLeft="@dimen/space_m"
         android:layout_marginStart="@dimen/space_m"
         android:orientation="vertical">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/backup_everything"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/white"
           android:singleLine="true"
           android:ellipsize="end"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="1dp"
           android:text="@string/backup_everything_caption"
           android:textSize="13sp"
           android:textColor="@color/secondary_text"/>
      </LinearLayout>
    </LinearLayout>

    <!-- What the file will hold, so the card is not a promise the screen never checks. -->
    <TextView
       android:id="@+id/tvBackupContents"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/space_xs"
       android:paddingLeft="@dimen/space_s"
       android:paddingRight="@dimen/space_s"
       android:paddingBottom="@dimen/space_xs"
       android:textSize="13sp"
       android:textColor="@color/secondary_text"
       android:fontFeatureSettings="tnum"/>

  </LinearLayout>

</androidx.cardview.widget.CardView>
