<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped so the pair measures to its content and stays centred, and a cell too narrow for both
     takes it off the name, which carries the weight. Unwrapped, the time is what gets cut. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="0px"
   android:layout_weight="1"
   style="@style/StepLegendCellPx">
  <LinearLayout
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:orientation="horizontal">
    <TextView android:id="@+id/tvStepName"
       style="@style/StepLegendNamePx"
       android:layout_weight="1"
       android:ellipsize="end"/>
    <TextView android:id="@+id/tvStepTime" style="@style/StepLegendTimePx"/>
  </LinearLayout>
</LinearLayout>
