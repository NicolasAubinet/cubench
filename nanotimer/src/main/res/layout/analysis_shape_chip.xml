<?xml version="1.0" encoding="utf-8"?>
<!-- The shape picker on the Cases step row, right of the rule. A chip rather than a segment: the
     segments are the step, of which one is always on, and this is a scope set on that step which
     can be off. It is the window chip's control a row down, which is why it opens a list. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="wrap_content"
   android:layout_height="wrap_content"
   android:layout_marginRight="@dimen/space_s"
   android:background="@drawable/number_preset_chip"
   android:gravity="center"
   android:paddingLeft="14dp"
   android:paddingRight="14dp"
   android:paddingTop="6dp"
   android:paddingBottom="6dp"
   android:singleLine="true"
   android:textColor="@color/number_preset_chip_text"
   android:textSize="13sp"/>
