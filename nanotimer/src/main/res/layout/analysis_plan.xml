<?xml version="1.0" encoding="utf-8"?>
<!-- The plan tab: where the coach stands for this install, then the last plan written for this
     solve type, or what a plan is where none has been.

     The explainer never mocks a plan up: a plan the app did not write, rendered beside figures it
     did, is the one arrangement that can make a true number look invented. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:tools="http://schemas.android.com/tools"
   android:id="@+id/llAnalysisPlan"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical">

  <!-- Where the coach stands, above everything else: when the next plan comes (docked into the
       plan's card while there is one), where the plans go, or that the access has ended. Gone for an install that never had the coach, which reads
       the offer in the card further down. -->
  <LinearLayout
     android:id="@+id/llCoachPlanStatus"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginBottom="@dimen/space_m"
     android:background="@drawable/analysis_card"
     android:orientation="vertical"
     android:paddingLeft="16dp"
     android:paddingRight="16dp"
     android:paddingTop="12dp"
     android:paddingBottom="14dp"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <!-- Only while something is under way: a plan being written, or a session being waited out. -->
      <ProgressBar
         android:id="@+id/pbCoachPlanStatus"
         style="?android:attr/progressBarStyleSmall"
         android:layout_width="14dp"
         android:layout_height="14dp"
         android:layout_marginEnd="8dp"
         android:layout_marginRight="8dp"
         android:visibility="gone"/>

      <!-- "Next plan", for the strip a solver with the coach reads. -->
      <TextView
         android:id="@+id/tvCoachPlanStatusLabel"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginEnd="12dp"
         android:layout_marginRight="12dp"
         android:fontFamily="@font/roboto_medium"
         android:letterSpacing="0.08"
         android:textAllCaps="true"
         android:textColor="@color/secondary_text"
         android:textSize="11.5sp"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvCoachPlanStatus"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"/>
    </LinearLayout>

    <!-- How many of the solves the next plan needs are done. -->
    <ProgressBar
       android:id="@+id/pbCoachPlanMeter"
       style="?android:attr/progressBarStyleHorizontal"
       android:layout_width="match_parent"
       android:layout_height="6dp"
       android:layout_marginTop="8dp"
       android:progressDrawable="@drawable/drill_progress"
       android:visibility="gone"/>

    <!-- Only docked in a plan's card: what the next plan will answer. -->
    <TextView
       android:id="@+id/tvCoachPlanStatusLoop"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="8dp"
       android:text="@string/coach_plan_loop"
       android:textColor="@color/secondary_text"
       android:textSize="12.5sp"
       android:visibility="gone"/>

    <TextView
       android:id="@+id/tvCoachPlanStatusBody"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="6dp"
       android:lineSpacingMultiplier="1.2"
       android:textColor="@color/secondary_text"
       android:textSize="13.5sp"
       android:visibility="gone"/>

    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/buCoachPlanStatus"
       style="@style/DialogActionButton"
       android:layout_marginTop="14dp"
       android:visibility="gone"/>
  </LinearLayout>

  <!-- A written plan's card: the coach's headline with what went well split off it, a chip per
       focus, and the countdown to the next plan once the status card is docked into it. -->
  <LinearLayout
     android:id="@+id/llAnalysisPlanWritten"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:background="@drawable/coach_plan_hero"
     android:orientation="vertical"
     android:paddingLeft="16dp"
     android:paddingRight="16dp"
     android:paddingTop="16dp"
     android:paddingBottom="14dp"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <ImageView
         android:layout_width="44dp"
         android:layout_height="44dp"
         android:background="@drawable/coach_hero_icon_tile"
         android:importantForAccessibility="no"
         android:padding="10dp"
         android:src="@drawable/ic_coach_target"/>

      <LinearLayout
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_marginLeft="12dp"
         android:layout_marginStart="12dp"
         android:layout_weight="1"
         android:orientation="vertical">

        <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:fontFamily="@font/roboto"
           android:text="@string/coach_plan_title"
           android:textColor="@color/white"
           android:textSize="20sp"
           android:textStyle="bold"/>

        <TextView
           android:id="@+id/tvAnalysisPlanDate"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:textColor="@color/secondary_text"
           android:textSize="12.5sp"/>
      </LinearLayout>
    </LinearLayout>

    <TextView
       android:id="@+id/tvAnalysisPlanWin"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:background="@drawable/coach_win_line"
       android:drawableLeft="@drawable/ic_trend_up"
       android:drawableStart="@drawable/ic_trend_up"
       android:drawablePadding="10dp"
       android:fontFamily="@font/roboto_medium"
       android:lineSpacingMultiplier="1.15"
       android:paddingLeft="12dp"
       android:paddingRight="12dp"
       android:paddingTop="10dp"
       android:paddingBottom="10dp"
       android:textColor="@color/green_soft"
       android:textSize="14sp"
       android:visibility="gone"/>

    <TextView
       android:id="@+id/tvAnalysisPlanHeadline"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:fontFamily="@font/roboto_medium"
       android:lineSpacingMultiplier="1.15"
       android:textColor="@color/white"
       android:textSize="19sp"/>

    <!-- One coach_hero_chip per focus, scrolling sideways when they do not fit. -->
    <HorizontalScrollView
       android:id="@+id/hsAnalysisPlanChips"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:overScrollMode="never"
       android:scrollbars="none">

      <LinearLayout
         android:id="@+id/llAnalysisPlanChips"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- Where the status card moves while it counts down to the next plan. -->
    <LinearLayout
       android:id="@+id/llAnalysisPlanDock"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:orientation="vertical"
       android:visibility="gone">

      <View
         android:layout_width="match_parent"
         android:layout_height="1dp"
         android:background="@color/hero_divider"/>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
     android:id="@+id/llAnalysisPlanAreas"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:visibility="gone"/>

  <TextView
     android:id="@+id/tvAnalysisPlanUncited"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="@dimen/space_m"
     android:gravity="center"
     android:textColor="@color/secondary_text"
     android:textSize="12.5sp"
     android:visibility="gone"/>

  <LinearLayout
     android:id="@+id/llAnalysisPlanAbout"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@drawable/coach_offer_card"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingTop="18dp"
       android:paddingBottom="16dp">

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:fontFamily="@font/roboto"
         android:text="@string/analysis_plan_headline"
         android:textColor="@color/white"
         android:textSize="19sp"
         android:textStyle="bold"/>

      <!-- For an install that has the coach and waits for a first plan. -->
      <TextView
         android:id="@+id/tvAnalysisPlanBody"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:lineSpacingMultiplier="1.2"
         android:text="@string/analysis_plan_body"
         android:textColor="@color/secondary_text"
         android:textSize="13.5sp"/>

      <!-- What the coach gives, for an install that could still buy it. Takes the body's place. -->
      <LinearLayout
         android:id="@+id/llAnalysisPlanPoints"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:orientation="vertical"
         android:visibility="gone">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:drawablePadding="12dp"
           android:gravity="center_vertical"
           android:lineSpacingMultiplier="1.15"
           android:textColor="@color/white"
           android:alpha="0.9"
           android:textSize="14sp"
           android:drawableLeft="@drawable/ic_coach_point_plan"
           android:drawableStart="@drawable/ic_coach_point_plan"
           android:text="@string/analysis_plan_point_plans"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:drawablePadding="12dp"
           android:gravity="center_vertical"
           android:lineSpacingMultiplier="1.15"
           android:textColor="@color/white"
           android:alpha="0.9"
           android:textSize="14sp"
           android:layout_marginTop="10dp"
           android:drawableLeft="@drawable/ic_coach_point_practice"
           android:drawableStart="@drawable/ic_coach_point_practice"
           android:text="@string/analysis_plan_point_practice"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:drawablePadding="12dp"
           android:gravity="center_vertical"
           android:lineSpacingMultiplier="1.15"
           android:textColor="@color/white"
           android:alpha="0.9"
           android:textSize="14sp"
           android:layout_marginTop="10dp"
           android:drawableLeft="@drawable/ic_coach_point_learn"
           android:drawableStart="@drawable/ic_coach_point_learn"
           android:text="@string/analysis_plan_point_learn"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:drawablePadding="12dp"
           android:gravity="center_vertical"
           android:lineSpacingMultiplier="1.15"
           android:textColor="@color/white"
           android:alpha="0.9"
           android:textSize="14sp"
           android:layout_marginTop="10dp"
           android:drawableLeft="@drawable/ic_coach_point_support"
           android:drawableStart="@drawable/ic_coach_point_support"
           android:text="@string/analysis_plan_point_support"/>
      </LinearLayout>

      <TextView
         android:id="@+id/tvAnalysisPlanCites"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="14dp"
         android:lineSpacingMultiplier="1.2"
         android:text="@string/analysis_plan_cites"
         android:textColor="@color/secondary_text"
         android:textSize="12.5sp"/>

      <!-- For an install that never had the coach: how far it is from being offered it, then the
           offer. Either takes the place of the line above. -->
      <LinearLayout
         android:id="@+id/llCoachGate"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="16dp"
         android:orientation="vertical"
         android:visibility="gone">

        <View
           android:layout_width="match_parent"
           android:layout_height="1dp"
           android:background="@color/hero_divider"/>

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="14dp"
           android:orientation="horizontal">

          <TextView
             android:id="@+id/tvCoachGateTitle"
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_weight="1"
             android:fontFamily="@font/roboto_medium"
             android:textColor="@color/white"
             android:textSize="13.5sp"/>

          <TextView
             android:id="@+id/tvCoachGateCount"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginStart="10dp"
             android:layout_marginLeft="10dp"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"/>
        </LinearLayout>

        <ProgressBar
           android:id="@+id/pbCoachGate"
           style="?android:attr/progressBarStyleHorizontal"
           android:layout_width="match_parent"
           android:layout_height="6dp"
           android:layout_marginTop="8dp"
           android:progressDrawable="@drawable/drill_progress"/>

        <TextView
           android:id="@+id/tvCoachGateNote"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="8dp"
           android:lineSpacingMultiplier="1.2"
           android:textColor="@color/secondary_text"
           android:textSize="12sp"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/llCoachOffer"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
           android:id="@+id/buCoachOffer"
           style="@style/AccentActionButton"
           android:layout_marginTop="14dp"/>

        <!-- What it costs after the free weeks, once Play has said. -->
        <TextView
           android:id="@+id/tvCoachOfferNote"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="8dp"
           android:gravity="center"
           android:lineSpacingMultiplier="1.2"
           android:textColor="@color/secondary_text"
           android:textSize="12sp"
           android:visibility="gone"/>
      </LinearLayout>

      <!-- Shown with the points: the coach is the only thing that sends anything. -->
      <TextView
         android:id="@+id/tvAnalysisPlanPrivate"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center_horizontal"
         android:layout_marginTop="14dp"
         android:drawablePadding="6dp"
         android:drawableLeft="@drawable/ic_coach_private"
         android:drawableStart="@drawable/ic_coach_private"
         android:gravity="center_vertical"
         android:text="@string/analysis_plan_private"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"
         android:visibility="gone"/>
    </LinearLayout>

    <!-- For an install without the coach: the plan it would get, with nothing of it filled in. -->
    <include
       android:id="@+id/llAnalysisPlanPreview"
       layout="@layout/coach_plan_silhouette"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="20dp"
       android:visibility="gone"/>

    <!-- The honest line: the other two tabs are not the bait. -->
    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="16dp"
       android:gravity="center"
       android:lineSpacingMultiplier="1.2"
       android:paddingLeft="12dp"
       android:paddingRight="12dp"
       android:text="@string/analysis_plan_not_yet"
       android:textColor="@color/secondary_text"
       android:textSize="12.5sp"/>
  </LinearLayout>

  <!-- Debug builds only: runs the weekly job now for this solve type, and says how it ended.
       What Play last answered also shows in a release built with coach.purchase.debug. -->
  <LinearLayout
     android:id="@+id/llAnalysisPlanDebug"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="16dp"
     android:orientation="vertical"
     android:visibility="gone">

    <TextView
       android:id="@+id/tvAnalysisPlanDebugStatus"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginBottom="8dp"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="12.5sp"
       android:visibility="gone"/>

    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/buAnalysisPlanAskNow"
       style="@style/DialogActionButton"
       android:text="Ask now (debug)"
       tools:ignore="HardcodedText"/>

    <LinearLayout
       android:id="@+id/llAnalysisPlanPurchaseDebug"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:visibility="gone">

      <TextView
         android:id="@+id/tvAnalysisPlanPurchaseStatus"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:layout_marginBottom="8dp"
         android:gravity="center"
         android:textColor="@color/secondary_text"
         android:textSize="12.5sp"/>

      <androidx.appcompat.widget.AppCompatButton
         android:id="@+id/buAnalysisPlanCopyPurchase"
         style="@style/DialogActionButton"
         android:background="@drawable/dialog_action_button_ghost"
         android:text="Copy purchase token (debug)"
         tools:ignore="HardcodedText"/>
    </LinearLayout>
  </LinearLayout>

  <!-- Standing practice, under whatever the plan says and apart from it: each family's costliest
       cases, refreshed from the service whenever the tab opens. An install without the coach reads
       blank sets in their place. Gone in a build with no coach. -->
  <LinearLayout
     android:id="@+id/llAnalysisPractice"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="28dp"
     android:orientation="vertical"
     android:visibility="gone">

    <View
       android:layout_width="match_parent"
       android:layout_height="1dp"
       android:background="@color/hero_divider"/>

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="16dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:fontFamily="@font/roboto_medium"
         android:letterSpacing="0.08"
         android:text="@string/coach_practice_title"
         android:textAllCaps="true"
         android:textColor="@color/secondary_text"
         android:textSize="12.5sp"/>

      <!-- Only over the teaser, for an install without the coach. -->
      <TextView
         android:id="@+id/tvAnalysisPracticeLocked"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:background="@drawable/coach_practice_locked_chip"
         android:drawableLeft="@drawable/ic_coach_lock"
         android:drawableStart="@drawable/ic_coach_lock"
         android:drawablePadding="5dp"
         android:gravity="center_vertical"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="4dp"
         android:paddingBottom="4dp"
         android:text="@string/coach_practice_locked"
         android:textColor="@color/white"
         android:textSize="12.5sp"
         android:visibility="gone"/>
    </LinearLayout>

    <TextView
       android:id="@+id/tvAnalysisPracticeBody"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:lineSpacingMultiplier="1.2"
       android:text="@string/coach_practice_body"
       android:textColor="@color/secondary_text"
       android:textSize="13.5sp"/>

    <LinearLayout
       android:id="@+id/llAnalysisPracticeSets"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"/>
  </LinearLayout>

</LinearLayout>
