<?xml version="1.0" encoding="utf-8"?>
<!-- The case picker: a chart of every case in the family, tapped on or off. The dialog draws its
     own title so All and None can share that line as one segmented control, which gives the grid
     back most of a row; the count and the hint follow on one line under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical"
   android:paddingLeft="12dp"
   android:paddingRight="12dp"
   android:paddingTop="14dp">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:gravity="center_vertical"
     android:orientation="horizontal">

    <TextView
       android:id="@+id/tvCasesTitle"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/white"
       android:textSize="17sp"
       app:fontFamily="@font/roboto_medium"/>

    <!-- The way into the named picks. -->
    <ImageButton
       android:id="@+id/buCasePresets"
       android:layout_width="34dp"
       android:layout_height="34dp"
       android:layout_marginRight="2dp"
       android:background="?android:attr/selectableItemBackgroundBorderless"
       android:contentDescription="@string/drill_presets"
       android:padding="6dp"
       android:scaleType="fitCenter"
       android:src="@drawable/ic_preset"/>

    <!-- Two shortcuts as one container, which is also a reading of where the pick stands: All is
         filled when every case is on, None when none is, neither in between. -->
    <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:background="@drawable/view_segment_group"
       android:orientation="horizontal"
       android:padding="3dp">

      <TextView
         android:id="@+id/tvCasesAll"
         style="@style/CasesSegment"
         android:text="@string/drill_cases_all"/>

      <TextView
         android:id="@+id/tvCasesNone"
         style="@style/CasesSegment"
         android:text="@string/drill_cases_none"/>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="7dp"
     android:layout_marginBottom="9dp"
     android:baselineAligned="true"
     android:orientation="horizontal">

    <TextView
       android:id="@+id/tvCasesCount"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <TextView
       android:id="@+id/tvCasesHint"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:ellipsize="end"
       android:gravity="right"
       android:maxLines="1"
       android:paddingLeft="8dp"
       android:text="@string/drill_cases_hint"
       android:textColor="@color/secondary_text"
       android:textSize="11sp"/>
  </LinearLayout>

  <GridView
     android:id="@+id/gvCases"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:columnWidth="72dp"
     android:horizontalSpacing="@dimen/case_grid_spacing"
     android:numColumns="auto_fit"
     android:scrollbarStyle="outsideOverlay"
     android:stretchMode="columnWidth"
     android:verticalSpacing="@dimen/case_grid_spacing"/>

</LinearLayout>
