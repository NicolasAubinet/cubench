<?xml version="1.0" encoding="utf-8"?>
<!-- One shape in the picker: a case of the group as its picture, its name, how many are known.
     As tall as its row, so a name on two lines leaves the ring the same height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="0dp"
   android:layout_height="match_parent"
   android:layout_margin="3dp"
   android:layout_weight="1"
   android:background="@drawable/shape_tile"
   android:gravity="center_horizontal"
   android:orientation="vertical"
   android:paddingStart="6dp"
   android:paddingTop="8dp"
   android:paddingEnd="6dp"
   android:paddingBottom="8dp">

  <com.cube.nanotimer.gui.widget.LastLayerCaseView
     android:id="@+id/vShapeChart"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"/>

  <TextView
     android:id="@+id/tvShapeName"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="6dp"
     android:ellipsize="end"
     android:fontFamily="@font/roboto_medium"
     android:gravity="center_horizontal"
     android:maxLines="2"
     android:textColor="@color/case_name"
     android:textSize="13sp"
     app:fontFamily="@font/roboto_medium"/>

  <TextView
     android:id="@+id/tvShapeCount"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:gravity="center_horizontal"
     android:maxLines="2"
     android:textColor="@color/case_shape"
     android:textSize="11sp"/>

</LinearLayout>
