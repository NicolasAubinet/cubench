<?xml version="1.0" encoding="utf-8"?>
<!-- One discovered cube. The model is what the user recognises; the advertised name is what tells two
     of the same model apart, so it sits under it rather than in brackets after it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="horizontal"
   android:gravity="center_vertical"
   android:background="@drawable/smart_cube_row"
   android:clickable="true"
   android:focusable="true"
   android:padding="11dp">

  <ImageView
     android:layout_width="22dp"
     android:layout_height="22dp"
     android:layout_marginEnd="11dp"
     android:layout_marginRight="11dp"
     android:src="@drawable/ic_smart_cube"
     android:tint="@color/lightblue"
     android:contentDescription="@null"/>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:orientation="vertical">
    <TextView
       android:id="@+id/tvCubeModel"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:singleLine="true"
       android:ellipsize="end"
       android:textColor="@color/white"
       android:textStyle="bold"
       android:textSize="15sp"/>
    <TextView
       android:id="@+id/tvCubeName"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:singleLine="true"
       android:ellipsize="end"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>
  </LinearLayout>

  <!-- Signal strength, so two cubes on the same table can be told apart by which one is in reach. -->
  <LinearLayout
     android:id="@+id/cubeSignal"
     android:layout_width="wrap_content"
     android:layout_height="16dp"
     android:layout_marginStart="8dp"
     android:layout_marginLeft="8dp"
     android:orientation="horizontal"
     android:gravity="bottom">
    <View android:id="@+id/cubeSignal1" android:layout_width="3dp" android:layout_height="5dp"/>
    <View android:id="@+id/cubeSignal2" android:layout_width="3dp" android:layout_height="9dp"
       android:layout_marginStart="2dp" android:layout_marginLeft="2dp"/>
    <View android:id="@+id/cubeSignal3" android:layout_width="3dp" android:layout_height="13dp"
       android:layout_marginStart="2dp" android:layout_marginLeft="2dp"/>
    <View android:id="@+id/cubeSignal4" android:layout_width="3dp" android:layout_height="16dp"
       android:layout_marginStart="2dp" android:layout_marginLeft="2dp"/>
  </LinearLayout>

  <ImageView
     android:id="@+id/imgCubeChevron"
     android:layout_width="18dp"
     android:layout_height="18dp"
     android:layout_marginStart="8dp"
     android:layout_marginLeft="8dp"
     android:rotation="270"
     android:src="@drawable/ic_chevron_down"
     android:tint="@color/gray600"
     android:contentDescription="@null"/>
</LinearLayout>
