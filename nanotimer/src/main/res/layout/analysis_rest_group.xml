<?xml version="1.0" encoding="utf-8"?>
<!-- One run of the rest of the set, under where those cases stand. The heading carries what would
     otherwise be repeated on every picture under it, which is the same reason the known-algorithms
     screen groups rather than labels each row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical">

  <!-- No way to drill the group from here. Drilling by what you have not learnt is the composition
       the paid plan sells, unlike the table's own button, which is composed from a measured cost. -->
  <TextView
     android:id="@+id/tvAnalysisRestGroup"
     style="@style/DialogSectionLabel"
     android:layout_width="match_parent"
     android:layout_marginTop="16dp"
     android:layout_marginBottom="7dp"
     android:paddingLeft="@dimen/space_xs"/>

  <com.cube.nanotimer.util.view.FlowLayout
     android:id="@+id/flAnalysisRestCases"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:paddingLeft="@dimen/space_xs"/>

</LinearLayout>
