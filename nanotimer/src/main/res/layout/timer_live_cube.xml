<?xml version="1.0" encoding="utf-8"?>

<!-- The connected cube, mirrored. Inflated from a stub only when one is connected, and given the
     stub's own layout params, so the timer screen is untouched for everyone else. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/liveCubeLayout"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:visibility="gone">

  <WebView
     android:id="@+id/wvLiveCube"
     android:layout_width="match_parent"
     android:layout_height="match_parent"/>

  <!-- What a blind attempt sees instead of the cube. Nothing in here takes a touch: the timer
       screen has no dead zones, so a press lands on the WebView underneath exactly as it would
       anywhere else (see CLAUDE.md). -->
  <FrameLayout
     android:id="@+id/liveCubeVeil"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/live_cube_veil"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center"
       android:gravity="center_horizontal"
       android:orientation="vertical">

      <ImageView
         android:id="@+id/imgLiveCubeHidden"
         android:layout_width="28dp"
         android:layout_height="28dp"
         android:src="@drawable/ic_eye_off"
         android:tint="@color/secondary_text"
         android:contentDescription="@null"/> <!-- the line below says it -->

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:text="@string/live_cube_hidden_blind"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>

    </LinearLayout>

  </FrameLayout>

  <!-- Said out loud when the mirror knows it is wrong, in place of the cube fading to a third of
       its brightness: a cube nobody can read is worse than a cube with a note on it. Not clickable,
       for the same reason as the cover above. -->
  <TextView
     android:id="@+id/tvLiveCubeStale"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_gravity="top|center_horizontal"
     android:background="@drawable/smart_cube_pill"
     android:paddingLeft="9dp"
     android:paddingRight="9dp"
     android:paddingTop="2dp"
     android:paddingBottom="2dp"
     android:text="@string/live_cube_out_of_sync"
     android:textColor="@color/warning"
     android:textSize="11sp"
     android:visibility="gone"/>

</FrameLayout>
