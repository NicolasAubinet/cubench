<?xml version="1.0" encoding="utf-8"?>

<!-- The connected cube, mirrored. Inflated from a stub only when one is connected, and given the
     stub's own layout params, so the timer screen is untouched for everyone else.

     Everything over the cube is authored in dp, and LiveCubeView marks it so the timer's px scaling
     pass leaves it alone — reached or not depending on whether the cube inflated before the screen's
     first measure, that pass was drawing the same thing at two different sizes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/liveCubeLayout"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:visibility="gone">

  <WebView
     android:id="@+id/wvLiveCube"
     android:layout_width="match_parent"
     android:layout_height="match_parent"/>

  <!-- What a blind attempt sees instead of the cube: the mark alone, centred on the cube's space.
       Nothing in here takes a touch, and the WebView below is INVISIBLE for as long as this is up,
       so a press falls through to the timer layout's own listener and starts or stops the timer
       like a press anywhere else (see CLAUDE.md).

       No background of its own: the screen's ground changes colour under a press, and a cover with
       its own colour stayed put and read as a rectangle that had missed the press. It has nothing
       to cover anyway, LiveCubeView hiding the cube for as long as this is up. -->
  <FrameLayout
     android:id="@+id/liveCubeVeil"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:visibility="gone">

    <ImageView
       android:id="@+id/imgLiveCubeHidden"
       android:layout_width="52dp"
       android:layout_height="52dp"
       android:layout_gravity="center"
       android:src="@drawable/ic_live_cube_hidden"
       android:contentDescription="@null"/>

  </FrameLayout>

</FrameLayout>
