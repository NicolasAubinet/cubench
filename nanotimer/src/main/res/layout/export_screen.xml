<?xml version="1.0" encoding="utf-8"?>

<!-- Two things leave the app, and they are told apart by what they are for rather than by what
     they can carry. The backup is one card and takes everything; the CSV is a section under it,
     with the running total and the cards that change it. The buttons at the bottom are the CSV's.

     The total sits inside the scroll rather than pinned above it: pinned, it stood over the backup
     card and looked like a figure that described it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:fitsSystemWindows="true"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:orientation="vertical"
   android:background="@color/graybg">

  <ScrollView
     android:id="@+id/scrollView"
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:paddingLeft="@dimen/space_m"
     android:paddingRight="@dimen/space_m"
     android:clipToPadding="false"
     android:requiresFadingEdge="vertical"
     android:fadingEdgeLength="16dp">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingTop="@dimen/space_s"
       android:paddingBottom="@dimen/space_m">

      <include layout="@layout/export_backup_card"/>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:paddingLeft="@dimen/space_s"
         android:paddingRight="@dimen/space_s"
         android:text="@string/export_csv_title"
         style="@style/DialogSectionLabel"/>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="1dp"
         android:paddingLeft="@dimen/space_s"
         android:paddingRight="@dimen/space_s"
         android:text="@string/export_csv_caption"
         android:textSize="13sp"
         android:textColor="@color/secondary_text"/>

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="horizontal"
         android:gravity="center_vertical"
         android:layout_marginTop="@dimen/space_xs"
         android:paddingLeft="@dimen/space_s">

        <!-- Shrinks rather than truncates: a running total cut off mid-figure says nothing. -->
        <com.cube.nanotimer.util.view.FontFitTextView
           android:id="@+id/tvSelection"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="1"
           android:textSize="17sp"
           android:textStyle="bold"
           android:textColor="@color/white"
           android:fontFeatureSettings="tnum"
           android:singleLine="true"/>

        <TextView
           android:id="@+id/tvSelectAll"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:minHeight="44dp"
           android:gravity="center"
           android:paddingLeft="@dimen/space_m"
           android:paddingRight="@dimen/space_m"
           android:textSize="14sp"
           android:textStyle="bold"
           android:textColor="@color/lightblue"
           android:singleLine="true"
           android:background="@drawable/hero_selector_row"
           android:clickable="true"
           android:focusable="true"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/puzzleCards"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="@dimen/space_xs"
         android:orientation="vertical"/>

      <!-- Puzzles you have never timed are still worth being able to look for, and worth nothing
           in an export, so they fold away behind one line. -->
      <TextView
         android:id="@+id/tvEmptyPuzzles"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:minHeight="40dp"
         android:gravity="center"
         android:textSize="13sp"
         android:textColor="@color/lightblue"
         android:background="@drawable/hero_selector_row"
         android:clickable="true"
         android:focusable="true"
         android:visibility="gone"/>

      <com.cube.nanotimer.util.view.FlowLayout
         android:id="@+id/emptyPuzzlePills"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:paddingTop="@dimen/space_xs"
         android:paddingLeft="@dimen/space_xs"
         android:paddingRight="@dimen/space_xs"
         android:visibility="gone"/>

    </LinearLayout>
  </ScrollView>

  <include layout="@layout/export_actions"/>

</LinearLayout>
