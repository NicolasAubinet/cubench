<?xml version="1.0" encoding="utf-8"?>
<!-- One source of the solver's times for a case: where and how many, the mean, the best, then where
     the time went, each half named under its own end of the bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="0dp"
   android:layout_height="wrap_content"
   android:background="?android:attr/selectableItemBackground"
   android:orientation="vertical"
   android:paddingTop="4dp"
   android:paddingBottom="4dp">

  <TextView
     android:id="@+id/tvCaseFiguresSource"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:ellipsize="end"
     android:fontFeatureSettings="tnum"
     android:maxLines="1"
     android:textColor="@color/case_band_label"
     android:textSize="12sp"/>

  <TextView
     android:id="@+id/tvCaseFiguresMean"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginTop="2dp"
     android:fontFeatureSettings="tnum"
     android:includeFontPadding="false"
     android:letterSpacing="-0.03"
     android:textColor="@color/white"
     android:textSize="36sp"
     android:textStyle="bold"/>

  <TextView
     android:id="@+id/tvCaseFiguresBest"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginTop="4dp"
     android:fontFeatureSettings="tnum"
     android:textColor="@color/case_band_label"
     android:textSize="12sp"/>

  <com.cube.nanotimer.util.view.DrillSplitBarView
     android:id="@+id/vCaseFiguresBar"
     android:layout_width="match_parent"
     android:layout_height="4dp"
     android:layout_marginTop="8dp"/>

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="4dp"
     android:orientation="horizontal">

    <TextView
       android:id="@+id/tvCaseFiguresRecognition"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:fontFeatureSettings="tnum"
       android:maxLines="1"
       android:textSize="11sp"/>

    <TextView
       android:id="@+id/tvCaseFiguresExecution"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:fontFeatureSettings="tnum"
       android:maxLines="1"
       android:textSize="11sp"/>
  </LinearLayout>
</LinearLayout>
