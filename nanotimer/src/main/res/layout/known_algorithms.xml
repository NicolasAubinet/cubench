<?xml version="1.0" encoding="utf-8"?>
<!-- Which cases go in unaided, and what the solver turns for each. The family segments and the
     count stay above the scroll: the list is every case of a family, and a count that scrolled away
     with it would be unreadable from exactly the point in the list where it is worth knowing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true"
   android:orientation="vertical">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingLeft="16dp"
     android:paddingRight="16dp"
     android:paddingTop="10dp">

    <LinearLayout
       android:id="@+id/llKnownAlgorithmsFamily"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@drawable/view_segment_group"
       android:orientation="horizontal"
       android:padding="3dp"/>

    <TextView
       android:id="@+id/tvKnownAlgorithmsCount"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/white"
       android:textSize="15sp"/>

    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:text="@string/known_algorithms_subtitle"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>
  </LinearLayout>

  <!-- The list runs under the count, so it needs an edge to run under. -->
  <View
     android:layout_width="match_parent"
     android:layout_height="1dp"
     android:layout_marginTop="12dp"
     android:background="@color/hero_divider"/>

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingBottom="16dp">

      <!-- Instead of the list, while it is being read and if there is nothing behind it. -->
      <TextView
         android:id="@+id/tvKnownAlgorithmsEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="60dp"
         android:gravity="center"
         android:paddingLeft="16dp"
         android:paddingRight="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="16sp"
         android:visibility="gone"/>

      <!-- A heading and its cases, then the next, filled in code. -->
      <LinearLayout
         android:id="@+id/llKnownAlgorithmsRows"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"/>

      <TextView
         android:id="@+id/tvKnownAlgorithmsHint"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:text="@string/known_algorithms_hint"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>
  </ScrollView>

</LinearLayout>
