<?xml version="1.0" encoding="utf-8"?>
<!-- The running drill's figures, the hero card's cells without the ripple: what the reps so far
     average to, how long the reading took, and the best of them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="horizontal">

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginRight="3dp"
     android:orientation="vertical"
     android:background="@drawable/drill_stat_cell"
     android:paddingTop="7dp"
     android:paddingBottom="7dp">
    <com.cube.nanotimer.util.view.FontFitTextView
       android:id="@+id/tvDrillLiveMeanKey"
       style="@style/HeroStatKey"
       android:text="@string/drill_summary_cell_mean"/>
    <com.cube.nanotimer.util.view.FontFitTextView
       android:id="@+id/tvDrillLiveMean"
       style="@style/HeroStatValue"
       android:text="@string/drill_case_no_time"/>
  </LinearLayout>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginLeft="3dp"
     android:layout_marginRight="3dp"
     android:orientation="vertical"
     android:background="@drawable/drill_stat_cell"
     android:paddingTop="7dp"
     android:paddingBottom="7dp">
    <com.cube.nanotimer.util.view.FontFitTextView
       android:id="@+id/tvDrillLiveRecognitionKey"
       style="@style/HeroStatKey"
       android:text="@string/drill_summary_column_recognition"/>
    <com.cube.nanotimer.util.view.FontFitTextView
       android:id="@+id/tvDrillLiveRecognition"
       style="@style/HeroStatValue"
       android:text="@string/drill_case_no_time"/>
  </LinearLayout>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginLeft="3dp"
     android:orientation="vertical"
     android:background="@drawable/drill_stat_cell"
     android:paddingTop="7dp"
     android:paddingBottom="7dp">
    <com.cube.nanotimer.util.view.FontFitTextView
       android:id="@+id/tvDrillLiveBestKey"
       style="@style/HeroStatKey"
       android:text="@string/drill_summary_cell_best"/>
    <com.cube.nanotimer.util.view.FontFitTextView
       android:id="@+id/tvDrillLiveBest"
       style="@style/HeroStatValue"
       android:text="@string/drill_case_no_time"/>
  </LinearLayout>
</LinearLayout>
