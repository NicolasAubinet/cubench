<?xml version="1.0" encoding="utf-8"?>
<!-- Picking a drill. The card on top is the choice itself: the practice, then what it will deal.
     The rows under it are the drill's settings, and Start stays pinned at the bottom. The card and
     the row icons take the practice's step colour, painted in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:tools="http://schemas.android.com/tools"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:fitsSystemWindows="true"
   android:orientation="vertical">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="@dimen/space_m"
       android:paddingRight="@dimen/space_m"
       android:paddingTop="@dimen/space_xs"
       android:paddingBottom="@dimen/space_m">

      <LinearLayout
         android:id="@+id/llDrillHero"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:paddingLeft="@dimen/space_s"
         android:paddingRight="@dimen/space_s"
         android:paddingTop="9dp"
         android:paddingBottom="11dp">

        <!-- One tile per practice, filled in code. -->
        <LinearLayout
           android:id="@+id/llDrillPractice"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal"/>

        <!-- A case drill: what it deals, and the first few of those cases drawn out. All of it
             opens the picker, the cases included: Choose names the block, it is not the only way in. -->
        <LinearLayout
           android:id="@+id/llDrillCases"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp"
           android:background="@drawable/hero_selector_row"
           android:clickable="true"
           android:focusable="true"
           android:orientation="vertical">

          <LinearLayout
             android:id="@+id/llDrillCasesPick"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:gravity="center_vertical"
             android:minHeight="52dp"
             android:orientation="horizontal"
             android:paddingLeft="@dimen/space_xs"
             android:paddingRight="@dimen/space_xs">

            <LinearLayout
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:orientation="vertical">

              <TextView
                 android:id="@+id/tvDrillCasesFamily"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:letterSpacing="0.14"
                 android:textAllCaps="true"
                 android:textSize="11sp"
                 android:textStyle="bold"/>

              <TextView
                 android:id="@+id/tvDrillCasesCount"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:ellipsize="end"
                 android:maxLines="1"
                 android:textColor="@color/white"
                 android:textSize="22sp"
                 android:textStyle="bold"/>
            </LinearLayout>

            <TextView
               android:id="@+id/tvDrillCasesChoose"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/space_s"
               android:paddingLeft="10dp"
               android:paddingRight="10dp"
               android:paddingTop="4dp"
               android:paddingBottom="4dp"
               android:text="@string/drill_cases_choose"
               android:textSize="13sp"/>
          </LinearLayout>

          <!-- Charts of the cases the drill will deal, each on its own stage, populated in code. -->
          <LinearLayout
             android:id="@+id/llDrillCasesPicked"
             android:baselineAligned="false"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="@dimen/space_s"
             android:orientation="horizontal"
             android:paddingLeft="0dp"
             android:paddingRight="0dp"
             android:paddingTop="2dp"
             android:paddingBottom="0dp"/>
        </LinearLayout>

        <!-- F2L and cross: no set to pick, so a picture of the practice in its place. -->
        <LinearLayout
           android:id="@+id/llDrillPicture"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="14dp"
           android:gravity="center_vertical"
           android:orientation="horizontal"
           android:paddingLeft="@dimen/space_xs"
           android:visibility="gone">

          <com.cube.nanotimer.gui.widget.DrillFacePicture
             android:id="@+id/vDrillPicture"
             android:layout_width="72dp"
             android:layout_height="72dp"/>

          <LinearLayout
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_marginLeft="14dp"
             android:layout_weight="1"
             android:orientation="vertical">

            <TextView
               android:id="@+id/tvDrillPictureLabel"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:letterSpacing="0.14"
               android:textAllCaps="true"
               android:textSize="11sp"
               android:textStyle="bold"/>

            <TextView
               android:id="@+id/tvDrillPictureTitle"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textColor="@color/white"
               android:textSize="22sp"
               android:textStyle="bold"/>
          </LinearLayout>
        </LinearLayout>

        <!-- Only for an F2L drill: basic pairs, advanced ones with a piece in another slot, or both. -->
        <LinearLayout
           android:id="@+id/llDrillF2lCases"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="12dp"
           android:background="@drawable/view_segment_group"
           android:orientation="horizontal"
           android:padding="3dp"
           android:visibility="gone"/>

        <TextView
           android:id="@+id/tvDrillPracticeHint"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="@dimen/space_s"
           android:paddingLeft="@dimen/space_xs"
           android:paddingRight="@dimen/space_xs"
           android:textColor="@color/secondary_text"
           android:textSize="13sp"/>
      </LinearLayout>

      <!-- The drill's settings. Each optional row carries its own divider above it. -->
      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginLeft="@dimen/space_s"
         android:layout_marginRight="@dimen/space_s"
         android:layout_marginTop="@dimen/space_l"
         android:orientation="vertical">

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center_vertical"
           android:minHeight="54dp"
           android:orientation="horizontal">

          <ImageView
             android:id="@+id/ivDrillRepsIcon"
             android:layout_width="20dp"
             android:layout_height="20dp"
             android:importantForAccessibility="no"
             android:src="@drawable/ic_drill_reps"/>

          <TextView
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_marginLeft="@dimen/space_m"
             android:layout_weight="1"
             android:text="@string/drill_reps"
             android:textColor="@color/white"
             android:textSize="15sp"/>

          <LinearLayout
             android:id="@+id/llDrillReps"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:background="@drawable/view_segment_group"
             android:orientation="horizontal"
             android:padding="2dp"/>
        </LinearLayout>

        <!-- Whether the reps are kept, as a plain switch: the choice is only ever on or off. -->
        <LinearLayout
           android:id="@+id/llDrillRecord"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical">

          <View
             android:layout_width="match_parent"
             android:layout_height="1dp"
             android:background="@color/listview_divider"/>

          <LinearLayout
             android:id="@+id/llDrillRecordRow"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:background="?attr/selectableItemBackground"
             android:gravity="center_vertical"
             android:minHeight="54dp"
             android:orientation="horizontal">

            <ImageView
               android:id="@+id/ivDrillRecordIcon"
               android:layout_width="20dp"
               android:layout_height="20dp"
               android:importantForAccessibility="no"
               android:src="@drawable/ic_drill_record"/>

            <TextView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/space_m"
               android:layout_weight="1"
               android:text="@string/drill_record"
               android:textColor="@color/white"
               android:textSize="15sp"/>

            <Switch
               android:id="@+id/swDrillRecord"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/space_m"/>
          </LinearLayout>
        </LinearLayout>

        <!-- Only for a cross drill: how long there is to plan it, limit and seconds on one row. -->
        <LinearLayout
           android:id="@+id/llDrillCrossOptions"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           android:visibility="gone">

          <View
             android:layout_width="match_parent"
             android:layout_height="1dp"
             android:background="@color/listview_divider"/>

          <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:gravity="center_vertical"
             android:minHeight="54dp"
             android:orientation="horizontal">

            <ImageView
               android:id="@+id/ivDrillPlanningIcon"
               android:layout_width="20dp"
               android:layout_height="20dp"
               android:importantForAccessibility="no"
               android:src="@drawable/ic_drill_planning"/>

            <TextView
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/space_m"
               android:layout_weight="1"
               android:text="@string/drill_planning_limit"
               android:textColor="@color/white"
               android:textSize="15sp"/>

            <LinearLayout
               android:id="@+id/llDrillPlanningSeconds"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/space_s"
               android:gravity="center_vertical"
               android:orientation="horizontal"
               android:visibility="gone">

              <!-- Picked from the app's presets-and-stepper dialog: typing two digits into a chip
                   this size is the one thing a phone makes hard. -->
              <TextView
                 android:id="@+id/tvDrillPlanningSeconds"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:background="@drawable/row_chip_accent"
                 android:clickable="true"
                 android:focusable="true"
                 android:gravity="center"
                 android:minWidth="44dp"
                 android:paddingLeft="10dp"
                 android:paddingRight="10dp"
                 android:paddingTop="4dp"
                 android:paddingBottom="4dp"
                 android:textColor="@color/lightblue"
                 android:textSize="15sp"/>

              <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginLeft="6dp"
                 android:text="@string/drill_planning_seconds"
                 android:textColor="@color/secondary_text"
                 android:textSize="13sp"/>
            </LinearLayout>

            <Switch
               android:id="@+id/swDrillPlanning"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="@dimen/space_m"/>
          </LinearLayout>
        </LinearLayout>

        <!-- The last layer colour setting, pickable here: every drill deals onto it, a cross drill
             building its cross on the opposite face. -->
        <View
           android:layout_width="match_parent"
           android:layout_height="1dp"
           android:background="@color/listview_divider"/>

        <LinearLayout
           android:id="@+id/llDrillLayerColour"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="?attr/selectableItemBackground"
           android:gravity="center_vertical"
           android:minHeight="58dp"
           android:orientation="horizontal"
           android:paddingTop="@dimen/space_s"
           android:paddingBottom="@dimen/space_s">

          <ImageView
             android:id="@+id/ivDrillLayerIcon"
             android:layout_width="20dp"
             android:layout_height="20dp"
             android:importantForAccessibility="no"
             android:src="@drawable/ic_drill_layer"/>

          <LinearLayout
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_marginLeft="@dimen/space_m"
             android:layout_marginRight="@dimen/space_m"
             android:layout_weight="1"
             android:orientation="vertical">

            <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="@string/last_layer_colour"
               android:textColor="@color/white"
               android:textSize="15sp"/>

            <!-- Says the pick is the app-wide setting, not this screen's own. -->
            <TextView
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="2dp"
               android:text="@string/drill_layer_colour_shared"
               android:textColor="@color/secondary_text"
               android:textSize="12sp"/>
          </LinearLayout>

          <include layout="@layout/preference_colour_chip"/>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>

  <!-- Start, or while no cube is connected the button that connects one, so the main control is
       never a dead slab. -->
  <Button
     android:id="@+id/btDrillStart"
     style="@style/HeroStartButton"
     android:layout_width="match_parent"
     android:layout_marginLeft="@dimen/space_m"
     android:layout_marginRight="@dimen/space_m"
     android:layout_marginTop="@dimen/space_s"
     android:layout_marginBottom="@dimen/space_l"
     android:text="@string/drill_start"
     tools:ignore="ButtonStyle"/>

</LinearLayout>
