<?xml version="1.0" encoding="utf-8"?>
<!-- Picking a drill: what to practise, how many reps, and whether the reps count. The three
     controls above the fold are the ones every drill has; what a cross drill needs on top hangs
     below them and is hidden for the others, so the screen never asks for a colour that has no
     cross to go on. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:fillViewport="true"
   android:fitsSystemWindows="true">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:padding="16dp">

    <TextView
       style="@style/DialogSectionLabel"
       android:text="@string/drill_practice"/>

    <LinearLayout
       android:id="@+id/llDrillPractice"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@drawable/cross_segment_container"
       android:orientation="horizontal"
       android:padding="3dp"/>

    <TextView
       android:id="@+id/tvDrillPracticeHint"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="6dp"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"/>

    <!-- Only a case drill has a set to pick from; a cross drill's case is a whole scramble. -->
    <LinearLayout
       android:id="@+id/llDrillCases"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical">

      <TextView
         style="@style/DialogSectionLabel"
         android:layout_marginTop="18dp"
         android:text="@string/drill_cases"/>

      <LinearLayout
         android:id="@+id/llDrillCasesPick"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:background="@drawable/choice_card"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingLeft="12dp"
         android:paddingRight="12dp"
         android:paddingTop="10dp"
         android:paddingBottom="10dp">

        <TextView
           android:id="@+id/tvDrillCasesCount"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="1"
           android:textColor="@color/white"
           android:textSize="15sp"/>

        <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/drill_cases_pick"
           android:textColor="@color/lightblue"
           android:textSize="14sp"/>
      </LinearLayout>
    </LinearLayout>

    <TextView
       style="@style/DialogSectionLabel"
       android:layout_marginTop="18dp"
       android:text="@string/drill_reps"/>

    <LinearLayout
       android:id="@+id/llDrillReps"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@drawable/cross_segment_container"
       android:orientation="horizontal"
       android:padding="3dp"/>

    <TextView
       style="@style/DialogSectionLabel"
       android:layout_marginTop="18dp"
       android:text="@string/drill_mode"/>

    <LinearLayout
       android:id="@+id/llDrillMode"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@drawable/cross_segment_container"
       android:orientation="horizontal"
       android:padding="3dp"/>

    <TextView
       android:id="@+id/tvDrillModeHint"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="6dp"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"/>

    <!-- Which face the drill is worked on: the cross for a cross drill, the last layer for a case
         one. Every drill has one, so the row is always here; only its name changes. -->
    <TextView
       android:id="@+id/tvDrillFaceLabel"
       style="@style/DialogSectionLabel"
       android:layout_marginTop="18dp"/>

    <!-- Row of six colour swatches, populated in code, and the same row the cross solver uses. -->
    <LinearLayout
       android:id="@+id/llDrillCrossSwatches"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"/>

    <!-- Only for a cross drill: how long there is to plan it. -->
    <LinearLayout
       android:id="@+id/llDrillCrossOptions"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:visibility="gone">

      <CheckBox
         android:id="@+id/cbDrillPlanning"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="14dp"
         android:text="@string/drill_planning_limit"
         android:textColor="@color/white"
         android:textSize="15sp"/>

      <LinearLayout
         android:id="@+id/llDrillPlanningSeconds"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:visibility="gone">

        <EditText
           android:id="@+id/etDrillPlanningSeconds"
           android:layout_width="72dp"
           android:layout_height="wrap_content"
           android:inputType="number"
           android:maxLength="3"
           android:importantForAutofill="no"
           android:textColor="@color/white"
           android:textSize="15sp"/>

        <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginLeft="8dp"
           android:text="@string/drill_planning_seconds"
           android:textColor="@color/secondary_text"
           android:textSize="15sp"/>
      </LinearLayout>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:text="@string/drill_planning_hint"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>
    </LinearLayout>

    <!-- Says why the mode controls sit above rather than inside the drill. -->
    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="20dp"
       android:text="@string/drill_mode_locked"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"/>

    <Button
       android:id="@+id/btDrillStart"
       style="@style/PrimaryButton"
       android:layout_marginTop="16dp"
       android:text="@string/drill_start"/>

    <TextView
       android:id="@+id/tvDrillNoCube"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:gravity="center"
       android:text="@string/drill_needs_cube"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"
       android:visibility="gone"/>

  </LinearLayout>
</ScrollView>
