<?xml version="1.0" encoding="utf-8"?>
<!-- One rep of a finished drill: the case's chart, its name, and what the attempt cost in each
     half and in both together. Built like a history row rather than like a table cell, since it is
     the same thing being read: a time, and enough beside it to say which one. No fill of its own,
     so the list reads as a list; the hairlines between rows come from the container.

     The figures fit themselves to the column rather than being cut off: a ten second recognition
     is rare but it is exactly the row worth reading, and at a large system font it is the one that
     would have run out of column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/llDrillCaseRow"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:background="@drawable/history_row"
   android:gravity="center_vertical"
   android:minHeight="48dp"
   android:orientation="horizontal"
   android:paddingLeft="@dimen/space_xs"
   android:paddingRight="@dimen/space_xs"
   android:paddingTop="@dimen/space_s"
   android:paddingBottom="@dimen/space_s">

  <!-- Where this rep fell in the drill. Left of the chart, so a reader looking for a particular
       attempt runs down one narrow column rather than reading rows. -->
  <TextView
     android:id="@+id/tvDrillCasePosition"
     style="@style/DrillCasePosition"/>

  <com.cube.nanotimer.gui.widget.LastLayerCaseView
     android:id="@+id/vDrillCaseChart"
     android:layout_width="36dp"
     android:layout_height="36dp"/>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginLeft="@dimen/space_m"
     android:layout_marginRight="@dimen/space_xs"
     android:orientation="vertical">

    <TextView
       android:id="@+id/tvDrillCaseName"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:ellipsize="end"
       android:fontFamily="@font/roboto_medium"
       android:maxLines="1"
       android:textColor="@color/white"
       android:textSize="15sp"/>

    <!-- What has to be said about the rep before its figures are read. Two lines are allowed for
         the rare one that has both to say, rather than losing the end of it. -->
    <TextView
       android:id="@+id/tvDrillCaseNote"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:ellipsize="end"
       android:maxLines="2"
       android:textColor="@color/secondary_text"
       android:textSize="11sp"
       android:visibility="gone"/>

    <!-- Where the rep's time went, which is the one thing the three figures make the reader work
         out. A fixed width rather than the row's: it is the shape of the rep and not its size, so
         every rep is measured against the same length, and at the row's full width a dozen of them
         read as a dozen progress bars. -->
    <com.cube.nanotimer.util.view.DrillSplitBarView
       android:id="@+id/vDrillCaseBar"
       android:layout_width="96dp"
       android:layout_height="5dp"
       android:layout_marginTop="5dp"/>
  </LinearLayout>

  <com.cube.nanotimer.util.view.FontFitTextView
     android:id="@+id/tvDrillCaseRecognition"
     style="@style/DrillCaseValue"/>

  <com.cube.nanotimer.util.view.FontFitTextView
     android:id="@+id/tvDrillCaseExecution"
     style="@style/DrillCaseValue"/>

  <com.cube.nanotimer.util.view.FontFitTextView
     android:id="@+id/tvDrillCaseTotal"
     style="@style/DrillCaseValue"/>

</LinearLayout>
