<?xml version="1.0" encoding="utf-8"?>
<!-- One case, and every attempt at it in the window the stats screen was left on, under a finished
     drill's card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true">

  <!-- One scroll for the card and the list: a fixed card would leave no room for rows in landscape. -->
  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="match_parent">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingLeft="16dp"
     android:paddingRight="16dp"
     android:paddingTop="12dp"
     android:paddingBottom="16dp">

    <!-- The case opens its sheet: the attempts below are rows, not ways into the case. -->
    <include layout="@layout/case_list_hero"/>

    <TextView
       android:id="@+id/tvDrillCaseStatsEmpty"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="32dp"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="16sp"
       android:visibility="gone"/>

    <LinearLayout
       android:id="@+id/llDrillCaseStatsSection"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:visibility="gone">

      <!-- case_table's heading ids, so CaseTableHeadings sorts it like every other table:
           "Attempts" by date (newest first), the three figures by time. -->
      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="20dp"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingLeft="@dimen/space_xs"
         android:paddingRight="@dimen/space_xs">

        <TextView
           android:id="@+id/tvCaseTableSortCount"
           style="@style/DrillCasePositionColumn"/>

        <TextView
           android:id="@+id/tvCaseTableLabel"
           style="@style/DialogSectionLabel"
           android:layout_width="0dp"
           android:layout_weight="1"/>

        <TextView
           android:id="@+id/tvCaseTableSortOne"
           style="@style/DrillCaseColumn"/>

        <TextView
           android:id="@+id/tvCaseTableSortTwo"
           style="@style/DrillCaseColumn"/>

        <TextView
           android:id="@+id/tvCaseTableSortThree"
           style="@style/DrillCaseColumn"
           android:layout_width="@dimen/drill_case_lead_column"/>

        <View
           android:id="@+id/vCaseTableChevronSpace"
           android:layout_width="20dp"
           android:layout_height="1dp"
           android:visibility="gone"/>
      </LinearLayout>

      <View
         android:layout_width="match_parent"
         android:layout_height="1dp"
         android:background="@color/hero_divider"/>

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical">

          <!-- One drill_case_attempt_row per rep, filled in code. -->
          <LinearLayout
             android:id="@+id/llDrillCaseStatsRows"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:divider="@drawable/stat_rule_h"
             android:orientation="vertical"
             android:showDividers="middle"/>

          <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="12dp"
             android:text="@string/drill_case_stats_hint"
             android:textColor="@color/secondary_text"
             android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

  </LinearLayout>
  </ScrollView>

  <!-- After a swipe: the attempt is out of the figures until this is tapped. -->
  <LinearLayout
     android:id="@+id/llDrillCaseUndo"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_gravity="bottom"
     android:layout_margin="16dp"
     android:background="@drawable/drill_case_undo_bar"
     android:elevation="6dp"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:paddingLeft="16dp"
     android:visibility="gone">

    <TextView
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:text="@string/drill_case_stats_removed"
       android:textColor="@color/white"
       android:textSize="14sp"/>

    <TextView
       android:id="@+id/tvDrillCaseUndo"
       android:layout_width="wrap_content"
       android:layout_height="48dp"
       android:background="?android:attr/selectableItemBackground"
       android:fontFamily="@font/roboto_medium"
       android:gravity="center"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:text="@string/smartcube_step_undo"
       android:textAllCaps="true"
       android:textColor="@color/lightblue"
       android:textSize="14sp"/>
  </LinearLayout>
</FrameLayout>
