<?xml version="1.0" encoding="utf-8"?>
<!-- Shown once over a coach learning drill when its last case completes the whole OLL or PLL set:
     every case of the set, and what that means. Takes every touch until closed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="#F2080A0C"
   android:clickable="true"
   android:focusable="true">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:id="@+id/svSetLearned"
     android:fillViewport="true">

    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:paddingTop="?attr/actionBarSize"
       android:paddingBottom="24dp">

      <LinearLayout
         android:id="@+id/llSetLearnedCard"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:layout_marginStart="18dp"
         android:layout_marginEnd="18dp"
         android:gravity="center_horizontal"
         android:orientation="vertical"
         android:paddingStart="20dp"
         android:paddingEnd="20dp"
         android:paddingBottom="22dp">

        <!-- The rays turn behind the trophy, wider than its disc. -->
        <FrameLayout
           android:layout_width="200dp"
           android:layout_height="150dp">

          <com.cube.nanotimer.util.view.RaysView
             android:id="@+id/vSetLearnedRays"
             android:layout_width="200dp"
             android:layout_height="200dp"
             android:layout_gravity="center"/>

          <FrameLayout
             android:id="@+id/flSetLearnedBadge"
             android:layout_width="104dp"
             android:layout_height="104dp"
             android:layout_gravity="center">

            <View
               android:id="@+id/vSetLearnedDisc"
               android:layout_width="match_parent"
               android:layout_height="match_parent"/>

            <ImageView
               android:id="@+id/ivSetLearnedTrophy"
               android:layout_width="56dp"
               android:layout_height="56dp"
               android:layout_gravity="center"
               android:importantForAccessibility="no"
               android:src="@drawable/trophy"/>
          </FrameLayout>
        </FrameLayout>

        <TextView
           android:id="@+id/tvSetLearnedLabel"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:letterSpacing="0.2"
           android:text="@string/set_learned_label"
           android:textAllCaps="true"
           android:textSize="13sp"
           android:textStyle="bold"/>

        <TextView
           android:id="@+id/tvSetLearnedTitle"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:textColor="@color/white"
           android:textSize="40sp"
           android:textStyle="bold"/>

        <TextView
           android:id="@+id/tvSetLearnedCount"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:textColor="@color/secondary_text"
           android:textSize="14sp"/>

        <!-- Every case of the set, rows filled left to right, landing in a wave. -->
        <LinearLayout
           android:id="@+id/llSetLearnedCases"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="16dp"
           android:orientation="vertical"/>

        <TextView
           android:id="@+id/tvSetLearnedBody"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="16dp"
           android:gravity="center"
           android:lineSpacingExtra="2dp"
           android:textColor="#E6FFFFFF"
           android:textSize="15.5sp"/>

        <TextView
           android:id="@+id/tvSetLearnedBoth"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="12dp"
           android:gravity="center"
           android:text="@string/set_learned_both"
           android:textSize="14.5sp"
           android:textStyle="bold"
           android:visibility="gone"/>

        <Button
           android:id="@+id/btSetLearnedContinue"
           style="@style/AccentActionButton"
           android:layout_width="match_parent"
           android:layout_marginTop="20dp"
           android:text="@string/group_learned_continue"/>
      </LinearLayout>
    </FrameLayout>
  </ScrollView>

  <!-- Over the card, so the bursts are seen; it takes no touch. -->
  <com.cube.nanotimer.util.view.ParticleView
     android:id="@+id/vSetLearnedConfetti"
     android:layout_width="match_parent"
     android:layout_height="match_parent"/>
</FrameLayout>
