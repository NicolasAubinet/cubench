<?xml version="1.0" encoding="utf-8"?>
<!-- What the Analysis hub measures, reached from the ? in its bar. One section per tab, only the
     asking tab's shown: the three answer different questions, and a reader on one of them has no
     use for the others' vocabulary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="8dp"
   android:paddingBottom="14dp"
   android:minWidth="300dp">

  <!-- The grip: what says the sheet can be dragged back down to close it. -->
  <View
     android:layout_width="32dp"
     android:layout_height="4dp"
     android:layout_gravity="center_horizontal"
     android:background="@drawable/bottomsheet_drag_handle"/>

  <androidx.core.widget.NestedScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginTop="12dp"
     android:requiresFadingEdge="vertical"
     android:fadingEdgeLength="28dp">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical">

      <!-- Whose figures these are, before whatever the asking tab calls them: it is true of every
           tab, so it is the one section that is not one of the three. -->
      <LinearLayout
         android:id="@+id/llAnalysisHelpSample"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginBottom="4dp"
         android:orientation="vertical"
         android:visibility="gone">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/analysis_help_sample"
           android:textColor="@color/white"
           android:textSize="20sp"
           android:textStyle="bold"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="6dp"
           android:layout_marginBottom="16dp"
           android:text="@string/analysis_help_sample_body"
           android:textColor="@color/secondary_text"
           android:textSize="13.5sp"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/llAnalysisHelpSolve"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/analysis_help_solve_title"
           android:textColor="@color/white"
           android:textSize="20sp"
           android:textStyle="bold"/>

        <TextView
           android:id="@+id/tvAnalysisHelpSolveBody"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="6dp"
           android:text="@string/analysis_help_solve_body"
           android:textColor="@color/secondary_text"
           android:textSize="13.5sp"/>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_bar" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_bar_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_delta" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_delta_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_table" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_table_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_spread" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_spread_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_standard" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_standard_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_extra" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_extra_body" style="@style/HelpTermText"/>
        </LinearLayout>

      </LinearLayout>

      <LinearLayout
         android:id="@+id/llAnalysisHelpCases"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/analysis_help_cases_title"
           android:textColor="@color/white"
           android:textSize="20sp"
           android:textStyle="bold"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="6dp"
           android:text="@string/analysis_help_cases_body"
           android:textColor="@color/secondary_text"
           android:textSize="13.5sp"/>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_cost" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_cost_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_too_few" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_too_few_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_known" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_known_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_help_shape" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_shape_body" style="@style/HelpTermText"/>
        </LinearLayout>

        <LinearLayout style="@style/HelpTermRow">
          <TextView android:text="@string/analysis_rest_title" style="@style/HelpTermName"/>
          <TextView android:text="@string/analysis_help_rest_body" style="@style/HelpTermText"/>
        </LinearLayout>

      </LinearLayout>

      <LinearLayout
         android:id="@+id/llAnalysisHelpPlan"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="@string/analysis_help_plan_title"
           android:textColor="@color/white"
           android:textSize="20sp"
           android:textStyle="bold"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="6dp"
           android:text="@string/analysis_help_plan_body"
           android:textColor="@color/secondary_text"
           android:textSize="13.5sp"/>

      </LinearLayout>

    </LinearLayout>

  </androidx.core.widget.NestedScrollView>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buAnalysisHelpDone"
     android:layout_width="match_parent"
     android:layout_marginTop="18dp"
     android:text="@string/close"
     style="@style/DialogActionButton"/>

</LinearLayout>
