<?xml version="1.0" encoding="utf-8"?>
<!-- One set: its cover case, name, size, what it does, and how far through it the solver is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginBottom="10dp"
   android:clickable="true"
   android:focusable="true"
   android:foreground="?android:attr/selectableItemBackground"
   android:gravity="center_vertical"
   android:orientation="horizontal"
   android:padding="12dp">

  <com.cube.nanotimer.gui.widget.LastLayerCaseView
     android:id="@+id/vLibrarySetCover"
     android:layout_width="68dp"
     android:layout_height="68dp"/>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_marginLeft="14dp"
     android:layout_weight="1"
     android:orientation="vertical">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:baselineAligned="true"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvLibrarySetName"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:fontFamily="@font/roboto_bold"
         android:textColor="@color/white"
         android:textSize="18sp"
         app:fontFamily="@font/roboto_bold"/>

      <TextView
         android:id="@+id/tvLibrarySetCount"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginLeft="8dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>

    <TextView
       android:id="@+id/tvLibrarySetDescription"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="1dp"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <com.cube.nanotimer.util.view.DrillSplitBarView
       android:id="@+id/vLibrarySetProgress"
       android:layout_width="match_parent"
       android:layout_height="5dp"
       android:layout_marginTop="8dp"/>

    <TextView
       android:id="@+id/tvLibrarySetProgress"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:textColor="@color/secondary_text"
       android:textSize="11sp"/>
  </LinearLayout>
</LinearLayout>
