<?xml version="1.0" encoding="utf-8"?>
<!-- What the session dialog's numbers mean, reached from the ? on its title line. A term and a line
     apiece: these are definitions, not actions, so there is nothing to put an icon on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="8dp"
   android:paddingBottom="14dp"
   android:minWidth="300dp">

  <!-- The grip: what says the sheet can be dragged back down to close it. -->
  <View
     android:layout_width="32dp"
     android:layout_height="4dp"
     android:layout_gravity="center_horizontal"
     android:background="@drawable/bottomsheet_drag_handle"/>

  <androidx.core.widget.NestedScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginTop="12dp"
     android:requiresFadingEdge="vertical"
     android:fadingEdgeLength="28dp">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical">

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="@string/sessiondetail_help_title"
         android:textColor="@color/white"
         android:textSize="20sp"
         android:textStyle="bold"/>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:text="@string/sessiondetail_help_body"
         android:textColor="@color/secondary_text"
         android:textSize="13.5sp"/>

      <LinearLayout
         android:id="@+id/helpRowAverage"
         style="@style/HelpTermRow">
        <TextView android:text="@string/session_avg" style="@style/HelpTermName"/>
        <TextView android:text="@string/sessiondetail_help_average" style="@style/HelpTermText"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/helpRowSuccessAverage"
         style="@style/HelpTermRow">
        <TextView android:text="@string/session_success_average" style="@style/HelpTermName"/>
        <TextView android:text="@string/sessiondetail_help_success_average" style="@style/HelpTermText"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/helpRowDeviation"
         style="@style/HelpTermRow">
        <TextView android:text="@string/session_deviation" style="@style/HelpTermName"/>
        <TextView android:text="@string/sessiondetail_help_deviation" style="@style/HelpTermText"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/helpRowBestMo3"
         style="@style/HelpTermRow">
        <TextView android:text="@string/session_best_mean_of_three" style="@style/HelpTermName"/>
        <TextView android:text="@string/sessiondetail_help_best_mo3" style="@style/HelpTermText"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/helpRowAccuracy"
         style="@style/HelpTermRow">
        <TextView android:text="@string/session_accuracy" style="@style/HelpTermName"/>
        <TextView android:text="@string/sessiondetail_help_accuracy" style="@style/HelpTermText"/>
      </LinearLayout>

      <LinearLayout
         android:id="@+id/helpRowBestAverages"
         style="@style/HelpTermRow">
        <TextView android:text="@string/best_averages" style="@style/HelpTermName"/>
        <TextView android:text="@string/sessiondetail_help_best_averages" style="@style/HelpTermText"/>
      </LinearLayout>

    </LinearLayout>

  </androidx.core.widget.NestedScrollView>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buSessionDetailHelpDone"
     android:layout_width="match_parent"
     android:layout_marginTop="18dp"
     android:text="@string/close"
     style="@style/DialogActionButton"/>

</LinearLayout>
