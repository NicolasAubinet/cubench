<?xml version="1.0" encoding="utf-8"?>
<!-- The head of a picker: what is being chosen, and what is chosen right now. It sits on its own
     band with a line under it, so the list below reads as the answer to it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="horizontal"
     android:gravity="center_vertical"
     android:paddingLeft="18dp"
     android:paddingRight="18dp"
     android:paddingTop="16dp"
     android:paddingBottom="14dp">

    <FrameLayout
       android:id="@+id/headerTile"
       android:layout_width="38dp"
       android:layout_height="38dp"
       android:layout_marginRight="14dp"
       android:layout_marginEnd="14dp">

      <ImageView
         android:id="@+id/imgHeaderIcon"
         android:layout_width="22dp"
         android:layout_height="22dp"
         android:layout_gravity="center"
         android:contentDescription="@null"/>
    </FrameLayout>

    <LinearLayout
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:orientation="vertical">

      <TextView
         android:id="@+id/tvHeaderEyebrow"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:textAllCaps="true"
         android:textSize="11sp"
         android:letterSpacing="0.11"
         android:singleLine="true"/>

      <TextView
         android:id="@+id/tvHeaderTitle"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="1dp"
         android:textSize="21sp"
         android:textStyle="bold"
         android:letterSpacing="-0.01"
         android:textColor="@color/white"
         android:singleLine="true"
         android:ellipsize="end"/>
    </LinearLayout>

    <!-- Only the pickers that name things needing explaining ask for this. -->
    <ImageView
       android:id="@+id/buSelectorHelp"
       android:layout_width="30dp"
       android:layout_height="30dp"
       android:layout_marginLeft="8dp"
       android:layout_marginStart="8dp"
       android:scaleType="fitCenter"
       android:padding="5dp"
       android:background="?android:attr/selectableItemBackgroundBorderless"
       android:src="@drawable/ic_help_outline"
       android:visibility="gone"
       android:contentDescription="@null"/>

  </LinearLayout>

  <!-- Whatever has to be said about the whole list rather than about one row of it. -->
  <TextView
     android:id="@+id/tvHeaderNote"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:paddingLeft="18dp"
     android:paddingRight="18dp"
     android:paddingBottom="14dp"
     android:textSize="12sp"
     android:lineSpacingExtra="2dp"
     android:textColor="@color/secondary_text"
     android:visibility="gone"/>

  <View
     android:layout_width="match_parent"
     android:layout_height="1dp"
     android:background="@color/hero_divider"/>

</LinearLayout>
