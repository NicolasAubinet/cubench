<?xml version="1.0" encoding="utf-8"?>
<!-- One case, and the times in solves the case sheet's In solves card is the mean of. Shaped like
     the drill attempts screen, so the two read alike. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true">

<!-- The case and its figures stay put; only the solves scroll. -->
  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:paddingLeft="16dp"
     android:paddingRight="16dp"
     android:paddingTop="12dp">

    <!-- The case opens its sheet; each row below opens its solve. -->
    <LinearLayout
       android:id="@+id/llCaseSolvesHeader"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="?android:attr/selectableItemBackground"
       android:clickable="true"
       android:focusable="true"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <com.cube.nanotimer.gui.widget.LastLayerCaseView
         android:id="@+id/vCaseSolvesChart"
         android:layout_width="64dp"
         android:layout_height="64dp"/>

      <com.cube.nanotimer.gui.widget.PairCaseView
         android:id="@+id/vCaseSolvesPair"
         android:layout_width="64dp"
         android:layout_height="64dp"
         android:visibility="gone"/>

      <LinearLayout
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:layout_marginLeft="14dp"
         android:orientation="vertical">

        <TextView
           android:id="@+id/tvCaseSolvesName"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:ellipsize="end"
           android:fontFamily="@font/roboto_medium"
           android:maxLines="1"
           android:textColor="@color/white"
           android:textSize="22sp"/>

        <TextView
           android:id="@+id/tvCaseSolvesWindow"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:textColor="@color/secondary_text"
           android:textSize="13sp"/>
      </LinearLayout>
    </LinearLayout>

    <!-- The same three cells the stats screen and a finished drill are read from. -->
    <include
       layout="@layout/drill_stat_cells"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="16dp"/>

    <TextView
       android:id="@+id/tvCaseSolvesEmpty"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="32dp"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="16sp"
       android:visibility="gone"/>

    <LinearLayout
       android:id="@+id/llCaseSolvesSection"
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:orientation="vertical"
       android:visibility="gone">

      <!-- case_table's heading ids, so CaseTableHeadings sorts it like every other table:
           "Solves" by date (newest first), the three figures by time. -->
      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="20dp"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingLeft="@dimen/space_xs"
         android:paddingRight="@dimen/space_xs">

        <TextView
           android:id="@+id/tvCaseTableSortCount"
           style="@style/DrillCasePositionColumn"/>

        <TextView
           android:id="@+id/tvCaseTableLabel"
           style="@style/DialogSectionLabel"
           android:layout_width="0dp"
           android:layout_weight="1"/>

        <TextView
           android:id="@+id/tvCaseTableSortOne"
           style="@style/DrillCaseColumn"/>

        <TextView
           android:id="@+id/tvCaseTableSortTwo"
           style="@style/DrillCaseColumn"/>

        <TextView
           android:id="@+id/tvCaseTableSortThree"
           style="@style/DrillCaseColumn"
           android:layout_width="@dimen/drill_case_lead_column"/>

        <View
           android:id="@+id/vCaseTableChevronSpace"
           android:layout_width="20dp"
           android:layout_height="1dp"
           android:visibility="gone"/>
      </LinearLayout>

      <View
         android:layout_width="match_parent"
         android:layout_height="1dp"
         android:background="@color/hero_divider"/>

      <ScrollView
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="1">

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           android:paddingBottom="16dp">

          <!-- One drill_case_attempt_row per time, filled in code. -->
          <LinearLayout
             android:id="@+id/llCaseSolvesRows"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:divider="@drawable/stat_rule_h"
             android:orientation="vertical"
             android:showDividers="middle"/>

          <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="12dp"
             android:text="@string/case_solves_hint"
             android:textColor="@color/secondary_text"
             android:textSize="12sp"/>
        </LinearLayout>
      </ScrollView>
    </LinearLayout>

  </LinearLayout>
</FrameLayout>
