<?xml version="1.0" encoding="utf-8"?>
<!-- What a cross drill has to say once the rep is over: what the user turned, the shortest way
     there was, and a way to walk that way on the cube standing above it.

     Both rows are set in the timer's monospace, each move in a column of its own width, so the two
     line up under one another. They scroll sideways rather than wrapping. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The moves the user turned, folded as they were counted and spelled cross-on-bottom like the
       row under it. Live during a rep, and kept after it. -->
  <LinearLayout
     android:id="@+id/llCrossYours"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:visibility="gone">

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="@string/drill_cross_panel_you"
       android:textAllCaps="true"
       android:letterSpacing="0.12"
       android:textColor="@color/secondary_text"
       android:textSize="11sp"/>

    <HorizontalScrollView
       android:id="@+id/svCrossYours"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:scrollbars="none"
       android:requiresFadingEdge="horizontal"
       android:fadingEdgeLength="20dp">

      <TextView
         android:id="@+id/tvCrossYours"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:singleLine="true"
         android:textColor="@color/gray200"
         android:textSize="18sp"/>
    </HorizontalScrollView>
  </LinearLayout>

  <!-- The answer, in the accent so it is the row the eye lands on. -->
  <LinearLayout
     android:id="@+id/llCrossBest"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="10dp"
     android:orientation="vertical"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvCrossBestLabel"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textAllCaps="true"
         android:letterSpacing="0.12"
         android:textColor="@color/lightblue"
         android:textSize="11sp"/>

      <!-- Every other solution of the same length, switched in place so it can be turned on the
           cube you can see. -->
      <LinearLayout
         android:id="@+id/llCrossAlts"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:background="@drawable/view_segment_group"
         android:padding="2dp"
         android:visibility="gone">

        <ImageButton
           android:id="@+id/btCrossAltPrev"
           android:layout_width="30dp"
           android:layout_height="30dp"
           android:padding="6dp"
           android:scaleType="fitCenter"
           android:background="?android:attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_alt_prev"
           android:contentDescription="@string/drill_cross_other_ways"/>

        <TextView
           android:id="@+id/tvCrossAltIndex"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:minWidth="46dp"
           android:gravity="center"
           android:textColor="@color/secondary_text"
           android:textSize="13sp"
           android:fontFeatureSettings="tnum"/>

        <ImageButton
           android:id="@+id/btCrossAltNext"
           android:layout_width="30dp"
           android:layout_height="30dp"
           android:padding="6dp"
           android:scaleType="fitCenter"
           android:background="?android:attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_alt_next"
           android:contentDescription="@string/drill_cross_other_ways"/>
      </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
       android:id="@+id/svCrossBest"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:scrollbars="none"
       android:requiresFadingEdge="horizontal"
       android:fadingEdgeLength="20dp">

      <TextView
         android:id="@+id/tvCrossBestMoves"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:singleLine="true"
         android:textColor="@color/lightblue"
         android:textSize="18sp"/>
    </HorizontalScrollView>

    <!-- Walking the solution on the drawn cube, a move at a time, and at the far end the list of
         every solution, set apart so it does not read as a fourth step. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content">

      <LinearLayout
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:gravity="center"
         android:orientation="horizontal">

        <ImageButton
           android:id="@+id/btCrossStepStart"
           android:layout_width="44dp"
           android:layout_height="40dp"
           android:padding="9dp"
           android:scaleType="fitCenter"
           android:background="?android:attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_move_start"
           android:contentDescription="@string/drill_cross_start_position"/>

        <ImageButton
           android:id="@+id/btCrossStepBack"
           android:layout_width="44dp"
           android:layout_height="40dp"
           android:layout_marginLeft="16dp"
           android:padding="9dp"
           android:scaleType="fitCenter"
           android:background="?android:attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_move_prev"
           android:contentDescription="@string/drill_cross_step_back"/>

        <ImageButton
           android:id="@+id/btCrossStepNext"
           android:layout_width="44dp"
           android:layout_height="40dp"
           android:layout_marginLeft="16dp"
           android:padding="9dp"
           android:scaleType="fitCenter"
           android:background="?android:attr/selectableItemBackgroundBorderless"
           android:src="@drawable/ic_move_next"
           android:contentDescription="@string/drill_cross_step_forward"/>
      </LinearLayout>

      <ImageButton
         android:id="@+id/btCrossAllSolutions"
         android:layout_width="36dp"
         android:layout_height="36dp"
         android:layout_gravity="end|center_vertical"
         android:padding="8dp"
         android:scaleType="fitCenter"
         android:background="@drawable/cross_list_button"
         android:src="@drawable/ic_solutions_list"
         android:contentDescription="@string/drill_cross_all_solutions"
         android:visibility="gone"/>
    </FrameLayout>
  </LinearLayout>

</merge>
