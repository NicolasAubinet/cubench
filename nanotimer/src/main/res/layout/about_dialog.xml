<?xml version="1.0" encoding="utf-8"?>

<!-- The dialog carries its own header: the app is the subject, so it says so as a hero rather
     than as a title bar over the top of a second copy of its own name. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content">

  <LinearLayout
     android:orientation="vertical"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:paddingLeft="@dimen/space_l"
     android:paddingRight="@dimen/space_l"
     android:paddingTop="20dp"
     android:paddingBottom="@dimen/space_l"
     android:gravity="center_horizontal"
     android:minWidth="300dp">

    <ImageView
       android:layout_width="64dp"
       android:layout_height="64dp"
       android:src="@drawable/icon"
       android:contentDescription="@null"/>

    <TextView
       android:id="@+id/tvAppName"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/space_m"
       android:text="@string/app_name"
       android:textColor="@color/white"
       android:textSize="24sp"
       android:textStyle="bold"/>

    <TextView
       android:id="@+id/tvAppVersion"
       android:layout_marginTop="2dp"
       android:textAllCaps="false"
       style="@style/DialogSectionLabel"/>

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/space_s"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="14sp"
       android:text="@string/app_description"/>

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:textColor="@color/gray600"
       android:textSize="12sp"
       android:textStyle="italic"
       android:text="@string/app_formerly_name"/>

    <!-- The one thing the screen asks of the reader, so it is the one thing on a lit surface. -->
    <androidx.cardview.widget.CardView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="20dp"
       style="@style/TableCardView">

      <LinearLayout
         android:orientation="vertical"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:gravity="center_horizontal"
         android:padding="@dimen/space_m">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center"
           android:textColor="@color/secondary_text"
           android:textSize="14sp"
           android:text="@string/feedback_message"/>

        <!-- The address is what the card is for, so it carries the weight and the name sits under
             it as context, not the other way round. -->
        <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="@dimen/space_m"
           android:autoLink="email"
           android:textColorLink="@color/lightblue"
           android:textSize="16sp"
           android:text="@string/email"/>

        <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="1dp"
           android:textColor="@color/gray600"
           android:textSize="13sp"
           android:text="@string/dev_name"/>
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginTop="20dp"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"
       android:text="@string/app_name_copyright"/>

    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/space_m"
       android:gravity="center"
       android:textColor="@color/gray600"
       android:textSize="11sp"
       android:text="@string/app_license"/>

  </LinearLayout>

</ScrollView>
