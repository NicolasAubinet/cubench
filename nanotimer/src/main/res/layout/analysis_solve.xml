<?xml version="1.0" encoding="utf-8"?>
<!-- How the solve goes: what it is made of, whether that is in proportion, and one line per step.

     Two charts rather than one, because neither can do the other's job. The bar says what the solve
     is made of; the signed bars under it say whether that is in proportion, which the composition
     cannot say without drawing the reference on itself as notches, and those are cumulative: one
     over-long first step would shift every notch after it and three steps of four would read as
     wrong. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/llAnalysisSolve"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical">

  <!-- No card behind the mean: it stands free at hero size, as the timer's own result does, and the
       composition is the same bar the main screen's hero card draws. -->
  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingTop="4dp">

    <TextView
       android:id="@+id/tvAnalysisMean"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fontFeatureSettings="tnum"
       android:gravity="center_horizontal"
       android:includeFontPadding="false"
       android:singleLine="true"
       android:textColor="@color/white"
       android:textSize="58sp"
       android:textStyle="bold"/>

    <TextView
       android:id="@+id/tvAnalysisMeanOf"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:fontFeatureSettings="tnum"
       android:gravity="center_horizontal"
       android:textColor="@color/secondary_text"
       android:textSize="14sp"/>

    <com.cube.nanotimer.util.view.SolveStepBarView
       android:id="@+id/vAnalysisComposition"
       android:layout_width="match_parent"
       android:layout_height="12dp"
       android:layout_marginTop="14dp"/>

    <!-- Every segment named under the bar, each in its own column: name, time, then share. -->
    <LinearLayout
       android:id="@+id/llAnalysisLegend"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="9dp"
       android:baselineAligned="false"
       android:orientation="horizontal"/>
  </LinearLayout>

  <LinearLayout
     android:id="@+id/llAnalysisDeltaCard"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="12dp"
     android:background="@drawable/analysis_card"
     android:orientation="vertical"
     android:padding="14dp">

    <TextView
       android:id="@+id/tvAnalysisDeltaLabel"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginBottom="10dp"
       android:letterSpacing="0.09"
       android:textColor="@color/secondary_text"
       android:textSize="11sp"/>

    <LinearLayout
       android:id="@+id/llAnalysisDeltaRows"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"/>
  </LinearLayout>

  <!-- The Cases tab includes this same table, so every id inside it exists twice under this
       activity. Look one up through the tab's own root (solveRoot / the Cases root), never through
       the activity: an unscoped findViewById would silently bind the other tab's table. -->
  <include
     android:id="@+id/llAnalysisStepTable"
     layout="@layout/case_table"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="14dp"/>

  <!-- Under the step table rather than above it: the table is what the tab is opened for, this is
       the occasional look. Its figures come from a second read of the window's solves. -->
  <LinearLayout
     android:id="@+id/llAnalysisAlgorithmsCard"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="20dp"
     android:background="@drawable/analysis_card"
     android:orientation="vertical"
     android:padding="14dp"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginBottom="8dp"
       android:gravity="bottom"
       android:orientation="horizontal">

      <TextView
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:letterSpacing="0.09"
         android:text="@string/analysis_algorithms_label"
         android:textAllCaps="true"
         android:textColor="@color/secondary_text"
         android:textSize="11sp"/>

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginLeft="8dp"
         android:gravity="right"
         android:letterSpacing="0.09"
         android:text="@string/analysis_algorithms_extra"
         android:textAllCaps="true"
         android:textColor="@color/secondary_text"
         android:textSize="11sp"/>
    </LinearLayout>

    <!-- Instead of the rows while the window is being replayed. The card takes its place under the
         table from the moment the tab draws: appearing later is how a reader misses it. -->
    <LinearLayout
       android:id="@+id/llAnalysisAlgorithmsReading"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:gravity="center_vertical"
       android:orientation="horizontal"
       android:paddingTop="6dp"
       android:paddingBottom="6dp"
       android:visibility="gone">

      <ProgressBar
         style="?android:attr/progressBarStyleSmall"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"/>

      <TextView
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_marginLeft="10dp"
         android:layout_weight="1"
         android:text="@string/analysis_algorithms_reading"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
       android:id="@+id/llAnalysisAlgorithmsRows"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"/>

    <com.cube.nanotimer.util.view.FlowLayout
       android:id="@+id/llAnalysisAlgorithmsKey"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"/>
  </LinearLayout>

  <!-- What there is to do about a screen full of somebody else's figures, at the foot of the tab
       that read them rather than over them: the reader is shown the whole thing first. -->
  <LinearLayout
     android:id="@+id/llAnalysisSampleCta"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="20dp"
     android:background="@drawable/analysis_lit_card"
     android:orientation="vertical"
     android:padding="14dp"
     android:visibility="gone">

    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fontFamily="@font/roboto_medium"
       android:text="@string/analysis_sample_cta_title"
       android:textColor="@color/white"
       android:textSize="15sp"/>

    <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:lineSpacingMultiplier="1.15"
       android:text="@string/analysis_sample_cta_body"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"/>

    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/buAnalysisSampleConnect"
       android:layout_marginTop="14dp"
       android:text="@string/analysis_sample_connect"
       style="@style/DialogActionButton"/>

    <!-- Quieter than the tonal button above it: staying is what the reader is already doing. -->
    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/buAnalysisSampleBrowse"
       android:layout_marginTop="8dp"
       android:background="@drawable/dialog_action_button_ghost"
       android:text="@string/analysis_sample_browse"
       style="@style/DialogActionButton"/>
  </LinearLayout>

</LinearLayout>
