<?xml version="1.0" encoding="utf-8"?>
<!-- The Analysis hub: three tabs over one solve type's window of solves.

     Two controls stand above the first figure and no more. What the screen is about is not a
     control, so the solve type and its method are the app bar's subtitle and the window is a chip on
     the same line; the tabs are the only strip. An earlier draft stacked five rows of chrome over
     the first number. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true"
   android:orientation="vertical">

  <!-- Whose figures these are, above the tabs and outside the scroll: it is a caveat on everything
       below it, so it may not be scrolled off the way a card at the top would be. -->
  <LinearLayout
     android:id="@+id/llAnalysisSampleBanner"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginLeft="16dp"
     android:layout_marginRight="16dp"
     android:layout_marginTop="10dp"
     android:background="@drawable/analysis_sample_banner"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:paddingLeft="11dp"
     android:paddingRight="11dp"
     android:paddingTop="8dp"
     android:paddingBottom="8dp"
     android:visibility="gone">

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:background="@drawable/analysis_sample_tag"
       android:letterSpacing="0.1"
       android:paddingLeft="7dp"
       android:paddingRight="7dp"
       android:paddingTop="2dp"
       android:paddingBottom="2dp"
       android:text="@string/analysis_sample_chip"
       android:textAllCaps="true"
       android:textColor="@color/graybg"
       android:textSize="10sp"
       android:textStyle="bold"/>

    <TextView
       android:id="@+id/tvAnalysisSampleBanner"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginLeft="8dp"
       android:layout_weight="1"
       android:lineSpacingMultiplier="1.15"
       android:textColor="@color/sample_ink"
       android:textSize="12sp"/>
  </LinearLayout>

  <LinearLayout
     android:id="@+id/llAnalysisTabs"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginLeft="16dp"
     android:layout_marginRight="16dp"
     android:layout_marginTop="10dp"
     android:background="@drawable/view_segment_group"
     android:orientation="horizontal"
     android:padding="3dp"/>

  <ScrollView
     android:id="@+id/svAnalysis"
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingTop="12dp"
       android:paddingBottom="16dp">

      <!-- Instead of a tab's contents, when the window holds nothing the tab can read. -->
      <TextView
         android:id="@+id/tvAnalysisEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="60dp"
         android:gravity="center"
         android:lineSpacingMultiplier="1.2"
         android:paddingLeft="16dp"
         android:paddingRight="16dp"
         android:text="@string/analysis_empty"
         android:textColor="@color/secondary_text"
         android:textSize="16sp"
         android:visibility="gone"/>

      <include layout="@layout/analysis_solve"/>

      <include layout="@layout/analysis_cases"/>

      <include layout="@layout/analysis_plan"/>

    </LinearLayout>
  </ScrollView>

</LinearLayout>
