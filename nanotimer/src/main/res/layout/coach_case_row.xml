<?xml version="1.0" encoding="utf-8"?>
<!-- One case a focus area names: its chart, its name, and the two lines that say why it is here.
     The figures are read off the payload rather than off the plan's own citations, so a claim that
     was invented has nothing to print. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:gravity="center_vertical"
   android:minHeight="48dp"
   android:orientation="horizontal"
   android:paddingTop="@dimen/space_xs"
   android:paddingBottom="@dimen/space_xs">

  <com.cube.nanotimer.gui.widget.LastLayerCaseView
     android:id="@+id/vCoachCaseChart"
     android:layout_width="38dp"
     android:layout_height="38dp"/>

  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginLeft="@dimen/space_m"
     android:orientation="vertical">

    <TextView
       android:id="@+id/tvCoachCaseName"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:ellipsize="end"
       android:fontFamily="@font/roboto_medium"
       android:maxLines="1"
       android:textColor="@color/white"
       android:textSize="15sp"/>

    <TextView
       android:id="@+id/tvCoachCaseFigures"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:fontFeatureSettings="tnum"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <TextView
       android:id="@+id/tvCoachCaseCost"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fontFeatureSettings="tnum"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>
  </LinearLayout>

</LinearLayout>
