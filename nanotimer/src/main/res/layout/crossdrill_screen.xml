<?xml version="1.0" encoding="utf-8"?>
<!-- A cross drill. Same shape as the case drill screen and the same ids for the pieces
     DrillScreenActivity owns, because a drill screen is a drill screen: a cube that follows the
     grip, a line for the rep just finished, and no control that starts or stops a rep.

     What is different is what the cube is showing. It opens with only the four cross edges and the
     six centres in colour, and goes grey on the user's first turn, so the cross is executed from
     what they read rather than from what they can see. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <LinearLayout
     android:id="@+id/drillRunning"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:padding="12dp">

    <!-- Only for a cube whose grip cannot be read (no gyro, or no reference yet). -->
    <TextView
       android:id="@+id/tvDrillGrip"
       android:visibility="gone"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:background="@drawable/smart_cube_pill"
       android:backgroundTint="@color/white_wash_10"
       android:paddingLeft="12dp"
       android:paddingRight="12dp"
       android:paddingTop="4dp"
       android:paddingBottom="4dp"
       android:text="@string/drill_grip_hint"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:layout_marginTop="10dp"
       android:background="@drawable/cube_stage">

      <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so
           the player would build into a 0x0 viewport and stay that size once shown. -->
      <WebView
         android:id="@+id/wvDrillCube"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@android:color/transparent"
         android:visibility="invisible"/>

      <ProgressBar
         android:id="@+id/pbDrillCube"
         style="?android:attr/progressBarStyle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"/>

      <View
         android:id="@+id/drillRepWash"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@color/green_soft"
         android:visibility="gone"/>
    </FrameLayout>

    <!-- What is happening now: the planning left, the moves spent, or that what is on the cube is
         not a cross. Never what the cross is; that is the whole question. -->
    <TextView
       android:id="@+id/tvDrillCrossStatus"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:minHeight="22dp"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="14sp"
       android:fontFeatureSettings="tnum"/>

    <!-- ⚠️ The rep just FINISHED: how many moves it took against how few it could have. -->
    <TextView
       android:id="@+id/tvDrillLastRep"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:minHeight="26dp"
       android:gravity="center"
       android:textColor="@color/white"
       android:textSize="17sp"
       android:fontFeatureSettings="tnum"/>

    <!-- Two rows rather than one: "Shortest ways" is a wide button, and a phone narrow enough to
         squeeze it against the rep counter would squeeze the counter to nothing. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillProgress"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"
         android:fontFeatureSettings="tnum"/>

      <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
      <TextView
         android:id="@+id/tvDrillMode"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="3dp"
         android:paddingBottom="3dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="8dp"
       android:gravity="end"
       android:orientation="horizontal">

      <!-- Only once a rep is over: during one it would be the answer. -->
      <Button
         android:id="@+id/btDrillCrossSolutions"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginRight="6dp"
         android:text="@string/drill_cross_solutions"
         android:visibility="gone"/>

      <!-- Announcing the cross is finished, and then taking the next one. Not a start or a stop:
           a cross that is really built ends its own rep, and this is the only end a wrong one has. -->
      <Button
         android:id="@+id/btDrillCrossDone"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:text="@string/drill_cross_done"/>
    </LinearLayout>

  </LinearLayout>

  <ScrollView
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/color_primary"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:gravity="center_horizontal"
       android:padding="24dp">

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:text="@string/drill_finished"
         android:textColor="@color/white"
         android:textSize="24sp"
         android:textStyle="bold"/>

      <TextView
         android:id="@+id/tvDrillSummaryReps"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillSummaryMean"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:textColor="@color/white"
         android:textSize="20sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillSummaryOptimal"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillSummaryPlanning"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="24dp"
         android:gravity="center"
         android:text="@string/drill_cube_left_scrambled"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"/>

      <Button
         android:id="@+id/btDrillDone"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="24dp"
         android:text="@string/drill_done"/>

    </LinearLayout>
  </ScrollView>

  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/color_primary"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
