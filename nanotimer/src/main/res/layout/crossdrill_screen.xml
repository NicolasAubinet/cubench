<?xml version="1.0" encoding="utf-8"?>
<!-- A cross drill. Same shape as the case drill screen and the same ids for the pieces
     DrillScreenActivity owns, because a drill screen is a drill screen: a cube that follows the
     grip, a line for the rep just finished, and no control that starts or stops a rep.

     What is different is what the cube is showing. It opens with only the four cross edges and the
     six centres in colour, and goes grey on the user's first turn, so the cross is executed from
     what they read rather than from what they can see. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:fitsSystemWindows="true"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <LinearLayout
     android:id="@+id/drillRunning"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:padding="12dp">

    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:layout_marginTop="10dp"
       android:background="@drawable/cube_stage">

      <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so
           the player would build into a 0x0 viewport and stay that size once shown. -->
      <WebView
         android:id="@+id/wvDrillCube"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@android:color/transparent"
         android:visibility="invisible"/>

      <ProgressBar
         android:id="@+id/pbDrillCube"
         style="?android:attr/progressBarStyle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"/>

      <View
         android:id="@+id/drillRepWash"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@drawable/drill_rep_wash"
         android:visibility="gone"/>
    </FrameLayout>

    <!-- What is happening now: the planning left, the moves spent, or that what is on the cube is
         not a cross. Never what the cross is; that is the whole question. A pill, so it reads as a
         state the drill is in rather than as a caption for the cube above it; the minimum height on
         the frame is what stops the cube moving as the line grows and shrinks. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:minHeight="48dp">

      <TextView
         android:id="@+id/tvDrillCrossStatus"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="14dp"
         android:paddingRight="14dp"
         android:paddingTop="5dp"
         android:paddingBottom="5dp"
         android:gravity="center"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"
         android:lineSpacingExtra="2dp"
         android:fontFeatureSettings="tnum"/>
    </FrameLayout>

    <!-- ⚠️ The rep just FINISHED: how many moves it took, and how few it could have. Two pieces
         rather than one sentence, so the move count is the thing the eye lands on. A minimum
         height rather than a fixed one: the row must not change height as reps come and go, or the
         cube above it jumps, but at a large system font it has to be allowed to grow.

         The name slot the case drill uses stays empty here: a scramble has no name to give. -->
    <LinearLayout
       android:id="@+id/llDrillLastRep"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:minHeight="46dp"
       android:gravity="center"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillLastRepName"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginRight="8dp"
         android:letterSpacing="0.02"
         android:fontFamily="@font/roboto_medium"
         android:textSize="13sp"/>

      <TextView
         android:id="@+id/tvDrillLastRep"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:textColor="@color/white"
         android:fontFamily="@font/roboto_medium"
         android:textSize="24sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillLastRepSplit"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginLeft="8dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"
         android:fontFeatureSettings="tnum"/>
    </LinearLayout>

    <!-- On its own line above the controls: sharing one with a button would squeeze the rep
         counter to nothing on a narrow phone, and which rep this is is not the thing to drop. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillProgress"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"
         android:fontFeatureSettings="tnum"/>

      <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
      <TextView
         android:id="@+id/tvDrillMode"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="3dp"
         android:paddingBottom="3dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>

    <!-- Not tappable, so it is not a control: a drill has a known end, and until now it said so in
         words only. -->
    <ProgressBar
       android:id="@+id/pbDrillProgress"
       style="?android:attr/progressBarStyleHorizontal"
       android:layout_width="match_parent"
       android:layout_height="3dp"
       android:layout_marginTop="8dp"
       android:progressDrawable="@drawable/drill_progress"/>

    <!-- ⚠️ Two rows, not three buttons in one. "Position de départ" needs about 130dp against the
         108 a third of the row gives it, so one row cannot hold these labels in four languages
         whatever style they carry. The two extras only exist between reps and appear together, so
         they share a row; the button that takes the next cross keeps the full width under them.
         Weights within the row, so a label that grows cannot push its neighbour off the edge. -->
    <LinearLayout
       android:id="@+id/llDrillCrossExtras"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="8dp"
       android:orientation="horizontal"
       android:visibility="gone">

      <!-- Rewinds the cube to the scramble as dealt, so the short way can be turned on it and
           watched. Between reps only. -->
      <Button
         android:id="@+id/btDrillCrossStart"
         style="@style/DialogActionButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         app:autoSizeTextType="uniform"
         app:autoSizeMinTextSize="12sp"
         app:autoSizeMaxTextSize="15sp"
         android:text="@string/drill_cross_start_position"
         android:visibility="gone"/>

      <!-- Only when there is more than one way in the same number of moves, and only once the rep
           is over: during one it would be the answer. -->
      <Button
         android:id="@+id/btDrillCrossSolutions"
         style="@style/DialogActionButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         app:autoSizeTextType="uniform"
         app:autoSizeMinTextSize="12sp"
         app:autoSizeMaxTextSize="15sp"
         android:text="@string/drill_cross_other_ways"
         android:visibility="gone"/>
    </LinearLayout>

    <!-- Announcing the cross is finished, and then taking the next one. Not a start or a stop:
         a cross that is really built ends its own rep, and this is the only end a wrong one has. -->
    <Button
       android:id="@+id/btDrillCrossDone"
       style="@style/DialogActionButton"
       android:layout_height="48dp"
       android:layout_marginTop="8dp"
       android:textSize="16sp"
       android:text="@string/drill_cross_done"/>

  </LinearLayout>

  <!-- What the drill leaves behind: four figures, the warning that the cube is scrambled, and the
       way out under the thumb. On the app's own ground and its own cells, like every other screen
       that reports numbers. -->
  <ScrollView
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:fillViewport="true"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingTop="6dp"
       android:paddingBottom="16dp">

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="@string/drill_finished"
         android:textColor="@color/white"
         android:textSize="26sp"
         android:fontFamily="@font/roboto_medium"
         android:textStyle="normal"/>

      <!-- What was drilled and in which mode, since the drill is over and its own bar is gone. -->
      <TextView
         android:id="@+id/tvDrillSummarySubtitle"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="2dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>

      <!-- match_parent on the cells, so the tallest sets the height and the row never goes ragged. -->
      <LinearLayout
         android:id="@+id/llDrillSummaryCells"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="14dp"
         android:baselineAligned="false"
         android:orientation="horizontal">

        <LinearLayout
           android:id="@+id/llDrillCellOne"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1"
           android:layout_marginRight="3dp"
           android:orientation="vertical"
           android:background="@drawable/drill_stat_cell"
           android:paddingLeft="6dp"
           android:paddingRight="6dp"
           android:paddingTop="8dp"
           android:paddingBottom="8dp">
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellKeyOne" style="@style/HeroStatKey"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellValueOne" style="@style/HeroStatValue"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellSubOne" style="@style/HeroStatSub"/>
        </LinearLayout>

        <LinearLayout
           android:id="@+id/llDrillCellTwo"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1"
           android:layout_marginLeft="3dp"
           android:layout_marginRight="3dp"
           android:orientation="vertical"
           android:background="@drawable/drill_stat_cell"
           android:paddingLeft="6dp"
           android:paddingRight="6dp"
           android:paddingTop="8dp"
           android:paddingBottom="8dp">
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellKeyTwo" style="@style/HeroStatKey"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellValueTwo" style="@style/HeroStatValue"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellSubTwo" style="@style/HeroStatSub"/>
        </LinearLayout>

        <LinearLayout
           android:id="@+id/llDrillCellThree"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1"
           android:layout_marginLeft="3dp"
           android:orientation="vertical"
           android:background="@drawable/drill_stat_cell"
           android:paddingLeft="6dp"
           android:paddingRight="6dp"
           android:paddingTop="8dp"
           android:paddingBottom="8dp">
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellKeyThree" style="@style/HeroStatKey"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellValueThree" style="@style/HeroStatValue"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellSubThree" style="@style/HeroStatSub"/>
        </LinearLayout>
      </LinearLayout>

      <!-- The figure that has no cell of its own: the half the drill was not scored on. -->
      <TextView
         android:id="@+id/tvDrillSummaryExtra"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"
         android:fontFeatureSettings="tnum"/>

      <!-- Instead of the cells, for a drill with nothing to average. -->
      <TextView
         android:id="@+id/tvDrillSummaryEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="20dp"
         android:textColor="@color/white"
         android:textSize="17sp"
         android:visibility="gone"/>

      <View
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="1"
         android:minHeight="8dp"/>

      <!-- The sheet's own action, in the accent the main screen's Start wears. The case drill's
           summary says it the same way. -->
      <androidx.appcompat.widget.AppCompatButton
         android:id="@+id/btDrillDone"
         style="@style/HeroStartButton"
         android:layout_marginTop="16dp"
         android:text="@string/drill_done"/>

    </LinearLayout>
  </ScrollView>

  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
