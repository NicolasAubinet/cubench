<?xml version="1.0" encoding="utf-8"?>
<!-- A cross drill. Same shape as the case drill screen and the same ids for the pieces
     DrillScreenActivity owns, because a drill screen is a drill screen: a cube that follows the
     grip, a line for the rep just finished, and no control that starts or stops a rep.

     What is different is what the cube is showing. It opens with only the four cross edges and the
     six centres in colour, and goes grey on the user's first turn, so the cross is executed from
     what they read rather than from what they can see. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:fitsSystemWindows="true"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <include layout="@layout/crossdrill_running"/>

  <!-- What the drill leaves behind: the card, then each rep's cross against the shortest one. Done
       stays outside the scroll, as on the case drill's summary. -->
  <LinearLayout
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:orientation="vertical"
     android:visibility="gone">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="@dimen/space_m"
       android:paddingRight="@dimen/space_m"
       android:paddingTop="@dimen/space_xs"
       android:paddingBottom="@dimen/space_l">

      <include layout="@layout/drill_summary_card"/>

      <LinearLayout
         android:id="@+id/llDrillCrossReps"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="18dp"
         android:orientation="vertical"
         android:visibility="gone">

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:paddingLeft="@dimen/space_xs"
           android:paddingRight="@dimen/space_xs"
           android:paddingBottom="8dp"
           android:orientation="horizontal">

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="@dimen/drill_case_position_column"
             android:text="@string/drill_summary_column_position"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:text="@string/drill_cross_column_moves"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="@dimen/drill_cross_planning_column"
             android:gravity="end"
             android:text="@string/drill_summary_cell_planning"/>
        </LinearLayout>

        <View
           android:layout_width="match_parent"
           android:layout_height="1dp"
           android:background="@color/hero_divider"/>

        <LinearLayout
           android:id="@+id/llDrillCrossRepRows"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:divider="@drawable/stat_rule_h"
           android:orientation="vertical"
           android:showDividers="middle"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>

    <include layout="@layout/drill_summary_actions"/>

  </LinearLayout>

  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
