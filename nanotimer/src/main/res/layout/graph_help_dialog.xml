<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="8dp"
   android:paddingBottom="14dp"
   android:minWidth="300dp">

  <!-- The grip: what says the sheet can be dragged back down to close it. -->
  <View
     android:layout_width="32dp"
     android:layout_height="4dp"
     android:layout_gravity="center_horizontal"
     android:background="@drawable/bottomsheet_drag_handle"/>

  <!-- The graph screen is landscape only, so the three sit side by side: stacked they ran off the
       bottom of a sheet that had width to spare. The scroll and its fade are the safety net. -->
  <androidx.core.widget.NestedScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginTop="12dp"
     android:requiresFadingEdge="vertical"
     android:fadingEdgeLength="28dp">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical">

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="@string/graph_help_title"
         android:textColor="@color/white"
         android:textSize="20sp"
         android:textStyle="bold"/>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:text="@string/graph_help_body"
         android:textColor="@color/secondary_text"
         android:textSize="13.5sp"/>

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="horizontal"
         android:baselineAligned="false"
         android:layout_marginTop="18dp">

        <LinearLayout
           style="@style/GraphHelpColumn"
           android:layout_marginEnd="14dp"
           android:layout_marginRight="14dp">
          <ImageView
             style="@style/GraphHelpIcon"
             android:src="@drawable/ic_graph_progression"/>
          <TextView
             style="@style/GraphHelpName"
             android:text="@string/chart_type_progression"/>
          <TextView
             style="@style/GraphHelpText"
             android:text="@string/graph_help_progression"/>
        </LinearLayout>

        <LinearLayout
           style="@style/GraphHelpColumn"
           android:layout_marginEnd="14dp"
           android:layout_marginRight="14dp">
          <ImageView
             style="@style/GraphHelpIcon"
             android:src="@drawable/ic_graph_frequency"/>
          <TextView
             style="@style/GraphHelpName"
             android:text="@string/chart_type_frequency"/>
          <TextView
             style="@style/GraphHelpText"
             android:text="@string/graph_help_frequency"/>
        </LinearLayout>

        <LinearLayout style="@style/GraphHelpColumn">
          <ImageView
             style="@style/GraphHelpIcon"
             android:src="@drawable/ic_graph_distribution"/>
          <TextView
             style="@style/GraphHelpName"
             android:text="@string/chart_type_distribution"/>
          <TextView
             style="@style/GraphHelpText"
             android:text="@string/graph_help_distribution"/>
        </LinearLayout>

      </LinearLayout>

    </LinearLayout>

  </androidx.core.widget.NestedScrollView>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buGraphHelpDone"
     android:layout_width="match_parent"
     android:layout_marginTop="18dp"
     android:text="@string/close"
     style="@style/DialogActionButton"/>

</LinearLayout>
