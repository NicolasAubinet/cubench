<?xml version="1.0" encoding="utf-8"?>
<!-- One thing to work on: what kind of problem it is, the cases or the sentence that says so, and
     something to practise it with when there is anything to practise. The button is inside the card
     rather than under the plan, because a drill belongs to the area that prescribed it. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="@dimen/space_m"
   app:cardBackgroundColor="@color/hero_card"
   app:cardCornerRadius="@dimen/card_corner"
   app:cardElevation="@dimen/mainscreen_card_elevation">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:padding="@dimen/space_m">

    <TextView
       android:id="@+id/tvCoachAreaTitle"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/white"
       android:textSize="16sp"
       app:fontFamily="@font/roboto_medium"/>

    <!-- What a coach said about it. A plan written on the device carries none, and says what it
         means with the figures under it instead. -->
    <TextView
       android:id="@+id/tvCoachAreaText"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/space_xs"
       android:textColor="@color/secondary_text"
       android:textSize="14sp"
       android:visibility="gone"/>

    <!-- One coach_case_row per case, or nothing at all for an area that is an observation. -->
    <LinearLayout
       android:id="@+id/llCoachAreaCases"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="@dimen/space_xs"
       android:orientation="vertical"/>

    <Button
       android:id="@+id/buCoachAreaDrill"
       style="@style/DialogActionButton"
       android:layout_marginTop="@dimen/space_s"
       android:visibility="gone"/>

  </LinearLayout>

</androidx.cardview.widget.CardView>
