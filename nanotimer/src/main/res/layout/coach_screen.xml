<?xml version="1.0" encoding="utf-8"?>
<!-- What to work on this week, and what it was read from. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true"
   android:orientation="vertical">

  <!-- Whose history this is. The same line the graph screen opens with, since it answers the same
       first question. -->
  <androidx.cardview.widget.CardView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="@dimen/space_xs"
     android:layout_marginLeft="@dimen/space_m"
     android:layout_marginRight="@dimen/space_m"
     app:cardBackgroundColor="@color/hero_card"
     app:cardCornerRadius="@dimen/card_corner"
     app:cardElevation="@dimen/mainscreen_card_elevation">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="@dimen/space_m"
       android:paddingRight="@dimen/space_m"
       android:paddingTop="@dimen/space_s"
       android:paddingBottom="@dimen/space_s">

      <TextView
         android:id="@+id/tvCoachSolveType"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:ellipsize="end"
         android:maxLines="1"
         android:textColor="@color/white"
         android:textSize="16sp"
         android:textStyle="bold"/>

      <TextView
         android:id="@+id/tvCoachWritten"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="2dp"
         android:visibility="gone"
         android:ellipsize="end"
         android:maxLines="1"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <ScrollView
     android:id="@+id/svCoach"
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="@dimen/space_m"
       android:paddingRight="@dimen/space_m"
       android:paddingBottom="@dimen/space_m">

      <!-- A plan claiming figures the payload does not hold. Nothing the device writes can say this;
           it is here for the plans that arrive from somewhere else. -->
      <TextView
         android:id="@+id/tvCoachUncited"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="@dimen/space_m"
         android:textColor="@color/warning"
         android:textSize="13sp"
         android:visibility="gone"/>

      <!-- Instead of the areas: never read, or read and there was nothing thick enough to say. -->
      <LinearLayout
         android:id="@+id/llCoachEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="60dp"
         android:orientation="vertical"
         android:paddingLeft="@dimen/space_m"
         android:paddingRight="@dimen/space_m"
         android:visibility="gone">

        <TextView
           android:id="@+id/tvCoachEmptyTitle"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center"
           android:textColor="@color/white"
           android:textSize="17sp"
           android:textStyle="bold"/>

        <TextView
           android:id="@+id/tvCoachEmpty"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="@dimen/space_s"
           android:gravity="center"
           android:textColor="@color/secondary_text"
           android:textSize="14sp"/>
      </LinearLayout>

      <!-- One coach_focus_area per thing to work on, worst first, filled in code. -->
      <LinearLayout
         android:id="@+id/llCoachAreas"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"/>

      <!-- Why a thin plan is thin. Without it, a screen with one area on it reads as broken rather
           than as a history that cannot yet answer. -->
      <LinearLayout
         android:id="@+id/llCoachBasis"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="@dimen/space_l"
         android:orientation="vertical"
         android:visibility="gone">

        <TextView
           style="@style/DialogSectionLabel"
           android:layout_marginLeft="@dimen/space_xs"
           android:text="@string/coach_basis_title"/>

        <View
           android:layout_width="match_parent"
           android:layout_height="1dp"
           android:layout_marginTop="@dimen/space_xs"
           android:background="@color/hero_divider"/>

        <LinearLayout
           android:id="@+id/llCoachBasisRows"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:divider="@drawable/stat_rule_h"
           android:orientation="vertical"
           android:showDividers="middle"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="@dimen/space_s"
           android:layout_marginLeft="@dimen/space_xs"
           android:text="@string/coach_basis_hint"
           android:textColor="@color/secondary_text"
           android:textSize="12sp"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>

</LinearLayout>
