<?xml version="1.0" encoding="utf-8"?>
<!-- The card over a list of times: a finished drill's card, with the case it is about on top when
     there is one. Painted in code in the family's colour; see CaseListHero. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/llCaseListHero"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical">

  <!-- Opens the case's sheet. -->
  <LinearLayout
     android:id="@+id/llCaseListHead"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:background="?android:attr/selectableItemBackground"
     android:clickable="true"
     android:focusable="true"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:paddingLeft="14dp"
     android:paddingTop="12dp"
     android:paddingRight="10dp"
     android:visibility="gone">

    <com.cube.nanotimer.gui.widget.LastLayerCaseView
       android:id="@+id/vCaseListChart"
       android:layout_width="52dp"
       android:layout_height="52dp"/>

    <com.cube.nanotimer.gui.widget.PairCaseView
       android:id="@+id/vCaseListPair"
       android:layout_width="52dp"
       android:layout_height="52dp"
       android:visibility="gone"/>

    <LinearLayout
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:layout_marginLeft="12dp"
       android:orientation="vertical">

      <TextView
         android:id="@+id/tvCaseListEyebrow"
         style="@style/DrillSummaryEyebrow"
         android:layout_width="match_parent"
         android:maxLines="1"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvCaseListName"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:ellipsize="end"
         android:fontFamily="@font/roboto_medium"
         android:maxLines="1"
         android:textColor="@color/white"
         android:textSize="20sp"/>

      <TextView
         android:id="@+id/tvCaseListSub"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:ellipsize="end"
         android:maxLines="1"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>
    </LinearLayout>

    <ImageView
       android:layout_width="20dp"
       android:layout_height="20dp"
       android:layout_marginLeft="@dimen/space_xs"
       android:contentDescription="@null"
       android:src="@drawable/ic_chevron_right"/>
  </LinearLayout>

  <include layout="@layout/drill_summary_card"/>
</LinearLayout>
