<?xml version="1.0" encoding="utf-8"?>
<!-- The card that closes the Plan tab: the stars, an optional word, and Send. Once sent it shrinks
     to the stars given, and a tap opens it again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginTop="@dimen/space_m"
   android:background="@drawable/analysis_card"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="14dp"
   android:paddingBottom="16dp">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:gravity="center_vertical"
     android:orientation="horizontal">

    <TextView
       android:id="@+id/tvFbRateTitle"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:fontFamily="@font/roboto"
       android:textColor="@color/white"
       android:textSize="17sp"
       android:textStyle="bold"/>

    <!-- Only on the sent card, which a tap anywhere opens again; this says so. -->
    <TextView
       android:id="@+id/tvFbRateEdit"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginStart="10dp"
       android:layout_marginLeft="10dp"
       android:drawablePadding="5dp"
       android:fontFamily="@font/roboto_medium"
       android:gravity="center_vertical"
       android:text="@string/coach_fb_edit"
       android:textColor="#FFFFD27A"
       android:textSize="14sp"
       android:visibility="gone"/>
  </LinearLayout>

  <TextView
     android:id="@+id/tvFbRateSub"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="2dp"
     android:textColor="@color/secondary_text"
     android:textSize="13sp"/>

  <LinearLayout
     android:id="@+id/llFbStars"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="10dp"
     android:gravity="center"
     android:orientation="horizontal"/>

  <EditText
     android:id="@+id/etFbText"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="10dp"
     android:background="@drawable/coach_purchase_field"
     android:hint="@string/coach_fb_anything_else"
     android:inputType="textCapSentences|textMultiLine"
     android:maxLength="2000"
     android:padding="10dp"
     android:textColor="@color/white"
     android:textColorHint="@color/secondary_text"
     android:textSize="13.5sp"/>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buFbSend"
     style="@style/AccentActionButton"
     android:layout_marginTop="12dp"
     android:text="@string/coach_fb_send"/>
</LinearLayout>
