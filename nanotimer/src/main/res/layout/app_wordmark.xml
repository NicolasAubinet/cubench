<?xml version="1.0" encoding="utf-8"?>

<!-- The logotype, in the slot every other screen puts a title in. It sits on the launcher screen
     only: the app wears its face where you open it, and nowhere else.

     Sized in dp, not sp: this is a mark rather than something to read, and two lines of it grown by
     a large font setting are cut off by the bottom of a bar whose height is fixed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="wrap_content"
   android:layout_height="wrap_content"
   android:layout_gravity="center_vertical"
   android:orientation="vertical">

  <TextView
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:text="@string/wordmark"
     android:textSize="15dp"
     android:textStyle="bold"
     android:letterSpacing="0.16"
     android:textColor="@color/white"/>

  <TextView
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginTop="1dp"
     android:text="@string/wordmark_tagline"
     android:textSize="8dp"
     android:letterSpacing="0.3"
     android:textColor="@color/color_accent"/>

</LinearLayout>
