<?xml version="1.0" encoding="utf-8"?>
<!-- Which cases cost you, one step at a time: the step's cases this window holds figures for,
     ranked by what they cost, and under them the rest of its set.

     One step at a time because a case is only comparable to the cases of its own step. An OLL and a
     PLL cost their time in different amounts and come up at different rates, so a single ranking of
     the two answered "which of these is dearest" with a fact about which set is bigger. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/llAnalysisCases"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical">

  <!-- How far through the set you are. A ring rather than a bar because this is progress through a
       fixed set, not the composition of a duration: it is the one figure here with a "complete". -->
  <LinearLayout
     android:id="@+id/llAnalysisKnowledgeCard"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:background="@drawable/analysis_card"
     android:baselineAligned="false"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:padding="14dp">

    <FrameLayout
       android:layout_width="84dp"
       android:layout_height="84dp">

      <com.cube.nanotimer.util.view.KnowledgeRingView
         android:id="@+id/vAnalysisKnowledgeRing"
         android:layout_width="match_parent"
         android:layout_height="match_parent"/>

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:gravity="center"
         android:orientation="vertical">

        <TextView
           android:id="@+id/tvAnalysisKnowledgeKnown"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:fontFamily="@font/roboto_medium"
           android:fontFeatureSettings="tnum"
           android:includeFontPadding="false"
           android:textColor="@color/white"
           android:textSize="20sp"/>

        <TextView
           android:id="@+id/tvAnalysisKnowledgeOf"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginTop="2dp"
           android:fontFeatureSettings="tnum"
           android:textColor="@color/secondary_text"
           android:textSize="10sp"/>
      </LinearLayout>
    </FrameLayout>

    <LinearLayout
       android:id="@+id/llAnalysisKnowledgeKeys"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginLeft="14dp"
       android:layout_weight="1"
       android:orientation="vertical"/>
  </LinearLayout>

  <!-- Which step, said as the segmented control every other toggle in the app uses: one of them is
       always on, so this is a switch between them rather than a set of filters to be turned off. -->
  <HorizontalScrollView
     android:id="@+id/svAnalysisFamilies"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="12dp"
     android:scrollbars="none">

    <LinearLayout
       android:id="@+id/llAnalysisFamilyRow"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <LinearLayout
         android:id="@+id/llAnalysisFamilies"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginRight="@dimen/space_s"
         android:background="@drawable/view_segment_group"
         android:orientation="horizontal"
         android:padding="3dp"/>
    </LinearLayout>
  </HorizontalScrollView>

  <!-- The Solve tab includes this same table: see the note there. Ids inside are looked up
       through this tab's own root, never through the activity. -->
  <include
     android:id="@+id/llAnalysisCaseTable"
     layout="@layout/case_table"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="16dp"/>

  <!-- The rest of the step's set: the cases this window holds no figures for, under where each of
       them stands. No columns, because there is nothing to put in them, and no label of its own over
       the group headings, which already say what they are. What the section is read over, which is
       every solve rather than the window the table above uses, is said on the help sheet. -->
  <LinearLayout
     android:id="@+id/llAnalysisRestGroups"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="10dp"
     android:orientation="vertical"/>

  <TextView
     android:id="@+id/tvAnalysisCasesEmpty"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="40dp"
     android:gravity="center"
     android:lineSpacingMultiplier="1.2"
     android:paddingLeft="16dp"
     android:paddingRight="16dp"
     android:textColor="@color/secondary_text"
     android:textSize="15sp"
     android:visibility="gone"/>

</LinearLayout>
