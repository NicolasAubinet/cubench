<?xml version="1.0" encoding="utf-8"?>
<!-- Where the coach is bought, risen over the Plan tab: the two base plans as tiles at the prices
     Play lists for this buyer, and what subscribing sends, which is all the agreeing there is. The
     button stays in reach while the rest scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:background="@drawable/coach_purchase_sheet_bg"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="8dp"
   android:paddingBottom="14dp"
   android:minWidth="300dp">

  <!-- The grip: what says the sheet can be dragged back down to close it. -->
  <View
     android:layout_width="32dp"
     android:layout_height="4dp"
     android:layout_gravity="center_horizontal"
     android:background="@drawable/bottomsheet_drag_handle"/>

  <androidx.core.widget.NestedScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginTop="10dp"
     android:requiresFadingEdge="vertical"
     android:fadingEdgeLength="28dp">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical">

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <ImageView
           android:layout_width="44dp"
           android:layout_height="44dp"
           android:background="@drawable/coach_hero_icon_tile"
           android:importantForAccessibility="no"
           android:padding="10dp"
           android:src="@drawable/ic_coach_target"/>

        <LinearLayout
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_marginLeft="12dp"
           android:layout_marginStart="12dp"
           android:layout_weight="1"
           android:orientation="vertical">

          <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:fontFamily="@font/roboto"
             android:text="@string/analysis_plan_headline"
             android:textColor="@color/white"
             android:textSize="20sp"
             android:textStyle="bold"/>

          <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="1dp"
             android:text="@string/coach_purchase_sub"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"/>
        </LinearLayout>
      </LinearLayout>

      <!-- The tiles, side by side. Their badges stand above them, so nothing may clip. -->
      <LinearLayout
         android:id="@+id/llCoachPurchasePlans"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:clipChildren="false"
         android:clipToPadding="false"
         android:orientation="horizontal"/>

      <!-- While the coach is in beta: one tile in place of the prices, "Free", with no price
           anywhere, and the weekly loop that makes rating a step of the week. A full beta keeps
           the tile and says so, with nothing to buy. -->
      <FrameLayout
         android:id="@+id/flCoachBetaTile"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:clipChildren="false"
         android:visibility="gone">

        <LinearLayout
           android:id="@+id/llCoachBetaTile"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp"
           android:background="@drawable/coach_purchase_plan"
           android:gravity="center_horizontal"
           android:orientation="vertical"
           android:paddingLeft="12dp"
           android:paddingRight="12dp"
           android:paddingTop="18dp"
           android:paddingBottom="14dp">

          <TextView
             android:id="@+id/tvCoachBetaTileTitle"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:fontFamily="@font/roboto"
             android:gravity="center"
             android:textColor="@color/white"
             android:textSize="30sp"
             android:textStyle="bold"/>

          <TextView
             android:id="@+id/tvCoachBetaTileSub"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="2dp"
             android:gravity="center"
             android:lineSpacingMultiplier="1.15"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"/>

          <TextView
             android:id="@+id/tvCoachBetaTileNothing"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="2dp"
             android:gravity="center"
             android:text="@string/coach_beta_free_nothing"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"/>
        </LinearLayout>

        <TextView
           android:id="@+id/tvCoachBetaBadge"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_gravity="top|center_horizontal"
           android:background="@drawable/coach_purchase_badge"
           android:fontFamily="@font/roboto_medium"
           android:letterSpacing="0.1"
           android:paddingLeft="9dp"
           android:paddingRight="9dp"
           android:paddingTop="2dp"
           android:paddingBottom="2dp"
           android:text="@string/coach_beta_tag"
           android:textAllCaps="true"
           android:textColor="@color/coach_purchase_badge_text"
           android:textSize="11sp"/>
      </FrameLayout>

      <!-- Get your plan, practise, rate it, next plan: the rating is the step that is lit. -->
      <LinearLayout
         android:id="@+id/llCoachBetaLoop"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:background="@drawable/coach_beta_loop_bg"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingLeft="6dp"
         android:paddingRight="6dp"
         android:paddingTop="10dp"
         android:paddingBottom="10dp"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvCoachBetaLoopNote"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="8dp"
         android:gravity="center"
         android:lineSpacingMultiplier="1.2"
         android:text="@string/coach_beta_loop_note"
         android:textColor="@color/white"
         android:textSize="12.5sp"
         android:visibility="gone"/>

      <!-- A full beta: what stays free meanwhile. Takes the place of "How it works". -->
      <LinearLayout
         android:id="@+id/llCoachBetaMeanwhile"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:background="@drawable/coach_purchase_card"
         android:orientation="vertical"
         android:padding="14dp"
         android:visibility="gone">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:fontFamily="@font/roboto_medium"
           android:letterSpacing="0.08"
           android:text="@string/coach_beta_meanwhile_label"
           android:textAllCaps="true"
           android:textColor="@color/secondary_text"
           android:textSize="11.5sp"/>

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="6dp"
           android:alpha="0.85"
           android:lineSpacingMultiplier="1.2"
           android:text="@string/coach_beta_meanwhile"
           android:textColor="@color/white"
           android:textSize="12.5sp"/>
      </LinearLayout>

      <!-- While Play is asked for the prices. -->
      <ProgressBar
         android:id="@+id/pbCoachPurchase"
         style="?android:attr/progressBarStyleSmall"
         android:layout_width="20dp"
         android:layout_height="20dp"
         android:layout_gravity="center_horizontal"
         android:layout_marginTop="20dp"
         android:layout_marginBottom="12dp"/>

      <TextView
         android:id="@+id/tvCoachPurchaseUnavailable"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:lineSpacingMultiplier="1.2"
         android:text="@string/coach_purchase_unavailable"
         android:textColor="@color/sample_ink"
         android:textSize="13.5sp"
         android:visibility="gone"/>

      <!-- The picked plan's free weeks. Gone when it starts paid. -->
      <TextView
         android:id="@+id/tvCoachPurchaseFree"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:background="@drawable/coach_win_line"
         android:drawableLeft="@drawable/ic_coach_gift"
         android:drawableStart="@drawable/ic_coach_gift"
         android:drawablePadding="10dp"
         android:gravity="center_vertical"
         android:paddingLeft="12dp"
         android:paddingRight="12dp"
         android:paddingTop="10dp"
         android:paddingBottom="10dp"
         android:textColor="@color/green_soft"
         android:textSize="14sp"
         android:visibility="gone"/>

      <LinearLayout
         android:id="@+id/llCoachPurchaseHow"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"
         android:background="@drawable/coach_purchase_card"
         android:orientation="vertical"
         android:padding="14dp">

        <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:fontFamily="@font/roboto_medium"
           android:letterSpacing="0.08"
           android:textAllCaps="true"
           android:textColor="@color/secondary_text"
           android:textSize="11.5sp"
           android:text="@string/coach_sends_label"/>

        <!-- Opens the choice only when more than one solve type can carry the plans. -->
        <LinearLayout
           android:id="@+id/llCoachPurchaseType"
           android:layout_width="match_parent"
           android:layout_height="44dp"
           android:layout_marginTop="8dp"
           android:background="@drawable/coach_purchase_field"
           android:gravity="center_vertical"
           android:orientation="horizontal"
           android:paddingLeft="12dp"
           android:paddingRight="12dp"
           android:visibility="gone">

          <TextView
             android:layout_width="0dp"
             android:layout_height="wrap_content"
             android:layout_weight="1"
             android:text="@string/coach_plans_for"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"/>

          <TextView
             android:id="@+id/tvCoachPurchaseType"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:fontFamily="@font/roboto_medium"
             android:textColor="@color/lightblue"
             android:textSize="15sp"/>
        </LinearLayout>

        <TextView
           android:id="@+id/tvCoachPurchaseSends"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="6dp"
           android:alpha="0.85"
           android:lineSpacingMultiplier="1.2"
           android:textColor="@color/white"
           android:textSize="12.5sp"/>

        <TextView
           android:id="@+id/tvCoachPurchasePrivacy"
           style="@style/PrivacyPolicyLink"
           android:layout_marginTop="2dp"
           android:text="@string/privacy_policy"/>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buCoachPurchase"
     style="@style/AccentActionButton"
     android:layout_marginTop="14dp"
     android:enabled="false"
     android:text="@string/coach_purchase_subscribe"/>

  <!-- A full beta has nothing to buy or join: only this. -->
  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buCoachBetaClose"
     style="@style/AccentGhostButton"
     android:layout_marginTop="14dp"
     android:text="@string/close"
     android:visibility="gone"/>

  <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="8dp"
     android:gravity="center"
     android:lineSpacingMultiplier="1.2"
     android:id="@+id/tvCoachPurchaseNote"
     android:text="@string/coach_purchase_note"
     android:textColor="@color/secondary_text"
     android:textSize="12sp"/>

</LinearLayout>
