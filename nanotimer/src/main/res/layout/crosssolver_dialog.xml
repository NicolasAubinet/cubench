<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:orientation="vertical"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="16dp"
   android:paddingBottom="2dp">

  <!-- The label shares its line with the ?, which is what explains the three modes under it. -->
  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="horizontal"
     android:gravity="center_vertical"
     android:layout_marginBottom="6dp">

    <TextView
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:text="@string/cross_neutrality"
       android:textAllCaps="true"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"
       android:letterSpacing="0.08"/>

    <ImageView
       android:id="@+id/buCrossHelp"
       android:layout_width="28dp"
       android:layout_height="28dp"
       android:scaleType="fitCenter"
       android:padding="4dp"
       android:background="?android:attr/selectableItemBackgroundBorderless"
       android:src="@drawable/ic_help_outline"
       android:contentDescription="@string/cross_help_title"/>
  </LinearLayout>

  <!-- Segmented control (Specific / Dual / Full), populated in code. -->
  <LinearLayout
     android:id="@+id/llCrossModeSeg"
     android:orientation="horizontal"
     android:background="@drawable/view_segment_group"
     android:padding="3dp"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"/>

  <LinearLayout
     android:id="@+id/llCrossFace"
     android:orientation="vertical"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="14dp">

    <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="@string/cross_face"
       android:textAllCaps="true"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"
       android:letterSpacing="0.08"
       android:layout_marginBottom="6dp"/>

    <!-- Row of 6 color swatches, populated in code. -->
    <LinearLayout
       android:id="@+id/llCrossSwatches"
       android:orientation="horizontal"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"/>

  </LinearLayout>

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="16dp"
     android:minHeight="48dp">

    <LinearLayout
       android:id="@+id/llCrossResults"
       android:orientation="vertical"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"/>

  </ScrollView>

</LinearLayout>
