<?xml version="1.0" encoding="utf-8"?>
<!-- The cross drill while it is running: the cube, what the drill has to say about the rep just
     finished, and the button that ends or takes one.

     <b>Two halves that stand up and lie down.</b> Standing, they are stacked in a column that
     scrolls, and on a phone with the ~420dp the pieces want nothing scrolls at all. On its side
     there is about 260dp of height, so stacked, the cube and the button that takes the next
     scramble could never be on screen together; there the halves go side by side and only the
     reading half scrolls, with the button held out of it.

     Which of the two containers below the halves are sitting in is DrillPanesLayout's business.
     They are moved rather than re-inflated, because a rotation here does not recreate the screen,
     and a rep, a drawn cube and the page it is built into all have to live through the turn. -->
<com.cube.nanotimer.gui.widget.DrillPanesLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/drillRunning"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <!-- Standing up: one scrolling column. -->
  <ScrollView
     android:id="@+id/drillPanesScroll"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:fillViewport="true"
     android:scrollbars="none"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingTop="10dp"
     android:paddingBottom="10dp">

    <LinearLayout
       android:id="@+id/drillPanesStack"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"/>
  </ScrollView>

  <!-- On its side: the two halves beside each other, and no scroll around them. -->
  <LinearLayout
     android:id="@+id/drillPanesRow"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="horizontal"
     android:baselineAligned="false"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingTop="10dp"
     android:paddingBottom="10dp"
     android:visibility="gone"/>

  <!-- The cube, on the bare ground with its pool of shadow like the other drills. It keeps a floor
       of its own so that what gets squeezed is the empty space around it and not the cube. -->
  <FrameLayout
     android:id="@+id/drillCubePane"
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:minHeight="200dp">

    <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so the
         player would build into a 0x0 viewport and stay that size once shown. -->
    <WebView
       android:id="@+id/wvDrillCube"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:background="@android:color/transparent"
       android:visibility="invisible"/>

    <ProgressBar
       android:id="@+id/pbDrillCube"
       style="?android:attr/progressBarStyle"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center"/>

    <View
       android:id="@+id/drillRepWash"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:background="@drawable/drill_rep_glow"
       android:visibility="gone"/>

    <!-- The one thing this drill exists to produce, said so it cannot be missed: that cross could
         not have been built in fewer moves. Over the cube, where the eye already is, and gone again
         in a second, since what it covers is the cross the user has just built. -->
    <TextView
       android:id="@+id/tvDrillCrossBadge"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center"
       android:background="@drawable/smart_cube_pill"
       android:backgroundTint="@color/green_soft"
       android:drawableLeft="@drawable/ic_optimal_check"
       android:drawablePadding="7dp"
       android:gravity="center_vertical"
       android:paddingLeft="16dp"
       android:paddingRight="18dp"
       android:paddingTop="9dp"
       android:paddingBottom="9dp"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/on_accent"
       android:textSize="18sp"
       android:text="@string/drill_cross_badge_optimal"
       android:visibility="gone"/>

    <include layout="@layout/drill_gyro_chip"/>
    <include layout="@layout/drill_cube_away"/>

  </FrameLayout>

  <LinearLayout
     android:id="@+id/drillReadingPane"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical">

    <!-- Scrolls only as the reading half of a screen on its side; standing up, the column around
         it is the thing that scrolls and this measures to its content. -->
    <ScrollView
       android:id="@+id/drillReadingScroll"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fillViewport="true"
       android:scrollbars="none">

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical">

        <!-- Lying down, the pill and the last rep share this line: the column there is 440dp
             wide and 145dp tall, so the row it saves is the room the solution needs. -->
        <LinearLayout
           android:id="@+id/drillStatusRow"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center_vertical"
           android:orientation="horizontal"
           android:visibility="gone"/>

        <!-- What is happening now: the planning left, the moves spent, or that what is on the cube
             is not a cross. Never what the cross is; that is the whole question. A pill, so it
             reads as a state the drill is in rather than as a caption for the cube. -->
        <FrameLayout
           android:id="@+id/drillStatusPill"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp">

          <TextView
             android:id="@+id/tvDrillCrossStatus"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center"
             android:background="@drawable/smart_cube_pill"
             android:backgroundTint="@color/white_wash_10"
             android:paddingLeft="14dp"
             android:paddingRight="14dp"
             android:paddingTop="5dp"
             android:paddingBottom="5dp"
             android:gravity="center"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"
             android:lineSpacingExtra="2dp"
             android:fontFeatureSettings="tnum"/>
        </FrameLayout>

        <!-- ⚠️ The rep just FINISHED: its move count, then the verdict pill, then where the time went.
             Gone during a rep, so no band of nothing sits under the cube while one runs. -->
        <LinearLayout
           android:id="@+id/llDrillLastRep"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp"
           android:gravity="center"
           android:orientation="vertical">

          <LinearLayout
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:gravity="center_vertical"
             android:orientation="horizontal">

            <TextView
               android:id="@+id/tvDrillLastRep"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:includeFontPadding="false"
               android:textColor="@color/white"
               android:fontFamily="@font/roboto_bold"
               android:textSize="@dimen/drill_cross_count_size"
               android:fontFeatureSettings="tnum"/>

            <!-- The verdict, after the count: whether that was the shortest cross, and if not by how
                 much. Tinted like every verdict pill in the app. -->
            <TextView
               android:id="@+id/tvDrillLastRepName"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginLeft="12dp"
               android:background="@drawable/tinted_pill"
               android:paddingLeft="10dp"
               android:paddingRight="10dp"
               android:paddingTop="2dp"
               android:paddingBottom="2dp"
               android:singleLine="true"
               android:letterSpacing="0.02"
               android:fontFamily="@font/roboto_medium"
               android:textSize="14sp"/>
          </LinearLayout>

          <!-- Planning as a wash of the cross colour, the turning at full strength, as the case
               drill draws recognition and execution. -->
          <com.cube.nanotimer.util.view.DrillSplitBarView
             android:id="@+id/vDrillRepSplit"
             android:layout_width="240dp"
             android:layout_height="6dp"
             android:layout_marginTop="10dp"
             android:visibility="gone"/>

          <TextView
             android:id="@+id/tvDrillLastRepSplit"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="5dp"
             android:textColor="@color/secondary_text"
             android:textSize="14sp"
             android:fontFeatureSettings="tnum"/>
        </LinearLayout>

        <!-- Your moves and the shortest, walkable on the cube above, on the drill card. -->
        <com.cube.nanotimer.gui.widget.CrossSolutionPanel
           android:id="@+id/crossSolutionPanel"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="14dp"
           android:background="@drawable/analysis_card"
           android:paddingLeft="14dp"
           android:paddingRight="10dp"
           android:paddingTop="12dp"
           android:paddingBottom="4dp"
           android:visibility="gone"/>

      </LinearLayout>
    </ScrollView>

    <!-- Which rep this is and whether it counts, on its own line above the strip and the button. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillProgress"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textColor="@color/secondary_text"
         android:textSize="16sp"
         android:fontFeatureSettings="tnum"/>

      <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
      <TextView
         android:id="@+id/tvDrillMode"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="3dp"
         android:paddingBottom="3dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>

    <!-- One segment per rep, coloured by how it finished; the rep in hand ringed. -->
    <com.cube.nanotimer.gui.widget.DrillOutcomeStrip
       android:id="@+id/vDrillRepStrip"
       android:layout_width="match_parent"
       android:layout_height="12dp"
       android:layout_marginTop="6dp"/>

    <!-- Announcing the cross is finished, and then taking the next one. Not a start or a stop:
         a cross that is really built ends its own rep, and this is the only end a wrong one has. -->
    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/btDrillCrossDone"
       style="@style/HeroStartButton"
       android:layout_width="match_parent"
       android:layout_height="@dimen/drill_cross_button_height"
       android:layout_marginTop="10dp"
       android:text="@string/drill_cross_done"/>

  </LinearLayout>

</com.cube.nanotimer.gui.widget.DrillPanesLayout>
