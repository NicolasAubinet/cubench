<?xml version="1.0" encoding="utf-8"?>
<!-- The cross drill while it is running: the cube, what the drill has to say about the rep just
     finished, and the button that ends or takes one.

     <b>Two halves that stand up and lie down.</b> Standing, they are stacked in a column that
     scrolls, and on a phone with the ~420dp the pieces want nothing scrolls at all. On its side
     there is about 260dp of height, so stacked, the cube and the button that takes the next
     scramble could never be on screen together; there the halves go side by side and only the
     reading half scrolls, with the button held out of it.

     Which of the two containers below the halves are sitting in is DrillPanesLayout's business.
     They are moved rather than re-inflated, because a rotation here does not recreate the screen,
     and a rep, a drawn cube and the page it is built into all have to live through the turn. -->
<com.cube.nanotimer.gui.widget.DrillPanesLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/drillRunning"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <!-- Standing up: one scrolling column. -->
  <ScrollView
     android:id="@+id/drillPanesScroll"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:fillViewport="true"
     android:scrollbars="none"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingTop="10dp"
     android:paddingBottom="10dp">

    <LinearLayout
       android:id="@+id/drillPanesStack"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"/>
  </ScrollView>

  <!-- On its side: the two halves beside each other, and no scroll around them. -->
  <LinearLayout
     android:id="@+id/drillPanesRow"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="horizontal"
     android:baselineAligned="false"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingTop="10dp"
     android:paddingBottom="10dp"
     android:visibility="gone"/>

  <!-- The cube. It keeps a floor of its own so that what gets squeezed is the empty space around
       it and not the cube. -->
  <FrameLayout
     android:id="@+id/drillCubePane"
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:minHeight="190dp"
     android:background="@drawable/cube_stage">

    <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so the
         player would build into a 0x0 viewport and stay that size once shown. -->
    <WebView
       android:id="@+id/wvDrillCube"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:background="@android:color/transparent"
       android:visibility="invisible"/>

    <ProgressBar
       android:id="@+id/pbDrillCube"
       style="?android:attr/progressBarStyle"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center"/>

    <View
       android:id="@+id/drillRepWash"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:background="@drawable/drill_rep_wash"
       android:visibility="gone"/>

    <!-- The one thing this drill exists to produce, said so it cannot be missed: that cross could
         not have been built in fewer moves. Over the cube, where the eye already is, and gone again
         in a second, since what it covers is the cross the user has just built. -->
    <TextView
       android:id="@+id/tvDrillCrossBadge"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center"
       android:background="@drawable/smart_cube_pill"
       android:backgroundTint="@color/green_soft"
       android:drawableLeft="@drawable/ic_optimal_check"
       android:drawablePadding="7dp"
       android:gravity="center_vertical"
       android:paddingLeft="16dp"
       android:paddingRight="18dp"
       android:paddingTop="9dp"
       android:paddingBottom="9dp"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/on_accent"
       android:textSize="18sp"
       android:text="@string/drill_cross_badge_optimal"
       android:visibility="gone"/>

    <include layout="@layout/drill_gyro_chip"/>

  </FrameLayout>

  <LinearLayout
     android:id="@+id/drillReadingPane"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical">

    <!-- Scrolls only as the reading half of a screen on its side; standing up, the column around
         it is the thing that scrolls and this measures to its content. -->
    <ScrollView
       android:id="@+id/drillReadingScroll"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:fillViewport="true"
       android:scrollbars="none">

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical">

        <!-- Lying down, the pill and the last rep share this line: the column there is 440dp
             wide and 145dp tall, so the row it saves is the room the solution needs. -->
        <LinearLayout
           android:id="@+id/drillStatusRow"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center_vertical"
           android:orientation="horizontal"
           android:visibility="gone"/>

        <!-- What is happening now: the planning left, the moves spent, or that what is on the cube
             is not a cross. Never what the cross is; that is the whole question. A pill, so it
             reads as a state the drill is in rather than as a caption for the cube. -->
        <FrameLayout
           android:id="@+id/drillStatusPill"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp">

          <TextView
             android:id="@+id/tvDrillCrossStatus"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center"
             android:background="@drawable/smart_cube_pill"
             android:backgroundTint="@color/white_wash_10"
             android:paddingLeft="14dp"
             android:paddingRight="14dp"
             android:paddingTop="5dp"
             android:paddingBottom="5dp"
             android:gravity="center"
             android:textColor="@color/secondary_text"
             android:textSize="13sp"
             android:lineSpacingExtra="2dp"
             android:fontFeatureSettings="tnum"/>
        </FrameLayout>

        <!-- ⚠️ The rep just FINISHED: how many moves it took, and how few it could have. Two pieces
             rather than one sentence, so the move count is the thing the eye lands on.

             No height is reserved for it and the screen takes the whole row away between reps: an
             empty row that holds its place is 46dp of nothing under the cube for as long as a rep
             lasts, which is most of the time. What it would have cost is a cube that changes size
             when a rep ends, and the cube is drawn to its well whatever size that is.

             The name slot the case drill fills with a case name carries the verdict here, since a
             scramble has no name of its own to give: whether that was the shortest cross there was,
             and if not by how much. The count and the verdict together say what the optimum was, so
             it is not said a third time in a line of its own. -->
        <LinearLayout
           android:id="@+id/llDrillLastRep"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp"
           android:gravity="center"
           android:orientation="horizontal">

          <!-- A tinted pill, which is how the app says a verdict everywhere else. The pill is here
               rather than in the shared row because the case drill's own name slot is a plain
               label. -->
          <TextView
             android:id="@+id/tvDrillLastRepName"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginRight="8dp"
             android:background="@drawable/tinted_pill"
             android:paddingLeft="10dp"
             android:paddingRight="10dp"
             android:paddingTop="2dp"
             android:paddingBottom="2dp"
             android:letterSpacing="0.02"
             android:fontFamily="@font/roboto_medium"
             android:textSize="13sp"/>

          <TextView
             android:id="@+id/tvDrillLastRep"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:textColor="@color/white"
             android:fontFamily="@font/roboto_medium"
             android:textSize="24sp"
             android:fontFeatureSettings="tnum"/>

          <TextView
             android:id="@+id/tvDrillLastRepSplit"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginLeft="8dp"
             android:textColor="@color/secondary_text"
             android:textSize="12sp"
             android:fontFeatureSettings="tnum"/>
        </LinearLayout>

        <!-- What the rep leaves to look at: the moves that were turned, and the shortest way there
             was, on a cell of its own where the whole of it can be walked onto the drawn cube.
             Its own view, since it holds a way, a place in that way and a way of following one. -->
        <com.cube.nanotimer.gui.widget.CrossSolutionPanel
           android:id="@+id/crossSolutionPanel"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="10dp"/>

      </LinearLayout>
    </ScrollView>

    <!-- On its own line above the controls: sharing one with a button would squeeze the rep
         counter to nothing on a narrow phone, and which rep this is is not the thing to drop. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillProgress"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"
         android:fontFeatureSettings="tnum"/>

      <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
      <TextView
         android:id="@+id/tvDrillMode"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="3dp"
         android:paddingBottom="3dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>

    <!-- Not tappable, so it is not a control: a drill has a known end, and until now it said so in
         words only. -->
    <ProgressBar
       android:id="@+id/pbDrillProgress"
       style="?android:attr/progressBarStyleHorizontal"
       android:layout_width="match_parent"
       android:layout_height="3dp"
       android:layout_marginTop="6dp"
       android:progressDrawable="@drawable/drill_progress"/>

    <!-- Announcing the cross is finished, and then taking the next one. Not a start or a stop:
         a cross that is really built ends its own rep, and this is the only end a wrong one has. -->
    <Button
       android:id="@+id/btDrillCrossDone"
       style="@style/DialogActionButton"
       android:layout_height="48dp"
       android:layout_marginTop="10dp"
       android:textSize="16sp"
       android:text="@string/drill_cross_done"/>

  </LinearLayout>

</com.cube.nanotimer.gui.widget.DrillPanesLayout>
