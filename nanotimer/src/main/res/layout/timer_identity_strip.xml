<?xml version="1.0" encoding="utf-8"?>

<!-- What is being timed, and the screen's banner while a hold is counted down. It is the action
     bar's custom view: the bar gives it its height and its leading inset, and the padding on the
     right holds it off the menu buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/identityStrip"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:paddingRight="8px">

  <!-- Stacked, and hugging the left: side by side the two names compete for a width the menu
       buttons have already taken most of, and this way the bar needs the wider, not the sum. -->
  <LinearLayout
     android:id="@+id/identityRow"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_gravity="center_vertical"
     android:orientation="horizontal"
     android:gravity="center_vertical">

    <ImageView
       android:id="@+id/imgIdentityPuzzle"
       android:layout_width="30px"
       android:layout_height="30px"
       android:contentDescription="@null"/>

    <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginLeft="12px"
       android:layout_marginStart="12px"
       android:orientation="vertical">

      <TextView
         android:id="@+id/tvIdentityPuzzle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:textSize="26px"
         android:textStyle="bold"
         android:textColor="@color/white"
         android:singleLine="true"
         android:ellipsize="end"/>

      <TextView
         android:id="@+id/tvIdentitySolveType"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:textSize="19px"
         android:singleLine="true"
         android:ellipsize="end"/>
    </LinearLayout>
  </LinearLayout>

  <com.cube.nanotimer.util.view.FontFitTextView
     android:id="@+id/tvBanner"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_gravity="center_vertical"
     android:gravity="center"
     android:maxLines="1"
     android:textSize="29px"
     android:textStyle="bold"
     android:fontFeatureSettings="tnum"
     android:textColor="@color/white"
     android:visibility="invisible"/>

</FrameLayout>
