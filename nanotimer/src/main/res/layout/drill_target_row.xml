<?xml version="1.0" encoding="utf-8"?>
<!-- One case of a coach drill on its summary, in the columns of the heading above the rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:minHeight="54dp"
   android:gravity="center_vertical"
   android:background="@drawable/drill_target_row_rule"
   android:orientation="horizontal"
   android:paddingLeft="@dimen/space_xs"
   android:paddingRight="@dimen/space_xs">

  <com.cube.nanotimer.gui.widget.LastLayerCaseView
     android:id="@+id/vDrillTargetChart"
     android:layout_width="36dp"
     android:layout_height="36dp"/>

  <!-- A pair has no picture and shares its name, so its algorithm says which case it is. -->
  <LinearLayout
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_weight="1"
     android:layout_marginLeft="10dp"
     android:orientation="vertical">

    <TextView
       android:id="@+id/tvDrillTargetName"
       style="@style/DrillTargetValue"
       android:layout_width="match_parent"
       android:singleLine="true"
       android:ellipsize="end"
       android:fontFamily="@font/roboto_medium"
       android:textSize="15sp"/>

    <TextView
       android:id="@+id/tvDrillTargetAlg"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="2dp"
       android:maxLines="2"
       android:ellipsize="end"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"
       android:visibility="gone"/>
  </LinearLayout>

  <TextView
     android:id="@+id/tvDrillTargetReps"
     style="@style/DrillTargetValue"
     android:layout_width="@dimen/drill_target_reps_column"
     android:gravity="center_horizontal"
     android:textColor="@color/secondary_text"/>

  <FrameLayout
     android:layout_width="@dimen/drill_target_wins_column"
     android:layout_height="wrap_content">

    <com.cube.nanotimer.gui.widget.DrillCasePips
       android:id="@+id/vDrillTargetWins"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center"/>
  </FrameLayout>

  <TextView
     android:id="@+id/tvDrillTargetTarget"
     style="@style/DrillTargetValue"
     android:layout_width="@dimen/drill_target_time_column"
     android:gravity="end"
     android:textColor="@color/secondary_text"/>

  <TextView
     android:id="@+id/tvDrillTargetMean"
     style="@style/DrillTargetValue"
     android:layout_width="@dimen/drill_target_time_column"
     android:gravity="end"
     android:fontFamily="@font/roboto_medium"/>
</LinearLayout>
