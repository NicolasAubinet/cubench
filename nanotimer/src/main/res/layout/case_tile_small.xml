<?xml version="1.0" encoding="utf-8"?>
<!-- A case tile for a strip: a small picture over its name, a CMLL's over its group. Strip slots
     share the width equally. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="0dp"
   android:layout_height="wrap_content"
   android:layout_weight="1"
   android:gravity="center_horizontal"
   android:orientation="vertical">

  <FrameLayout
     android:layout_width="44dp"
     android:layout_height="44dp">

    <com.cube.nanotimer.gui.widget.LastLayerCaseView
       android:id="@+id/vCaseTileChart"
       android:layout_width="match_parent"
       android:layout_height="match_parent"/>

    <!-- In a strip's last slot, how many more cases there is no room for. -->
    <TextView
       android:id="@+id/tvCaseTileMore"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:background="@drawable/drill_case_more"
       android:gravity="center"
       android:textColor="@color/secondary_text"
       android:textSize="14sp"
       android:textStyle="bold"
       android:visibility="gone"/>
  </FrameLayout>

  <TextView
     android:id="@+id/tvCaseTileName"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginTop="4dp"
     android:maxLines="1"
     android:textColor="@color/secondary_text"
     android:textSize="11sp"/>

  <!-- Only a CMLL keeps it: its group alone repeats across six cases. Held to the slot's width. -->
  <TextView
     android:id="@+id/tvCaseTileShape"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:ellipsize="end"
     android:gravity="center_horizontal"
     android:maxLines="2"
     android:textColor="@color/case_shape"
     android:textSize="10sp"
     android:visibility="gone"/>

</LinearLayout>
