<?xml version="1.0" encoding="utf-8"?>
<!-- A drill: the case stands on the screen's cube and the smart cube is only the input, so the
     physical cube's own state never matters and there is nothing here to press to start or stop a
     rep. The cube reports both ends of one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:fitsSystemWindows="true"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <LinearLayout
     android:id="@+id/drillRunning"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:paddingLeft="12dp"
     android:paddingRight="12dp"
     android:paddingBottom="12dp">

    <!-- The cube stands on the bare mat, in the pool of shadow the timer's cube stands in, rather
         than in a well of its own: the screen's ground is the app's ground. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1">

      <!-- The beat a solved case gets: light round the cube, under it so the cube stays readable.
           Not clickable, and gone between reps. -->
      <View
         android:id="@+id/drillRepWash"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@drawable/drill_rep_glow"
         android:visibility="gone"/>

      <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so
           the player would build into a 0x0 viewport and stay that size once shown. -->
      <WebView
         android:id="@+id/wvDrillCube"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@android:color/transparent"
         android:visibility="invisible"/>

      <ProgressBar
         android:id="@+id/pbDrillCube"
         style="?android:attr/progressBarStyle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"/>

      <TextView
         android:id="@+id/tvDrillFallback"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:gravity="center"
         android:padding="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:visibility="gone"/>

      <include layout="@layout/drill_gyro_chip"/>
    </FrameLayout>

    <!-- Practice mode, or a learning drill's Show alg: the algorithm, in the scramble's face,
         beside the case drawn at the angle the algorithm starts from. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="4dp"
       android:layout_marginBottom="6dp">

    <!-- A learning drill's faded algorithm, back for one rep: it costs the case's run. -->
    <Button
       android:id="@+id/btDrillShowAlg"
       style="@style/DrillGhostButton"
       android:layout_width="wrap_content"
       android:layout_height="40dp"
       android:layout_gravity="center"
       android:minWidth="140dp"
       android:paddingLeft="18dp"
       android:paddingRight="18dp"
       android:text="@string/drill_show_alg"
       android:visibility="gone"/>

    <LinearLayout
       android:id="@+id/llDrillPracticeAlg"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:gravity="center"
       android:orientation="horizontal"
       android:visibility="gone">

      <com.cube.nanotimer.gui.widget.LastLayerCaseView
         android:id="@+id/cvDrillPracticeCase"
         android:layout_width="56dp"
         android:layout_height="56dp"
         android:layout_marginEnd="12dp"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvDrillPracticeAlg"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:gravity="center"
         android:lineSpacingMultiplier="1.1"
         android:textColor="@color/white"
         android:textSize="20sp"/>
    </LinearLayout>
    </FrameLayout>

    <!-- ⚠️ The rep just FINISHED: its case, its time, and where the time went. All of it belongs to
         the case that is over, never to the one on screen, which is deliberately not named anywhere:
         naming it would hand the user the answer, and a recognition drill would be timing reading.

         The time is the screen's headline, as the timer's is. A minimum height holding all three
         lines, so the cube above does not jump as reps come and go; at a large system font it may
         still grow.

         This is also the only clock a drill shows. A running one would have to start somewhere,
         and a rep starts when its case is drawn, not when a frame is painted. -->
    <LinearLayout
       android:id="@+id/llDrillLastRep"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:minHeight="104dp"
       android:gravity="center"
       android:orientation="vertical">

      <TextView
         android:id="@+id/tvDrillLastRepName"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:letterSpacing="0.06"
         android:fontFamily="@font/roboto_medium"
         android:textSize="13sp"/>

      <LinearLayout
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <TextView
           android:id="@+id/tvDrillLastRep"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:includeFontPadding="false"
           android:textColor="@color/white"
           android:fontFamily="@font/roboto_bold"
           android:textSize="50sp"
           android:fontFeatureSettings="tnum"/>

        <!-- A coach drill's verdict on the rep, against its case's target. Gone on every other. -->
        <TextView
           android:id="@+id/tvDrillLastRepVerdict"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginLeft="10dp"
           android:background="@drawable/smart_cube_pill"
           android:paddingLeft="10dp"
           android:paddingRight="10dp"
           android:paddingTop="4dp"
           android:paddingBottom="4dp"
           android:singleLine="true"
           android:fontFamily="@font/roboto_medium"
           android:textColor="@color/on_accent"
           android:textSize="13sp"
           android:fontFeatureSettings="tnum"
           android:visibility="gone"/>
      </LinearLayout>

      <!-- Where the time went, drawn and then said: the looking as a wash of the family's colour,
           the turning at full strength, the same two inks as the case stats. -->
      <com.cube.nanotimer.util.view.DrillSplitBarView
         android:id="@+id/vDrillRepSplit"
         android:layout_width="220dp"
         android:layout_height="6dp"
         android:layout_marginTop="6dp"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvDrillLastRepSplit"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"
         android:fontFeatureSettings="tnum"/>
    </LinearLayout>

    <!-- A coach drill's offer to practise the case just turned off its list, on its own line so it
         is not missed, and outside the rep row so it does not fade with it. A coach drill holds its
         room, so the cube does not jump. -->
    <TextView
       android:id="@+id/tvDrillPracticeOffer"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:layout_marginTop="8dp"
       android:background="@drawable/drill_practice_offer"
       android:drawablePadding="6dp"
       android:gravity="center_vertical"
       android:paddingLeft="12dp"
       android:paddingRight="16dp"
       android:paddingTop="6dp"
       android:paddingBottom="6dp"
       android:singleLine="true"
       android:fontFamily="@font/roboto_medium"
       android:textColor="@color/on_accent"
       android:textSize="14sp"
       android:text="@string/drill_practice_offer"
       android:visibility="gone"/>

    <!-- The choose step: the case's algorithms, the one tapped being the one followed, and a way
         into the full popup. Capped at about four rows and a half, so a long list scrolls rather
         than shrinking the cube. -->
    <com.cube.nanotimer.gui.widget.MaxHeightScrollView
       android:id="@+id/svDrillChoose"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:background="@drawable/analysis_card"
       android:fadeScrollbars="false"
       android:maxHeight="220dp"
       android:padding="4dp"
       android:scrollbarStyle="insideOverlay"
       android:visibility="gone">

      <LinearLayout
         android:id="@+id/llDrillChoose"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"/>
    </com.cube.nanotimer.gui.widget.MaxHeightScrollView>

    <!-- The drill so far, on the app's own card: where it has got, the mode it cannot leave, and
         the figures the summary will open on. -->
    <LinearLayout
       android:id="@+id/llDrillCard"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:background="@drawable/analysis_card"
       android:orientation="vertical"
       android:paddingLeft="12dp"
       android:paddingRight="12dp"
       android:paddingTop="10dp"
       android:paddingBottom="13dp">

      <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <TextView
           android:id="@+id/tvDrillProgress"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:layout_weight="1"
           android:singleLine="true"
           android:ellipsize="end"
           android:textColor="@color/secondary_text"
           android:textSize="13sp"
           android:fontFeatureSettings="tnum"/>

        <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
        <TextView
           android:id="@+id/tvDrillMode"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:background="@drawable/smart_cube_pill"
           android:backgroundTint="@color/white_wash_10"
           android:paddingLeft="10dp"
           android:paddingRight="10dp"
           android:paddingTop="3dp"
           android:paddingBottom="3dp"
           android:textColor="@color/secondary_text"
           android:textSize="12sp"/>
      </LinearLayout>

      <!-- A coach drill's progress, a bar per case, in place of the rep count's meter. -->
      <com.cube.nanotimer.gui.widget.DrillCasePips
         android:id="@+id/vDrillCasePips"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:visibility="gone"/>

      <!-- Not tappable, so it is not a control: a drill has a known end. -->
      <ProgressBar
         android:id="@+id/pbDrillProgress"
         style="?android:attr/progressBarStyleHorizontal"
         android:layout_width="match_parent"
         android:layout_height="4dp"
         android:layout_marginTop="10dp"
         android:progressDrawable="@drawable/drill_progress"/>

      <include
         layout="@layout/drill_live_cells"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- None of the three is a start or stop control: the cube still reports both ends of a rep.
         Quiet pills, so they do not outshout the cube; DrillControlLabels sizes the words. -->
    <!-- While choosing: the case dealt again from the start, and the algorithm being tried starred
         before moving to the next case to choose for. -->
    <LinearLayout
       android:id="@+id/llDrillChooseButtons"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:orientation="horizontal"
       android:visibility="gone">

      <Button
         android:id="@+id/btDrillChooseReset"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:text="@string/drill_reset"/>

      <TextView
         android:id="@+id/btDrillUseThis"
         android:layout_width="0dp"
         android:layout_height="48dp"
         android:layout_weight="2"
         android:layout_marginLeft="8dp"
         android:background="@drawable/drill_practice_offer"
         android:fontFamily="@font/roboto_medium"
         android:gravity="center"
         android:text="@string/drill_choose_use"
         android:textColor="@color/on_accent"
         android:textSize="15sp"/>
    </LinearLayout>

    <LinearLayout
       android:id="@+id/llDrillButtons"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="10dp"
       android:orientation="horizontal">

      <!-- The case's algorithms, for a case that has gone. The rep runs on: stopping its clock for
           this would teach looking it up, so the rep is marked instead. -->
      <Button
         android:id="@+id/btDrillAlgorithm"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:text="@string/drill_case_algorithm"/>

      <!-- Deals the same case again for a slip, and costs no rep. -->
      <Button
         android:id="@+id/btDrillReset"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         android:text="@string/drill_reset"/>

      <!-- Skipping spends the rep rather than escaping it: a case you could not do is a result. -->
      <Button
         android:id="@+id/btDrillSkip"
         style="@style/DrillGhostButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         android:text="@string/drill_skip"/>
    </LinearLayout>

  </LinearLayout>

  <!-- What the drill leaves behind: the card, a coach drill's cases against their targets, then the
       reps. Done stays outside the scroll, so a drill of all 57 OLLs cannot bury it. -->
  <LinearLayout
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:orientation="vertical"
     android:visibility="gone">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="@dimen/space_m"
       android:paddingRight="@dimen/space_m"
       android:paddingTop="@dimen/space_xs"
       android:paddingBottom="@dimen/space_l">

      <include layout="@layout/drill_summary_card"/>

      <!-- A coach drill's cases against their targets. -->
      <LinearLayout
         android:id="@+id/llDrillTargets"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="18dp"
         android:orientation="vertical"
         android:visibility="gone">

        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:paddingLeft="@dimen/space_xs"
           android:paddingRight="@dimen/space_xs"
           android:paddingBottom="8dp"
           android:orientation="horizontal">

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:text="@string/drill_targets_column_case"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="@dimen/drill_target_reps_column"
             android:gravity="center_horizontal"
             android:text="@string/drill_targets_column_reps"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="@dimen/drill_target_wins_column"
             android:gravity="center_horizontal"
             android:text="@string/drill_targets_column_wins"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="@dimen/drill_target_time_column"
             android:gravity="end"
             android:text="@string/drill_targets_column_target"/>

          <TextView
             style="@style/DrillTargetHeading"
             android:layout_width="@dimen/drill_target_time_column"
             android:gravity="end"
             android:text="@string/drill_summary_cell_mean"/>
        </LinearLayout>

        <View
           android:layout_width="match_parent"
           android:layout_height="1dp"
           android:background="@color/hero_divider"/>

        <LinearLayout
           android:id="@+id/llDrillTargetRows"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"/>
      </LinearLayout>

      <!-- One line per rep. The headings are the sort, and a line opens its case's algorithms. -->
      <LinearLayout
         android:id="@+id/llDrillCasesSection"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:visibility="gone">

        <include
           layout="@layout/case_table"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="14dp"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/btDrillDone"
       style="@style/HeroStartButton"
       android:layout_marginTop="12dp"
       android:layout_marginLeft="@dimen/space_m"
       android:layout_marginRight="@dimen/space_m"
       android:layout_marginBottom="16dp"
       android:text="@string/drill_done"/>

  </LinearLayout>

  <!-- Nothing to drill with. Said in place of the drill rather than over it. -->
  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
