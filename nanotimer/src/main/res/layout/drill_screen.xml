<?xml version="1.0" encoding="utf-8"?>
<!-- A drill: the case stands on the screen's cube and the smart cube is only the input, so the
     physical cube's own state never matters and there is nothing here to press to start or stop a
     rep. The cube reports both ends of one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:fitsSystemWindows="true"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <LinearLayout
     android:id="@+id/drillRunning"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:padding="12dp">

    <!-- The cube sits in a well rather than on the background: 3D on a flat surface needs
         something under it or it reads as floating. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:layout_marginTop="10dp"
       android:background="@drawable/cube_stage">

      <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so
           the player would build into a 0x0 viewport and stay that size once shown. -->
      <WebView
         android:id="@+id/wvDrillCube"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@android:color/transparent"
         android:visibility="invisible"/>

      <ProgressBar
         android:id="@+id/pbDrillCube"
         style="?android:attr/progressBarStyle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"/>

      <!-- The beat a solved case gets. Not clickable, and gone between reps so it can never sit
           over a case the user is trying to read. -->
      <View
         android:id="@+id/drillRepWash"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@drawable/drill_rep_wash"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvDrillFallback"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:gravity="center"
         android:padding="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:visibility="gone"/>
    </FrameLayout>

    <!-- ⚠️ The rep just FINISHED: its case, then its time, then how the time was spent. All three
         belong to the case that is over, never to the one on screen, which is deliberately not
         named anywhere: naming it would hand the user the answer, and a recognition drill would be
         timing reading. The name sits with the time rather than under the cube, where at headline
         size it read as a caption for the cube and so as the name of the case being looked at.

         Three pieces rather than one sentence, so the time is the thing the eye lands on. A
         minimum height rather than a fixed one: the row must not change height as reps come and
         go, or the cube above it jumps, but at a large system font it has to be allowed to grow.

         This is also the only clock a drill shows. A running one would have to start somewhere,
         and a rep starts when its case is drawn, not when a frame is painted. -->
    <LinearLayout
       android:id="@+id/llDrillLastRep"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="12dp"
       android:minHeight="46dp"
       android:gravity="center"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillLastRepName"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginRight="8dp"
         android:letterSpacing="0.02"
         android:fontFamily="@font/roboto_medium"
         android:textSize="13sp"/>

      <TextView
         android:id="@+id/tvDrillLastRep"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:textColor="@color/white"
         android:fontFamily="@font/roboto_medium"
         android:textSize="24sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillLastRepSplit"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginLeft="8dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"
         android:fontFeatureSettings="tnum"/>
    </LinearLayout>

    <!-- Where the drill has got to, and the mode it cannot leave. On their own line above the
         controls: a third button left the rep counter no width at all, and which rep this is is
         not the thing to drop. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillProgress"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"
         android:fontFeatureSettings="tnum"/>

      <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
      <TextView
         android:id="@+id/tvDrillMode"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="3dp"
         android:paddingBottom="3dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>
    </LinearLayout>

    <!-- Not tappable, so it is not a control: a drill has a known end, and until now it said so in
         words only. -->
    <ProgressBar
       android:id="@+id/pbDrillProgress"
       style="?android:attr/progressBarStyleHorizontal"
       android:layout_width="match_parent"
       android:layout_height="3dp"
       android:layout_marginTop="8dp"
       android:progressDrawable="@drawable/drill_progress"/>

    <!-- None of the three is a start or stop control: the cube still reports both ends of a rep.
         Autosized down to 12sp rather than left to wrap: a third of the row is 107dp, which every
         translation fits today, and a future one shrinks by a point instead of breaking mid-word. -->
    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="8dp"
       android:orientation="horizontal">

      <!-- The case's algorithms, for a case that has gone. The rep runs on: stopping its clock for
           this would teach looking it up, so the rep is marked instead. -->
      <Button
         android:id="@+id/btDrillAlgorithm"
         style="@style/DialogActionButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         app:autoSizeTextType="uniform"
         app:autoSizeMinTextSize="12sp"
         app:autoSizeMaxTextSize="15sp"
         android:text="@string/drill_case_algorithm"/>

      <!-- Deals the same case again for a slip, and costs no rep. -->
      <Button
         android:id="@+id/btDrillReset"
         style="@style/DialogActionButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         app:autoSizeTextType="uniform"
         app:autoSizeMinTextSize="12sp"
         app:autoSizeMaxTextSize="15sp"
         android:text="@string/drill_reset"/>

      <!-- Skipping spends the rep rather than escaping it: a case you could not do is a result. -->
      <Button
         android:id="@+id/btDrillSkip"
         style="@style/DialogActionButton"
         android:layout_width="0dp"
         android:layout_weight="1"
         android:layout_marginLeft="8dp"
         app:autoSizeTextType="uniform"
         app:autoSizeMinTextSize="12sp"
         app:autoSizeMaxTextSize="15sp"
         android:text="@string/drill_skip"/>
    </LinearLayout>

  </LinearLayout>

  <!-- What the drill leaves behind: the figures for the run, then the case-by-case table that says
       where those figures came from, the warning that the cube is scrambled, and the way out under
       the thumb. On the app's own ground and its own cells, like every other screen that reports
       numbers.

       The way out is outside the scroll: the table is as long as the drill had cases, and a drill
       of all 57 OLLs would otherwise bury Done under fifty-seven rows. -->
  <LinearLayout
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:orientation="vertical"
     android:visibility="gone">

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingTop="6dp"
       android:paddingBottom="16dp">

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:text="@string/drill_finished"
         android:textColor="@color/white"
         android:textSize="26sp"
         android:fontFamily="@font/roboto_medium"
         android:textStyle="normal"/>

      <!-- What was drilled and in which mode, since the drill is over and its own bar is gone. -->
      <TextView
         android:id="@+id/tvDrillSummarySubtitle"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="2dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>

      <!-- match_parent on the cells, so the tallest sets the height and the row never goes ragged.

           ⚠️ The middle cell holds two figures rather than one, so it has ids of its own and is
           NOT filled through the shared setSummaryCell: only cells one and three are. The cross
           drill's own layout keeps all three in the shared shape. -->
      <LinearLayout
         android:id="@+id/llDrillSummaryCells"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="14dp"
         android:baselineAligned="false"
         android:orientation="horizontal">

        <LinearLayout
           android:id="@+id/llDrillCellOne"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1"
           android:layout_marginRight="3dp"
           android:orientation="vertical"
           android:background="@drawable/drill_stat_cell"
           android:paddingLeft="6dp"
           android:paddingRight="6dp"
           android:paddingTop="8dp"
           android:paddingBottom="8dp">
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellKeyOne" style="@style/HeroStatKey"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellValueOne" style="@style/HeroStatValue"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellSubOne" style="@style/HeroStatSub"/>
        </LinearLayout>

        <!-- Both halves, side by side and the same size, because reading a case is half of what
             a drill trains. Wider than its neighbours, since it says two figures where they say
             one. -->
        <LinearLayout
           android:id="@+id/llDrillCellTwo"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1.5"
           android:layout_marginLeft="3dp"
           android:layout_marginRight="3dp"
           android:orientation="vertical"
           android:background="@drawable/drill_stat_cell"
           android:paddingLeft="6dp"
           android:paddingRight="6dp"
           android:paddingTop="8dp"
           android:paddingBottom="8dp">
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellKeyTwo" style="@style/HeroStatKey"/>

          <!-- The hairline between them is the one the statistics rows already use, so the two
               halves read as two figures rather than as one number split by a space. -->
          <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:baselineAligned="false"
             android:divider="@drawable/stat_rule_v"
             android:dividerPadding="3dp"
             android:orientation="horizontal"
             android:showDividers="middle">

            <LinearLayout
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:orientation="vertical">
              <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillMeanRecognition" style="@style/HeroStatValue"/>
              <com.cube.nanotimer.util.view.FontFitTextView style="@style/HeroStatSub" android:textColor="@color/drill_bar_recognition" android:text="@string/drill_summary_column_recognition"/>
            </LinearLayout>

            <LinearLayout
               android:layout_width="0dp"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:layout_marginLeft="6dp"
               android:orientation="vertical">
              <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillMeanExecution" style="@style/HeroStatValue"/>
              <com.cube.nanotimer.util.view.FontFitTextView style="@style/HeroStatSub" android:textColor="@color/drill_bar_execution" android:text="@string/drill_summary_column_execution"/>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
           android:id="@+id/llDrillCellThree"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:layout_weight="1"
           android:layout_marginLeft="3dp"
           android:orientation="vertical"
           android:background="@drawable/drill_stat_cell"
           android:paddingLeft="6dp"
           android:paddingRight="6dp"
           android:paddingTop="8dp"
           android:paddingBottom="8dp">
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellKeyThree" style="@style/HeroStatKey"/>
          <!-- In the green the table gives its quickest rep: the same reading, said twice. -->
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellValueThree" style="@style/HeroStatValue" android:textColor="@color/session_best"/>
          <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvDrillCellSubThree" style="@style/HeroStatSub"/>
        </LinearLayout>
      </LinearLayout>

      <!-- Instead of the cells, for a drill with nothing to average. -->
      <TextView
         android:id="@+id/tvDrillSummaryEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="20dp"
         android:textColor="@color/white"
         android:textSize="17sp"
         android:visibility="gone"/>

      <!-- Where the figures above came from. One line per case rather than per rep, because the
           question a finished drill answers is which cases the time went to, and a case dealt four
           times is one answer and not four.

           The three headings are the sort: tapping one ranks the table by that column and taps
           again to turn it round, and the ranked column is the one written in white. A control of
           its own above the table would have had to name the same three things a second time. -->
      <LinearLayout
         android:id="@+id/llDrillCasesSection"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:visibility="gone">

        <!-- The section's own name shares the line with the three headings, which is all that is
             needed to head a list: a heading strip of its own would have been a second row of
             chrome over rows that already say what they are. -->
        <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="22dp"
           android:gravity="center_vertical"
           android:orientation="horizontal"
           android:paddingLeft="@dimen/space_xs"
           android:paddingRight="@dimen/space_xs">

          <TextView
             style="@style/DialogSectionLabel"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:text="@string/drill_summary_cases"/>

          <TextView
             android:id="@+id/tvDrillSortRecognition"
             style="@style/DrillCaseColumn"
             android:text="@string/drill_summary_column_recognition"/>

          <TextView
             android:id="@+id/tvDrillSortExecution"
             style="@style/DrillCaseColumn"
             android:text="@string/drill_summary_column_execution"/>

          <TextView
             android:id="@+id/tvDrillSortTotal"
             style="@style/DrillCaseColumn"
             android:text="@string/drill_summary_column_total"/>
        </LinearLayout>

        <View
           android:layout_width="match_parent"
           android:layout_height="1dp"
           android:background="@color/hero_divider"/>

        <!-- One drill_case_row per rep, filled in code. No card around them: a list of times on
             the ground reads as a list, which is what the history screen already proves. -->
        <LinearLayout
           android:id="@+id/llDrillCaseRows"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:divider="@drawable/stat_rule_h"
           android:orientation="vertical"
           android:showDividers="middle"/>
      </LinearLayout>

    </LinearLayout>
  </ScrollView>

    <!-- The sheet's own action, in the accent the main screen's Start wears: it is the only thing
         to do here, and a tonal slab beside a page of colour read as one more disabled control. -->
    <androidx.appcompat.widget.AppCompatButton
       android:id="@+id/btDrillDone"
       style="@style/HeroStartButton"
       android:layout_marginTop="12dp"
       android:layout_marginLeft="16dp"
       android:layout_marginRight="16dp"
       android:layout_marginBottom="16dp"
       android:text="@string/drill_done"/>

  </LinearLayout>

  <!-- Nothing to drill with. Said in place of the drill rather than over it. -->
  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/graybg"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
