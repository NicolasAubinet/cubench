<?xml version="1.0" encoding="utf-8"?>
<!-- A drill: the case stands on the screen's cube and the smart cube is only the input, so the
     physical cube's own state never matters and there is nothing here to press to start or stop a
     rep. The cube reports both ends of one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent">

  <LinearLayout
     android:id="@+id/drillRunning"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:padding="12dp">

    <!-- Only for a cube whose grip cannot be read (no gyro, or no reference yet). Where it can,
         the cube on screen turns with theirs and there is nothing to tell them. -->
    <TextView
       android:id="@+id/tvDrillGrip"
       android:visibility="gone"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:background="@drawable/smart_cube_pill"
       android:backgroundTint="@color/white_wash_10"
       android:paddingLeft="12dp"
       android:paddingRight="12dp"
       android:paddingTop="4dp"
       android:paddingBottom="4dp"
       android:text="@string/drill_grip_hint"
       android:textColor="@color/secondary_text"
       android:textSize="12sp"/>

    <!-- The cube sits in a well rather than on the background: 3D on a flat surface needs
         something under it or it reads as floating. -->
    <FrameLayout
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:layout_weight="1"
       android:layout_marginTop="10dp"
       android:background="@drawable/cube_stage">

      <!-- ⚠️ INVISIBLE until the page has drawn, never GONE: a GONE WebView is not laid out, so
           the player would build into a 0x0 viewport and stay that size once shown. -->
      <WebView
         android:id="@+id/wvDrillCube"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@android:color/transparent"
         android:visibility="invisible"/>

      <ProgressBar
         android:id="@+id/pbDrillCube"
         style="?android:attr/progressBarStyle"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center"/>

      <!-- The beat a solved case gets. Not clickable, and gone between reps so it can never sit
           over a case the user is trying to read. -->
      <View
         android:id="@+id/drillRepWash"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:background="@color/green_soft"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvDrillFallback"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_gravity="center"
         android:gravity="center"
         android:padding="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:visibility="gone"/>
    </FrameLayout>

    <!-- ⚠️ The rep just FINISHED: its case, then its time. Both belong to the case that is over,
         never to the one on screen, which is deliberately not named anywhere — naming it would
         hand the user the answer, and a recognition drill would be timing reading. The name sits
         with the time rather than under the cube, where at headline size it read as a caption for
         the cube and so as the name of the case being looked at.

         This is also the only clock a drill shows. A running one would have to start somewhere,
         and a rep starts when its case is drawn, not when a frame is painted. -->
    <TextView
       android:id="@+id/tvDrillLastRep"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:minHeight="26dp"
       android:gravity="center"
       android:textColor="@color/white"
       android:textSize="17sp"
       android:fontFeatureSettings="tnum"/>

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="14dp"
       android:gravity="center_vertical"
       android:orientation="horizontal">

      <TextView
         android:id="@+id/tvDrillProgress"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:singleLine="true"
         android:ellipsize="end"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"
         android:fontFeatureSettings="tnum"/>

      <!-- The mode picked before the drill started, shown because it cannot be changed now. -->
      <TextView
         android:id="@+id/tvDrillMode"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginRight="8dp"
         android:background="@drawable/smart_cube_pill"
         android:backgroundTint="@color/white_wash_10"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:paddingTop="3dp"
         android:paddingBottom="3dp"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"/>

      <!-- Deals the same case again for a slip, and costs no rep. Neither of these two is a start
           or stop control: the cube still reports both ends of a rep. -->
      <Button
         android:id="@+id/btDrillReset"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginRight="6dp"
         android:text="@string/drill_reset"/>

      <!-- Skipping spends the rep rather than escaping it: a case you could not do is a result. -->
      <Button
         android:id="@+id/btDrillSkip"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:text="@string/drill_skip"/>
    </LinearLayout>

  </LinearLayout>

  <!-- What the drill leaves behind, which is a scrambled cube and needs one line, not a dialog. -->
  <ScrollView
     android:id="@+id/drillSummary"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/color_primary"
     android:visibility="gone">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:gravity="center_horizontal"
       android:padding="24dp">

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:text="@string/drill_finished"
         android:textColor="@color/white"
         android:textSize="24sp"
         android:textStyle="bold"/>

      <TextView
         android:id="@+id/tvDrillSummaryReps"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="16dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillSummaryMean"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="6dp"
         android:textColor="@color/white"
         android:textSize="20sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillSummaryOtherMean"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:id="@+id/tvDrillSummaryBest"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:fontFeatureSettings="tnum"/>

      <TextView
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="24dp"
         android:gravity="center"
         android:text="@string/drill_cube_left_scrambled"
         android:textColor="@color/secondary_text"
         android:textSize="14sp"/>

      <Button
         android:id="@+id/btDrillDone"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_marginTop="24dp"
         android:text="@string/drill_done"/>

    </LinearLayout>
  </ScrollView>

  <!-- Nothing to drill with. Said in place of the drill rather than over it. -->
  <TextView
     android:id="@+id/tvDrillUnavailable"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:background="@color/color_primary"
     android:gravity="center"
     android:padding="32dp"
     android:textColor="@color/secondary_text"
     android:textSize="16sp"
     android:visibility="gone"/>

</FrameLayout>
