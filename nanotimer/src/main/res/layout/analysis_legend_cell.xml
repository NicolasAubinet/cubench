<?xml version="1.0" encoding="utf-8"?>
<!-- One step under the composition bar: its name in its own colour, what it takes in seconds, and its
     share. The name's colour is the swatch, which every segment needs with a palette this bright. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="0dp"
   android:layout_height="wrap_content"
   android:layout_weight="1"
   android:orientation="vertical"
   android:paddingLeft="2dp"
   android:paddingRight="6dp">

  <TextView
     android:id="@+id/tvAnalysisLegendName"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:ellipsize="end"
     android:maxLines="1"
     android:textSize="13sp"/>

  <com.cube.nanotimer.util.view.FontFitTextView
     android:id="@+id/tvAnalysisLegendTime"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:fontFeatureSettings="tnum"
     android:singleLine="true"
     android:textColor="@color/white"
     android:textSize="19sp"
     android:textStyle="bold"/>

  <TextView
     android:id="@+id/tvAnalysisLegendShare"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="-3dp"
     android:fontFeatureSettings="tnum"
     android:textColor="@color/secondary_text"
     android:textSize="12sp"/>
</LinearLayout>
