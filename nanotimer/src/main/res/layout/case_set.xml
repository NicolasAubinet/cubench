<?xml version="1.0" encoding="utf-8"?>
<!-- One set: filters over its cases, drawn as a grid in the set's order or by standing, or as the
     case table when sorted by a mean. The filters stay above the scroll. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true"
   android:orientation="vertical">

  <HorizontalScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:clipToPadding="false"
     android:paddingLeft="16dp"
     android:paddingTop="10dp"
     android:paddingRight="16dp"
     android:scrollbars="none">

    <LinearLayout
       android:id="@+id/llCaseSetFilters"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:orientation="horizontal"/>
  </HorizontalScrollView>

  <!-- How far back a drill mean reads; only while that sort is on. -->
  <LinearLayout
     android:id="@+id/llDrillStatsWindow"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginLeft="16dp"
     android:layout_marginTop="10dp"
     android:layout_marginRight="16dp"
     android:background="@drawable/view_segment_group"
     android:orientation="horizontal"
     android:padding="3dp"
     android:visibility="gone"/>

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingBottom="16dp">

      <TextView
         android:id="@+id/tvCaseSetCount"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:layout_marginBottom="10dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>

      <!-- Rows of tiles, built in code to the screen width. -->
      <LinearLayout
         android:id="@+id/llCaseSetGrid"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"/>

      <TextView
         android:id="@+id/tvCaseSetEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="40dp"
         android:gravity="center"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:visibility="gone"/>

      <LinearLayout
         android:id="@+id/llDrillStatsSection"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:visibility="gone">

        <include
           layout="@layout/case_table"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
