<?xml version="1.0" encoding="utf-8"?>
<!-- One set: filters over its cases, drawn as a grid in the set's order or by standing, or as the
     case table when sorted by a mean. The filters stay above the scroll. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="match_parent"
   android:background="@color/graybg"
   android:fitsSystemWindows="true"
   android:orientation="vertical">

  <HorizontalScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:clipToPadding="false"
     android:paddingLeft="16dp"
     android:paddingTop="10dp"
     android:paddingRight="16dp"
     android:scrollbars="none">

    <LinearLayout
       android:id="@+id/llCaseSetFilters"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:orientation="horizontal"/>
  </HorizontalScrollView>

  <!-- Picking a drill's cases: the count, Only these while a group is shown, and All / None,
       which act on the cases shown. -->
  <LinearLayout
     android:id="@+id/llCaseSetPick"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginLeft="16dp"
     android:layout_marginTop="10dp"
     android:layout_marginRight="16dp"
     android:gravity="center_vertical"
     android:orientation="horizontal"
     android:visibility="gone">

    <TextView
       android:id="@+id/tvCasesCount"
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_weight="1"
       android:textColor="@color/secondary_text"
       android:textSize="13sp"/>

    <TextView
       android:id="@+id/tvCasesOnly"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginRight="8dp"
       android:background="?android:attr/selectableItemBackground"
       android:padding="6dp"
       android:textColor="@color/lightblue"
       android:textSize="13sp"
       android:visibility="gone"/>

    <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:background="@drawable/view_segment_group"
       android:orientation="horizontal"
       android:padding="3dp">

      <TextView
         android:id="@+id/tvCasesAll"
         style="@style/CasesSegment"
         android:text="@string/drill_cases_all"/>

      <TextView
         android:id="@+id/tvCasesNone"
         style="@style/CasesSegment"
         android:text="@string/drill_cases_none"/>
    </LinearLayout>
  </LinearLayout>

  <!-- Choosing cases to learn only: known cases are left out unless this is ticked. -->
  <CheckBox
     android:id="@+id/cbCasesShowKnown"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginLeft="16dp"
     android:layout_marginTop="4dp"
     android:background="@null"
     android:button="@drawable/release_notes_check"
     android:minHeight="36dp"
     android:paddingLeft="10dp"
     android:paddingStart="10dp"
     android:text="@string/learn_pick_show_known"
     android:textColor="@color/secondary_text"
     android:textSize="13sp"
     android:visibility="gone"/>

  <!-- How far back a drill mean reads; only while that sort is on. -->
  <LinearLayout
     android:id="@+id/llDrillStatsWindow"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginLeft="16dp"
     android:layout_marginTop="10dp"
     android:layout_marginRight="16dp"
     android:background="@drawable/view_segment_group"
     android:orientation="horizontal"
     android:padding="3dp"
     android:visibility="gone"/>

  <ScrollView
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_weight="1"
     android:fillViewport="true">

    <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingLeft="16dp"
       android:paddingRight="16dp"
       android:paddingBottom="16dp">

      <TextView
         android:id="@+id/tvCaseSetCount"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="10dp"
         android:layout_marginBottom="10dp"
         android:textColor="@color/secondary_text"
         android:textSize="13sp"/>

      <!-- Rows of tiles, built in code to the screen width. -->
      <LinearLayout
         android:id="@+id/llCaseSetGrid"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"/>

      <!-- Picking only: a tap picks, so the sheet is behind a hold. -->
      <TextView
         android:id="@+id/tvCaseSetHint"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="4dp"
         android:text="@string/drill_cases_hint"
         android:textColor="@color/secondary_text"
         android:textSize="12sp"
         android:visibility="gone"/>

      <!-- The drill stats cells, over the drill mean table: every rep in the window. -->
      <include
         android:id="@+id/icCaseSetCells"
         layout="@layout/drill_stat_cells"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginBottom="14dp"
         android:visibility="gone"/>

      <TextView
         android:id="@+id/tvCaseSetEmpty"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:layout_marginTop="40dp"
         android:gravity="center"
         android:textColor="@color/secondary_text"
         android:textSize="15sp"
         android:visibility="gone"/>

      <LinearLayout
         android:id="@+id/llDrillStatsSection"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:visibility="gone">

        <include
           layout="@layout/case_table"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"/>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
