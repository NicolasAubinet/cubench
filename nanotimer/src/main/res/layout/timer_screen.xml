<?xml version="1.0" encoding="utf-8"?>

<com.cube.nanotimer.util.view.ScalingLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:app="http://schemas.android.com/apk/res-auto"
   android:id="@+id/scalingRootLayout"
   android:fitsSystemWindows="true"
   android:layout_height="match_parent"
   android:layout_width="match_parent">

  <RelativeLayout
     android:id="@+id/mainLayout"
     android:layout_width="match_parent"
     android:layout_height="match_parent">

    <LinearLayout
       android:id="@+id/centerLayout"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:clipChildren="false"
       android:clipToPadding="false"
       android:orientation="vertical">

      <!-- The timer and its scramble take every pixel the statistics below do not need, so a
           short 3x3 scramble is not charged for the ten lines a 7x7 one costs. -->
      <LinearLayout
         android:id="@+id/timerLayout"
         android:layout_width="match_parent"
         android:layout_height="0px"
         android:layout_weight="1"
         android:gravity="center"
         android:clipChildren="false"
         android:clipToPadding="false"
         android:paddingLeft="2px"
         android:paddingRight="2px"
         android:orientation="vertical">
        <!-- This spacer and the one at the foot take whatever the block does not need, 1:2. The foot
             is the heavier because the digits carry their own leading above the glyphs: with the two
             equal, the air above the block reads larger than the air below it. With nothing in the
             band ScrambleStatePreview evens them out, which is the screen as it was before any of
             this. They are also what says whether there is room for a picture at all: what the two
             of them hold is what is going spare. -->
        <Space
           android:id="@+id/timerTopSpace"
           android:layout_width="match_parent"
           android:layout_height="0px"
           android:layout_weight="1"/>
        <!-- The band the digits sit in, shared with the dot that stands in for them. No margin of
             its own: the spacer above is the air over the digits, and a margin on top of it is air
             the block cannot give back when a 7x7 scramble needs every pixel. -->
        <FrameLayout
           android:id="@+id/timerBox"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:clipChildren="false"
           android:clipToPadding="false">
          <com.cube.nanotimer.util.view.DigitalTextView
             android:id="@+id/tvTimer"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:textSize="85px"
             android:layout_gravity="center"
             android:textColor="@color/white"
             android:gravity="left"/>
          <!-- The rule under the time, in the puzzle's hue: the one piece of colour the upper
               screen carries. Placed from code off the digits' baseline, since the timer font is a
               setting and every face puts its baseline somewhere different — see TimePlinth. -->
          <View
             android:id="@+id/timePlinth"
             android:layout_width="50px"
             android:layout_height="3px"
             android:layout_gravity="center_horizontal|top"
             android:background="@drawable/time_plinth"
             android:visibility="invisible"/>
          <!-- Stands in for the digits during a solve timed without them. -->
          <View
             android:id="@+id/focusDot"
             android:layout_width="22px"
             android:layout_height="22px"
             android:layout_gravity="center"
             android:visibility="gone"/>
        </FrameLayout>

        <!-- The steps of the solve, and what a cube counted of it, as one block. It sits directly
             under the digits, because the time is the sum of the bar and the two are read as one
             thing. Gone when the solve type has neither steps nor a cube behind it. -->
        <LinearLayout
           android:id="@+id/stepBreakdown"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:clipChildren="false"
           android:clipToPadding="false"
           android:orientation="vertical">
          <!-- The margin is negative, and on the bar rather than on the block, for two reasons. The
               digits carry their own descent inside their box — some 57px of it at this size, with
               nothing drawn in it — so measured off the glyphs a positive margin here is already a
               gap. And a solve type with no bar has it GONE, whose margin is not applied at all:
               that screen keeps the air under its digits, which pulling the block up would take.
               The block does not clip: a negative margin only shortens it, and the bar it lifted
               out of the top would be cut off rather than drawn where it was put. -->
          <com.cube.nanotimer.gui.widget.SolveStepBar
             android:id="@+id/solveStepBar"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="-8px"
             android:layout_marginLeft="26px"
             android:layout_marginRight="26px"
             android:visibility="gone"/>
          <TextView
             android:id="@+id/tvSolveStats"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center_horizontal"
             android:layout_marginTop="4px"
             android:clickable="false"
             android:focusable="false"
             android:fontFeatureSettings="tnum"
             android:textColor="@color/secondary_text"
             android:textSize="19px"
             android:visibility="gone"/>
        </LinearLayout>

        <!-- The verdict on the solve just finished. The slot is here whether or not there is a
             chip in it, so the scramble below never moves and is never covered. Under the breakdown
             rather than over it: between the digits and the bar it was air holding the two apart. -->
        <FrameLayout
           android:layout_width="match_parent"
           android:layout_height="30px"
           android:layout_marginTop="4px">
          <TextView
             android:id="@+id/tvVerdictChip"
             android:layout_width="wrap_content"
             android:layout_height="match_parent"
             android:layout_gravity="center_horizontal"
             android:background="@drawable/tinted_pill"
             android:gravity="center"
             android:paddingLeft="16px"
             android:paddingRight="16px"
             android:textSize="19px"
             android:singleLine="true"
             android:ellipsize="end"
             android:fontFeatureSettings="tnum"
             android:visibility="invisible"/>
        </FrameLayout>

        <FrameLayout
           android:id="@+id/scrambleBox"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="5px"
           android:clipChildren="false"
           android:clipToPadding="false">

          <com.cube.nanotimer.util.view.FontFitTextView
             android:id="@+id/tvScramble"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center_horizontal"
             android:paddingLeft="10px"
             android:paddingRight="10px"
             android:lineSpacingMultiplier="0.88"
             app:myfont="SCRAMBLE"
             style="@style/ScrambleTextFieldPx"/>

          <!-- Stands in for the scramble while the first random-state ones for this puzzle are
               still being made. The screen never falls back to a random-move scramble, so when it
               has none it has to say why. Nothing in here is clickable: the whole surface must
               stay one tap target. -->
          <LinearLayout
             android:id="@+id/scrambleLoading"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_gravity="center_horizontal"
             android:orientation="vertical"
             android:gravity="center_horizontal"
             android:paddingTop="4px"
             android:paddingBottom="4px"
             android:clickable="false"
             android:focusable="false"
             android:visibility="gone">

            <ProgressBar
               style="?android:attr/progressBarStyleSmall"
               android:layout_width="24px"
               android:layout_height="24px"
               android:clickable="false"
               android:focusable="false"
               android:indeterminateTint="@color/lightblue"/>

            <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="7px"
               android:clickable="false"
               android:focusable="false"
               android:textSize="19px"
               android:text="@string/scramble_generating"/>

          </LinearLayout>

        </FrameLayout>

        <!-- What is drawn in the gap under the scramble: the scramble's state, or the connected cube
             in its place (TimerActivity.refreshStatePreviewOwner). One or the other, never both. The
             height is set from code — see ScrambleStatePreview.PICTURE_PX — and left at nothing where
             the screen cannot pay for even the smallest of it, so the statistics card being taller
             under one solve type than another changes the air around the picture rather than its
             size. Two stubs, so a user with no cube pays nothing for one and a puzzle with no
             diagram nothing for that. -->
        <FrameLayout
           android:id="@+id/statePreviewCell"
           android:layout_width="match_parent"
           android:layout_height="0px">
          <ViewStub
             android:id="@+id/stubStatePreview"
             android:layout="@layout/timer_state_preview"
             android:layout_width="match_parent"
             android:layout_height="match_parent"/>
          <ViewStub
             android:id="@+id/stubLiveCube"
             android:layout="@layout/timer_live_cube"
             android:layout_width="match_parent"
             android:layout_height="match_parent"/>
        </FrameLayout>

        <!-- The foot of the block. Heavier than the spacer at its head, because the digits carry
             their own leading above the glyphs: with the two gaps equal the block reads low. -->
        <Space
           android:id="@+id/statePreviewFoot"
           android:layout_width="match_parent"
           android:layout_height="0px"
           android:layout_weight="1.4"/>
      </LinearLayout>

      <!-- Statistics. One raised surface with hairlines instead of gaps: every solve type uses
           the same card and only chooses which of its blocks it needs, and what the second value
           in a cell means. -->
      <LinearLayout
         android:id="@+id/sessionLayout"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"
         android:clipChildren="false"
         android:clipToPadding="false"
         android:paddingLeft="@dimen/grid_margin_px"
         android:paddingRight="@dimen/grid_margin_px"
         android:paddingBottom="@dimen/grid_margin_px">

        <androidx.cardview.widget.CardView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="@color/timercardbg"
           app:cardCornerRadius="8dp"
           app:cardElevation="2dp">

          <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical"
             android:paddingLeft="8px"
             android:paddingRight="8px"
             android:paddingTop="5px"
             android:paddingBottom="5px">

            <LinearLayout
               android:id="@+id/sessionHeader"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:paddingLeft="4px"
               android:paddingRight="4px"
               android:paddingBottom="5px">
              <TextView
                 android:layout_width="0px"
                 android:layout_weight="1"
                 android:text="@string/timer_session"
                 style="@style/SessionHeaderPx"/>
              <TextView
                 android:id="@+id/tvSolvesCount"
                 android:layout_width="wrap_content"
                 style="@style/SessionWindowPx"/>
            </LinearLayout>

            <TableLayout
               android:id="@+id/sessionTimesLayout"
               android:layout_width="match_parent"
               android:layout_height="wrap_content">
              <TableRow>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
              </TableRow>
              <TableRow>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
              </TableRow>
              <TableRow>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
                <TextView style="@style/GridCellPx" android:background="@drawable/session_chip_1"/>
              </TableRow>
            </TableLayout>

            <!-- The same twelve solves as the grid above, as bars: which one is out of place, at a
                 glance, without reading a number. One or the other is on, never both. -->
            <com.cube.nanotimer.util.view.SessionBarsView
               android:id="@+id/sessionBars"
               android:layout_width="match_parent"
               android:layout_height="112px"
               android:layout_marginLeft="3px"
               android:layout_marginRight="3px"
               android:layout_marginBottom="4px"
               android:visibility="gone"/>

            <View
               android:id="@+id/statTilesRule"
               android:layout_width="match_parent"
               android:layout_height="1dp"
               android:layout_marginTop="4px"
               android:layout_marginBottom="4px"
               android:background="@color/hero_divider"/>

            <!-- Four windows, four cells. The second line of a cell is "best" normally, and the
                 success rate for a blind solve type. -->
            <LinearLayout
               android:id="@+id/statTilesLayout"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:divider="@drawable/stat_rule_v"
               android:showDividers="middle"
               android:dividerPadding="3px">

              <LinearLayout
                 android:id="@+id/statTileOne"
                 android:layout_width="0px"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:orientation="vertical"
                 android:paddingTop="4px"
                 android:paddingBottom="4px">
                <TextView android:id="@+id/tvStatKeyOne" style="@style/StatTileKeyPx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvAvgOfFive" style="@style/StatTileValuePx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvMeanOfThree" style="@style/StatTileValuePx" android:visibility="gone"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvBestOfFive" style="@style/StatTileSubPx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvBestMeanOfThree" style="@style/StatTileSubPx" android:visibility="gone"/>
              </LinearLayout>

              <LinearLayout
                 android:id="@+id/statTileTwo"
                 android:layout_width="0px"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:orientation="vertical"
                 android:paddingTop="4px"
                 android:paddingBottom="4px">
                <TextView android:id="@+id/tvStatKeyTwo" style="@style/StatTileKeyPx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvAvgOfTwelve" style="@style/StatTileValuePx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvBestOfTwelve" style="@style/StatTileSubPx"/>
              </LinearLayout>

              <LinearLayout
                 android:id="@+id/statTileThree"
                 android:layout_width="0px"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:orientation="vertical"
                 android:paddingTop="4px"
                 android:paddingBottom="4px">
                <TextView android:id="@+id/tvStatKeyThree" style="@style/StatTileKeyPx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvAvgOfFifty" style="@style/StatTileValuePx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvBestOfFifty" style="@style/StatTileSubPx"/>
              </LinearLayout>

              <LinearLayout
                 android:id="@+id/statTileFour"
                 android:layout_width="0px"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:orientation="vertical"
                 android:paddingTop="4px"
                 android:paddingBottom="4px">
                <TextView android:id="@+id/tvStatKeyFour" style="@style/StatTileKeyPx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvAvgOfHundred" style="@style/StatTileValuePx"/>
                <com.cube.nanotimer.util.view.FontFitTextView android:id="@+id/tvBestOfHundred" style="@style/StatTileSubPx"/>
              </LinearLayout>
            </LinearLayout>

            <!-- A solve type timed in steps reads its averages as splits, so it takes this block
                 instead of the cells above. It draws its own rows, so it carries no background of
                 its own: the card around it is the surface. -->
            <com.cube.nanotimer.gui.widget.StepSplitsView
               android:id="@+id/stepSplits"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:paddingLeft="8px"
               android:paddingRight="8px"
               android:paddingTop="2px"
               android:paddingBottom="2px"
               android:visibility="gone"/>

            <View
               android:id="@+id/statFooterRule"
               android:layout_width="match_parent"
               android:layout_height="1dp"
               android:layout_marginTop="4px"
               android:layout_marginBottom="4px"
               android:background="@color/hero_divider"/>

            <!-- The two values that barely move: stated once, not tracked. -->
            <LinearLayout
               android:id="@+id/statFooterRow"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:divider="@drawable/stat_rule_v"
               android:showDividers="middle"
               android:dividerPadding="2px">
              <LinearLayout
                 android:id="@+id/footerPbCell"
                 android:layout_width="0px"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:orientation="horizontal"
                 android:gravity="center_vertical"
                 android:paddingLeft="10px"
                 android:paddingRight="10px"
                 android:paddingTop="3px"
                 android:paddingBottom="3px">
                <TextView
                   android:text="@string/personal_best_label"
                   style="@style/StatFooterKeyPx"/>
                <!-- The value carries the weight, not the label: the label is fixed text while
                     the time is what varies, and FontFitTextView only shrinks into a width it
                     has been given. Weighted the other way a 7x7 PB took the cell and clipped
                     the label. -->
                <com.cube.nanotimer.util.view.FontFitTextView
                   android:id="@+id/tvLifetimeBest"
                   android:layout_width="0px"
                   android:layout_weight="1"
                   android:layout_marginLeft="6px"
                   android:layout_marginStart="6px"
                   android:gravity="right"
                   style="@style/StatFooterValuePx"/>
              </LinearLayout>
              <LinearLayout
                 android:id="@+id/footerAvgCell"
                 android:layout_width="0px"
                 android:layout_height="wrap_content"
                 android:layout_weight="1"
                 android:orientation="horizontal"
                 android:gravity="center_vertical"
                 android:paddingLeft="10px"
                 android:paddingRight="10px"
                 android:paddingTop="3px"
                 android:paddingBottom="3px">
                <TextView
                   android:text="@string/mean_label"
                   style="@style/StatFooterKeyPx"/>
                <com.cube.nanotimer.util.view.FontFitTextView
                   android:id="@+id/tvLifetimeAvg"
                   android:layout_width="0px"
                   android:layout_weight="1"
                   android:layout_marginLeft="6px"
                   android:layout_marginStart="6px"
                   android:gravity="right"
                   style="@style/StatFooterValuePx"/>
              </LinearLayout>
            </LinearLayout>

          </LinearLayout>
        </androidx.cardview.widget.CardView>
      </LinearLayout>
    </LinearLayout>

  </RelativeLayout>

</com.cube.nanotimer.util.view.ScalingLinearLayout>
