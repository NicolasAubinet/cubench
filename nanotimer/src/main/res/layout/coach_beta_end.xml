<?xml version="1.0" encoding="utf-8"?>
<!-- Once, at the top of the Plan tab, for a member after the beta has ended: thanks, and the
     members' offer on the monthly plan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:layout_marginBottom="@dimen/space_m"
   android:background="@drawable/coach_card_ended"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="14dp"
   android:paddingBottom="16dp">

  <LinearLayout
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:gravity="center_vertical"
     android:orientation="horizontal">

    <ImageView
       android:layout_width="40dp"
       android:layout_height="40dp"
       android:background="@drawable/coach_hero_icon_tile"
       android:importantForAccessibility="no"
       android:padding="10dp"
       android:src="@drawable/ic_coach_point_support"/>

    <LinearLayout
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:layout_marginStart="12dp"
       android:layout_marginLeft="12dp"
       android:layout_weight="1"
       android:orientation="vertical">

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:fontFamily="@font/roboto"
         android:text="@string/coach_beta_end_title"
         android:textColor="@color/white"
         android:textSize="17sp"
         android:textStyle="bold"/>

      <TextView
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:text="@string/coach_beta_end_sub"
         android:textColor="@color/secondary_text"
         android:textSize="12.5sp"/>
    </LinearLayout>
  </LinearLayout>

  <TextView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="10dp"
     android:lineSpacingMultiplier="1.2"
     android:text="@string/coach_beta_end_body"
     android:textColor="@color/white"
     android:textSize="13.5sp"/>

  <androidx.appcompat.widget.AppCompatButton
     android:id="@+id/buCoachBetaEnd"
     style="@style/AccentActionButton"
     android:layout_marginTop="12dp"
     android:text="@string/coach_beta_end_button"/>
</LinearLayout>
