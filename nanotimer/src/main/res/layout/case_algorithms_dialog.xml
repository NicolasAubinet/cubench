<?xml version="1.0" encoding="utf-8"?>
<!-- One case, big: the chart to recognise it by and the algorithms people actually use for it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:orientation="vertical"
   android:paddingLeft="16dp"
   android:paddingRight="16dp"
   android:paddingTop="8dp">

  <com.cube.nanotimer.gui.widget.LastLayerCaseView
     android:id="@+id/vCaseChart"
     android:layout_width="160dp"
     android:layout_height="160dp"
     android:layout_gravity="center_horizontal"/>

  <!-- An F2L pair's case, drawn on the 3D cube with only the cross and the pair in colour. A GONE
       WebView is never laid out, so the dialog only shows this well for a pair. -->
  <FrameLayout
     android:id="@+id/flCaseCube"
     android:layout_width="196dp"
     android:layout_height="196dp"
     android:layout_gravity="center_horizontal"
     android:background="@drawable/cube_stage"
     android:visibility="gone">

    <WebView
       android:id="@+id/wvCaseCube"
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:background="@android:color/transparent"/>
  </FrameLayout>

  <TextView
     android:id="@+id/tvCaseShape"
     style="@style/RowChip"
     android:layout_gravity="center_horizontal"
     android:layout_marginTop="10dp"
     android:textSize="12sp"/>

  <TextView
     style="@style/DialogSectionLabel"
     android:layout_marginTop="18dp"
     android:text="@string/case_algorithms"/>

  <!-- One row per algorithm, built in code, always in the same order. -->
  <LinearLayout
     android:id="@+id/llCaseAlgorithms"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="4dp"
     android:orientation="vertical"/>

  <!-- An algorithm of the user's own sits beside the list rather than inside it, so that having one
       never moves, hides or renames anything the list was saying. Below it rather than above: the
       row the list marks as the one they use must have nothing of theirs standing over it. -->
  <TextView
     android:id="@+id/tvCaseYoursLabel"
     style="@style/DialogSectionLabel"
     android:layout_marginTop="18dp"
     android:text="@string/case_algorithm_yours"
     android:visibility="gone"/>

  <LinearLayout
     android:id="@+id/llCaseYours"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="6dp"
     android:background="@drawable/case_alg_yours"
     android:orientation="vertical"
     android:paddingLeft="3dp"
     android:visibility="gone"/>

  <!-- The way out of the list, for a user who solves the case some other way entirely. -->
  <TextView
     android:id="@+id/tvCaseAddAlgorithm"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="12dp"
     android:text="@string/case_algorithm_add"
     android:textColor="@color/lightblue"
     android:textSize="14sp"/>

  <TextView
     android:id="@+id/tvCaseSource"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="14dp"
     android:text="@string/case_algorithms_source"
     android:textColor="@color/secondary_text"
     android:textSize="12sp"/>

</LinearLayout>
